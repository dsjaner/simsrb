<Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Models</string><ProtectedString name="Source"><![CDATA[--[[
	Models — procedural builders for every 3D object in Bahay Buhay.
	No uploaded meshes or decals are needed: everything is made from parts.

	Conventions:
	  • Each builder returns a Model whose pivot (PrimaryPart "Base") is at floor level, centre.
	  • Local +Z is the FRONT of the object (where the player stands to use it).
	  • A part named "UsePoint" marks where the character goes. If it is a Seat,
	    the character sits on it; otherwise the character stands on it facing its LookVector.
	  • A part named "PromptPart" (optional) is where the ProximityPrompt is attached.
	  • Lights tagged "NightLight" are switched on at night by the server.

	Usage: Models.build("Kalan") → Model
]]

local CollectionService = game:GetService("CollectionService")

local Config = require(script.Parent.Config)
local Util = require(script.Parent.Util)

local Models = {}
local Builders = {}

local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local MAT = Enum.Material
local PI = math.pi

local Palette = {
	bamboo = C(201, 170, 104),
	bambooDark = C(150, 118, 64),
	wood = C(124, 84, 48),
	woodDark = C(84, 54, 32),
	nipa = C(168, 134, 78),
	nipaDark = C(130, 100, 56),
	sawali = C(214, 186, 128),
	white = C(242, 242, 238),
	metal = C(190, 192, 196),
	chrome = C(228, 230, 235),
	dark = C(35, 35, 40),
	leaf = C(64, 145, 58),
	leafDark = C(44, 110, 44),
	flagRed = C(206, 17, 38),
	flagBlue = C(0, 56, 168),
	flagYellow = C(252, 209, 22),
}
Models.Palette = Palette

local BANDERITAS_COLORS = {
	C(230, 57, 70), C(252, 209, 22), C(0, 120, 215), C(46, 196, 108), C(255, 120, 190), C(255, 150, 40),
}

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------
local function newModel(name: string, stationId: string?): Model
	local model = Instance.new("Model")
	model.Name = name
	local base = Util.part({
		Name = "Base",
		Size = V(1, 0.2, 1),
		CFrame = CF(0, 0, 0),
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Parent = model,
	})
	model.PrimaryPart = base
	if stationId then
		model:SetAttribute("StationId", stationId)
	end
	return model
end

local function P(model: Instance, props: { [string]: any }): BasePart
	props.Parent = model
	return Util.part(props)
end

-- Vertical cylinder standing on y0.
local function vcyl(model, x, y0, z, height, diameter, color, material, extra)
	local props = {
		Shape = Enum.PartType.Cylinder,
		Size = V(height, diameter, diameter),
		CFrame = CF(x, y0 + height / 2, z) * ANG(0, 0, PI / 2),
		Color = color,
		Material = material or MAT.Wood,
	}
	if extra then
		for k, v in extra do
			props[k] = v
		end
	end
	return P(model, props)
end

local function ball(model, cf, diameter, color, material)
	return P(model, {
		Shape = Enum.PartType.Ball,
		Size = V(diameter, diameter, diameter),
		CFrame = cf,
		Color = color,
		Material = material or MAT.SmoothPlastic,
	})
end

local function usePoint(model, cf)
	return P(model, {
		Name = "UsePoint",
		Size = V(1, 0.2, 1),
		CFrame = cf,
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
	})
end

-- A seat that doubles as the UsePoint. Seats face their -Z.
local function seatPoint(model, cf, size, color, material, visible)
	return P(model, {
		ClassName = "Seat",
		Name = "UsePoint",
		Size = size or V(2, 0.3, 2),
		CFrame = cf,
		Color = color or Palette.wood,
		Material = material or MAT.Wood,
		Transparency = if visible == false then 1 else 0,
	})
end

local function promptPart(model, cf)
	return P(model, {
		Name = "PromptPart",
		Size = V(1, 1, 1),
		CFrame = cf,
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
	})
end

local function nightLight(part: BasePart, range: number, brightness: number, color: Color3?, spot: boolean?)
	local light: Light
	if spot then
		local s = Instance.new("SpotLight")
		s.Face = Enum.NormalId.Bottom
		s.Angle = 110
		light = s
	else
		light = Instance.new("PointLight")
	end
	light.Range = range
	light.Brightness = brightness
	light.Color = color or C(255, 214, 150)
	light.Shadows = false
	light.Enabled = false
	light.Parent = part
	CollectionService:AddTag(part, "NightLight")
	return light
end

-- Builds a wall along local X with rectangular openings (doors/windows).
-- frame: CFrame at the wall's bottom-centre. openings: { {c=centreX, w=width, bottom=y, top=y} }
local function wall(model, frame: CFrame, length, height, thick, openings, color, material)
	table.sort(openings, function(a, b)
		return a.c < b.c
	end)
	local function piece(x0, x1, y0, y1)
		if x1 - x0 < 0.05 or y1 - y0 < 0.05 then
			return
		end
		P(model, {
			Size = V(x1 - x0, y1 - y0, thick),
			CFrame = frame * CF((x0 + x1) / 2, (y0 + y1) / 2, 0),
			Color = color,
			Material = material,
		})
	end
	local cursor = -length / 2
	for _, o in openings do
		local x0, x1 = o.c - o.w / 2, o.c + o.w / 2
		piece(cursor, x0, 0, height)
		piece(x0, x1, 0, o.bottom)
		piece(x0, x1, o.top, height)
		cursor = x1
	end
	piece(cursor, length / 2, 0, height)
end

-- Two sloped thatch panels meeting at a ridge along local X, plus gable triangles.
local function gableRoof(model, centre: CFrame, width, depth, rise, overhang, color, material, closeGables)
	local halfRun = depth / 2
	local angle = math.atan2(rise, halfRun)
	local span = halfRun + overhang
	local length = span / math.cos(angle)
	local cy = rise - (span / 2) * math.tan(angle)
	for _, side in { 1, -1 } do
		P(model, {
			Name = "Bubong",
			Size = V(width + overhang * 2, 0.8, length),
			CFrame = centre * CF(0, cy, side * span / 2) * ANG(side * angle, 0, 0),
			Color = color,
			Material = material,
		})
	end
	P(model, {
		Name = "Ridge",
		Size = V(width + overhang * 2 + 0.4, 0.8, 1.4),
		CFrame = centre * CF(0, rise + 0.15, 0),
		Color = Palette.nipaDark,
		Material = material,
	})
	if closeGables then
		for _, sx in { 1, -1 } do
			local x = sx * (width / 2 - 0.25)
			P(model, {
				ClassName = "WedgePart",
				Size = V(0.5, rise, halfRun),
				CFrame = centre * CF(x, rise / 2, halfRun / 2) * ANG(0, PI, 0),
				Color = Palette.sawali,
				Material = MAT.Fabric,
			})
			P(model, {
				ClassName = "WedgePart",
				Size = V(0.5, rise, halfRun),
				CFrame = centre * CF(x, rise / 2, -halfRun / 2),
				Color = Palette.sawali,
				Material = MAT.Fabric,
			})
		end
	end
end

-- Pennant-shaped triangle pointing down, hanging from `top` (lookAt along the rope).
local function pennant(parent, top: CFrame, height, halfWidth, color)
	P(parent, {
		ClassName = "WedgePart",
		Size = V(0.06, height, halfWidth),
		CFrame = top * CF(0, -height / 2, -halfWidth / 2) * ANG(0, 0, PI),
		Color = color,
		Material = MAT.Fabric,
		CanCollide = false,
		CastShadow = false,
	})
	P(parent, {
		ClassName = "WedgePart",
		Size = V(0.06, height, halfWidth),
		CFrame = top * CF(0, -height / 2, halfWidth / 2) * ANG(0, PI, PI),
		Color = color,
		Material = MAT.Fabric,
		CanCollide = false,
		CastShadow = false,
	})
end

local function bench(model, cf: CFrame, length)
	P(model, { Size = V(length, 0.3, 1.2), CFrame = cf * CF(0, 1.6, 0), Color = Palette.wood, Material = MAT.WoodPlanks })
	for _, sx in { -1, 1 } do
		P(model, { Size = V(0.3, 1.45, 1), CFrame = cf * CF(sx * (length / 2 - 0.5), 0.725, 0), Color = Palette.woodDark })
	end
end

--------------------------------------------------------------------------
-- FURNITURE
--------------------------------------------------------------------------
function Builders.Banig()
	local m = newModel("Banig", "Banig")
	P(m, { Name = "Mat", Size = V(4.2, 0.2, 7), CFrame = CF(0, 0.1, 0), Color = C(214, 186, 120), Material = MAT.Fabric })
	for i = -1, 1 do
		P(m, {
			Size = V(4.22, 0.22, 0.35),
			CFrame = CF(0, 0.11, i * 2),
			Color = if i == 0 then C(200, 50, 60) else C(40, 130, 90),
			Material = MAT.Fabric,
		})
	end
	P(m, { Name = "Unan", Size = V(2.6, 0.6, 1.2), CFrame = CF(0, 0.5, 2.8), Color = Palette.white, Material = MAT.Fabric })
	usePoint(m, CF(0, 0.2, 0)) -- lying down: head goes toward +Z (the pillow)
	return m
end

function Builders.Kama()
	local m = newModel("Kama", "Kama")
	for _, x in { -2.3, 2.3 } do
		for _, z in { -3.8, 3.8 } do
			vcyl(m, x, 0, z, 1.6, 0.45, Palette.bambooDark)
		end
	end
	vcyl(m, -2.3, 1.6, 3.8, 1.6, 0.45, Palette.bambooDark)
	vcyl(m, 2.3, 1.6, 3.8, 1.6, 0.45, Palette.bambooDark)
	P(m, { Size = V(5, 0.3, 8), CFrame = CF(0, 1.6, 0), Color = Palette.bamboo, Material = MAT.WoodPlanks })
	P(m, { Size = V(5, 0.25, 0.3), CFrame = CF(0, 3.0, 3.8), Color = Palette.bamboo, Material = MAT.Wood })
	P(m, { Name = "Kutson", Size = V(4.6, 0.5, 7.4), CFrame = CF(0, 2.0, 0), Color = C(120, 170, 210), Material = MAT.Fabric })
	P(m, { Name = "Unan", Size = V(3, 0.6, 1.2), CFrame = CF(0, 2.5, 3), Color = Palette.white, Material = MAT.Fabric })
	P(m, { Name = "Kumot", Size = V(4.7, 0.1, 3.5), CFrame = CF(0, 2.28, -1.8), Color = C(230, 120, 80), Material = MAT.Fabric })
	usePoint(m, CF(0, 2.25, 0))
	return m
end

function Builders.Kalan()
	local m = newModel("Kalan", "Kalan")
	P(m, { Name = "Counter", Size = V(5, 3, 2.4), CFrame = CF(0, 1.5, 0), Color = Palette.wood, Material = MAT.WoodPlanks })
	P(m, { Size = V(5.2, 0.2, 2.6), CFrame = CF(0, 3.1, 0), Color = C(205, 205, 200), Material = MAT.Marble })
	P(m, { Name = "Stove", Size = V(3, 0.4, 1.6), CFrame = CF(0, 3.4, -0.1), Color = Palette.dark, Material = MAT.Metal })
	for _, x in { -0.7, 0.7 } do
		vcyl(m, x, 3.6, -0.1, 0.08, 0.8, C(20, 20, 20), MAT.Metal)
	end
	vcyl(m, -0.7, 3.65, -0.1, 0.9, 1.1, C(170, 170, 176), MAT.Metal) -- kaldero
	vcyl(m, -0.7, 4.55, -0.1, 0.1, 1.15, C(140, 140, 146), MAT.Metal)
	P(m, { Name = "Kawali", Size = V(1.2, 0.2, 1.2), CFrame = CF(0.7, 3.75, -0.1), Color = C(30, 30, 30), Material = MAT.Metal })
	P(m, { Size = V(1, 0.1, 0.15), CFrame = CF(1.6, 3.8, -0.1), Color = Palette.woodDark })
	vcyl(m, 2.1, 3.2, 0.6, 1.2, 0.5, C(210, 60, 40), MAT.SmoothPlastic) -- bote ng toyo/suka
	usePoint(m, CFrame.lookAt(V(0, 0.2, 2.8), V(0, 0.2, 0)))
	return m
end

function Builders.Hapag()
	local m = newModel("Hapag", "Hapag")
	P(m, { Name = "Mesa", Size = V(6, 0.3, 3.2), CFrame = CF(0, 2.85, 0), Color = Palette.wood, Material = MAT.WoodPlanks })
	for _, x in { -2.7, 2.7 } do
		for _, z in { -1.4, 1.4 } do
			P(m, { Size = V(0.3, 2.7, 0.3), CFrame = CF(x, 1.35, z), Color = Palette.woodDark })
		end
	end
	-- bench players sit on (faces the table, -Z)
	seatPoint(m, CF(0, 1.6, 2.4), V(5, 0.3, 1.2), Palette.wood, MAT.WoodPlanks)
	for _, x in { -2.2, 2.2 } do
		P(m, { Size = V(0.3, 1.45, 1), CFrame = CF(x, 0.725, 2.4), Color = Palette.woodDark })
	end
	bench(m, CF(0, 0, -2.4), 5)
	-- food
	vcyl(m, 0, 3.0, 0, 0.4, 1.1, Palette.white, MAT.SmoothPlastic)
	ball(m, CF(0, 3.4, 0), 0.9, Palette.white)
	vcyl(m, 1.7, 3.0, 0.3, 0.12, 1.3, Palette.white, MAT.SmoothPlastic)
	P(m, { Size = V(0.8, 0.2, 0.6), CFrame = CF(1.7, 3.2, 0.3), Color = C(110, 60, 30) })
	vcyl(m, -1.8, 3.0, -0.4, 1, 0.6, C(200, 230, 255), MAT.Glass, { Transparency = 0.35 })
	return m
end

function Builders.Paliguan()
	local m = newModel("Paliguan", "Paliguan")
	P(m, { Size = V(5, 0.2, 5), CFrame = CF(0, 0.1, 0), Color = C(120, 180, 200), Material = MAT.Slate })
	P(m, { Size = V(5, 6, 0.3), CFrame = CF(0, 3.2, -2.35), Color = C(225, 225, 215), Material = MAT.Concrete })
	P(m, { Size = V(0.3, 6, 5), CFrame = CF(2.35, 3.2, 0), Color = C(225, 225, 215), Material = MAT.Concrete })
	vcyl(m, -1, 0.2, -1.2, 1.6, 1.6, C(40, 110, 220), MAT.SmoothPlastic) -- timba
	vcyl(m, -1, 1.72, -1.2, 0.05, 1.4, C(120, 190, 240), MAT.Glass, { Transparency = 0.3 })
	vcyl(m, 0.7, 0.2, -1.4, 0.7, 0.7, C(240, 90, 140), MAT.SmoothPlastic) -- tabo
	P(m, { Size = V(0.2, 0.2, 0.6), CFrame = CF(0.7, 0.7, -0.85), Color = C(240, 90, 140) })
	vcyl(m, 1.6, 0.2, 1.4, 2.2, 1.8, C(60, 130, 200), MAT.SmoothPlastic) -- drum ng tubig
	usePoint(m, CF(0, 0.2, 0.8))
	return m
end

function Builders.Inidoro()
	local m = newModel("Inidoro", "Inidoro")
	vcyl(m, 0, 0, 0, 1.2, 1.4, Palette.white, MAT.SmoothPlastic)
	seatPoint(m, CF(0, 1.35, 0.1) * ANG(0, PI, 0), V(1.6, 0.25, 1.8), Palette.white, MAT.SmoothPlastic)
	P(m, { Name = "Tangke", Size = V(1.8, 1.8, 0.8), CFrame = CF(0, 2, -1.0), Color = Palette.white, Material = MAT.SmoothPlastic })
	P(m, { Size = V(0.4, 0.12, 0.12), CFrame = CF(0.6, 2.6, -0.55), Color = Palette.metal, Material = MAT.Metal })
	P(m, { Size = V(0.6, 0.6, 0.6), CFrame = CF(-1.4, 0.3, 0.4), Color = C(40, 110, 220) }) -- tabo sa CR
	return m
end

function Builders.TV()
	local m = newModel("TV", "TV")
	P(m, { Name = "Cabinet", Size = V(4, 2.4, 2), CFrame = CF(0, 1.2, 0), Color = Palette.wood, Material = MAT.WoodPlanks })
	P(m, { Name = "Kahon", Size = V(3, 2.4, 2.2), CFrame = CF(0, 3.6, 0), Color = C(70, 70, 75), Material = MAT.SmoothPlastic })
	P(m, { Name = "Screen", Size = V(2.3, 1.8, 0.1), CFrame = CF(-0.2, 3.65, 1.12), Color = C(60, 120, 150), Material = MAT.Neon })
	for i, x in { 1.15, 1.15 } do
		vcyl(m, x, 3.9 - i * 0.55, 1.12, 0.12, 0.3, C(30, 30, 30), MAT.SmoothPlastic)
	end
	P(m, { Size = V(0.08, 1.8, 0.08), CFrame = CF(-0.4, 5.5, 0) * ANG(0, 0, 0.4), Color = Palette.metal, Material = MAT.Metal })
	P(m, { Size = V(0.08, 1.8, 0.08), CFrame = CF(0.4, 5.5, 0) * ANG(0, 0, -0.4), Color = Palette.metal, Material = MAT.Metal })
	-- bangkô (stool) to sit on
	seatPoint(m, CF(0, 1.4, 6), V(1.8, 0.3, 1.8), Palette.wood, MAT.Wood)
	for _, x in { -0.7, 0.7 } do
		for _, z in { 5.3, 6.7 } do
			P(m, { Size = V(0.25, 1.25, 0.25), CFrame = CF(x, 0.625, z), Color = Palette.woodDark })
		end
	end
	promptPart(m, CF(0, 2, 2))
	return m
end

function Builders.Videoke()
	local m = newModel("Videoke", "Videoke")
	P(m, { Name = "Cabinet", Size = V(3, 3.2, 1.8), CFrame = CF(0, 1.6, 0), Color = C(30, 30, 35) })
	P(m, { Name = "Monitor", Size = V(3, 2.2, 1.6), CFrame = CF(0, 4.3, 0), Color = C(40, 40, 45) })
	P(m, { Name = "Screen", Size = V(2.6, 1.8, 0.1), CFrame = CF(0, 4.3, 0.81), Color = C(150, 80, 220), Material = MAT.Neon })
	P(m, { Size = V(2.6, 0.15, 0.05), CFrame = CF(0, 2.9, 0.92), Color = C(255, 80, 160), Material = MAT.Neon })
	P(m, { Size = V(2.6, 0.15, 0.05), CFrame = CF(0, 2.6, 0.92), Color = C(80, 200, 255), Material = MAT.Neon })
	for _, x in { -2.4, 2.4 } do
		P(m, { Name = "Speaker", Size = V(1.4, 3.4, 1.4), CFrame = CF(x, 1.7, 0), Color = C(25, 25, 25) })
		for _, y in { 1.0, 2.5 } do
			P(m, {
				Shape = Enum.PartType.Cylinder,
				Size = V(0.1, 1, 1),
				CFrame = CF(x, y, 0.71) * ANG(0, PI / 2, 0),
				Color = C(70, 70, 75),
				Material = MAT.Metal,
			})
		end
	end
	vcyl(m, 0, 0, 3, 4.2, 0.15, Palette.metal, MAT.Metal) -- mic stand
	ball(m, CF(0, 4.35, 2.9), 0.45, C(40, 40, 40), MAT.Metal)
	usePoint(m, CFrame.lookAt(V(0, 0.2, 3.8), V(0, 0.2, 0)))
	return m
end

function Builders.Duyan()
	local m = newModel("Duyan", "Duyan")
	vcyl(m, 0, 0, -5.2, 6, 0.7, Palette.bambooDark)
	vcyl(m, 0, 0, 5.2, 6, 0.7, Palette.bambooDark)
	local colors = { C(230, 80, 70), C(250, 200, 60), C(60, 160, 220) }
	P(m, { Size = V(2.6, 0.15, 3.2), CFrame = CF(0, 2.0, 0), Color = colors[1], Material = MAT.Fabric })
	local run, rise = 3.1, 2.3
	local len = math.sqrt(run * run + rise * rise)
	local angle = math.atan2(rise, run)
	P(m, { Size = V(2.4, 0.15, len), CFrame = CF(0, 2.0 + rise / 2, 1.6 + run / 2) * ANG(-angle, 0, 0), Color = colors[2], Material = MAT.Fabric })
	P(m, { Size = V(2.4, 0.15, len), CFrame = CF(0, 2.0 + rise / 2, -1.6 - run / 2) * ANG(angle, 0, 0), Color = colors[3], Material = MAT.Fabric })
	usePoint(m, CF(0, 2.1, 0))
	return m
end

function Builders.Bentilador()
	local m = newModel("Bentilador", "Bentilador")
	vcyl(m, 0, 0, 0, 0.3, 1.6, C(60, 60, 70), MAT.SmoothPlastic)
	vcyl(m, 0, 0.3, 0, 3.2, 0.25, Palette.metal, MAT.Metal)
	P(m, { Size = V(0.8, 0.8, 1.2), CFrame = CF(0, 3.8, 0), Color = C(60, 60, 70) })
	P(m, {
		Name = "Cage",
		Shape = Enum.PartType.Cylinder,
		Size = V(0.5, 2.6, 2.6),
		CFrame = CF(0, 3.8, 0.9) * ANG(0, PI / 2, 0),
		Color = C(80, 140, 220),
		Transparency = 0.65,
		Material = MAT.SmoothPlastic,
	})
	for i = 0, 2 do
		P(m, {
			Size = V(0.12, 1.1, 0.05),
			CFrame = CF(0, 3.8, 0.9) * ANG(0, 0, i * 2 * PI / 3) * CF(0, 0.55, 0),
			Color = C(60, 120, 210),
		})
	end
	usePoint(m, CFrame.lookAt(V(0, 0.2, 4), V(0, 0.2, 0)))
	return m
end

function Builders.Altar()
	local m = newModel("Altar", "Altar")
	P(m, { Size = V(4, 2.6, 1.6), CFrame = CF(0, 1.3, 0), Color = Palette.woodDark, Material = MAT.WoodPlanks })
	P(m, { Size = V(4.1, 0.1, 1.7), CFrame = CF(0, 2.65, 0), Color = Palette.white, Material = MAT.Fabric })
	P(m, { Size = V(4.1, 1.2, 0.08), CFrame = CF(0, 2.1, 0.85), Color = Palette.white, Material = MAT.Fabric })
	P(m, { Size = V(0.25, 1.8, 0.25), CFrame = CF(0, 3.6, -0.4), Color = C(205, 170, 80), Material = MAT.Metal })
	P(m, { Size = V(1, 0.25, 0.25), CFrame = CF(0, 4.0, -0.4), Color = C(205, 170, 80), Material = MAT.Metal })
	for _, x in { -1.4, 1.4 } do
		vcyl(m, x, 2.7, 0.2, 0.8, 0.25, Palette.white, MAT.SmoothPlastic)
		local flame = ball(m, CF(x, 3.65, 0.2), 0.25, C(255, 180, 60), MAT.Neon)
		local light = Instance.new("PointLight")
		light.Range = 8
		light.Brightness = 1
		light.Color = C(255, 190, 110)
		light.Parent = flame
	end
	for _, x in { -0.8, 0.8 } do
		ball(m, CF(x, 2.95, 0.3), 0.4, C(255, 255, 255))
	end
	usePoint(m, CFrame.lookAt(V(0, 0.2, 3), V(0, 0.2, 0)))
	return m
end

function Builders.Halaman()
	local m = newModel("Halaman", "Halaman")
	vcyl(m, 0, 0, 0, 1.4, 1.6, C(176, 92, 52), MAT.Slate)
	vcyl(m, 0, 1.38, 0, 0.05, 1.4, C(80, 55, 35), MAT.Ground)
	local rng = Random.new(7)
	for _ = 1, 5 do
		ball(m, CF(rng:NextNumber(-0.5, 0.5), rng:NextNumber(1.9, 2.6), rng:NextNumber(-0.5, 0.5)), 1.1, Palette.leaf, MAT.Grass)
	end
	for _ = 1, 9 do
		ball(m, CF(rng:NextNumber(-0.8, 0.8), rng:NextNumber(2.0, 3.0), rng:NextNumber(-0.8, 0.8)), 0.32, C(255, 255, 250))
	end
	usePoint(m, CFrame.lookAt(V(0, 0.2, 2.6), V(0, 0.2, 0)))
	return m
end

function Builders.Parol()
	local m = newModel("Parol", "Parol")
	vcyl(m, 0, 0, 0, 7.2, 0.3, Palette.bambooDark)
	P(m, { Size = V(0.2, 0.2, 2), CFrame = CF(0, 7.1, 0.9), Color = Palette.bambooDark })
	P(m, { Size = V(0.05, 0.7, 0.05), CFrame = CF(0, 6.7, 1.7), Color = C(30, 30, 30) })
	local centre = CF(0, 5.4, 1.7)
	local core = ball(m, centre, 1, C(255, 220, 100), MAT.Neon)
	for i = 0, 4 do
		P(m, {
			Size = V(0.55, 1.7, 0.3),
			CFrame = centre * ANG(0, 0, i * 2 * PI / 5) * CF(0, 0.95, 0),
			Color = if i % 2 == 0 then C(230, 40, 50) else C(255, 200, 40),
			Material = MAT.Neon,
		})
	end
	for _, sx in { -1, 1 } do
		P(m, {
			Size = V(0.15, 2.2, 0.05),
			CFrame = centre * CF(sx * 0.35, -2.0, 0) * ANG(0, 0, sx * 0.15),
			Color = C(230, 40, 50),
			Material = MAT.Neon,
			CanCollide = false,
		})
	end
	nightLight(core, 16, 2, C(255, 200, 120))
	return m
end

function Builders.Aparador()
	local m = newModel("Aparador", "Aparador")
	P(m, { Size = V(4, 6.5, 2), CFrame = CF(0, 3.25, 0), Color = Palette.wood, Material = MAT.WoodPlanks })
	P(m, { Size = V(4.3, 0.3, 2.2), CFrame = CF(0, 6.65, 0), Color = Palette.woodDark })
	P(m, { Size = V(0.08, 6, 0.05), CFrame = CF(0, 3.3, 1.02), Color = Palette.woodDark })
	for _, x in { -0.3, 0.3 } do
		P(m, { Size = V(0.12, 0.5, 0.12), CFrame = CF(x, 3.4, 1.08), Color = C(205, 170, 80), Material = MAT.Metal })
	end
	P(m, { Name = "Salamin", Size = V(1.4, 4, 0.05), CFrame = CF(-1, 3.6, 1.03), Color = C(200, 220, 230), Material = MAT.Glass, Reflectance = 0.4 })
	usePoint(m, CFrame.lookAt(V(0, 0.2, 3), V(0, 0.2, 0)))
	return m
end

--------------------------------------------------------------------------
-- PUBLIC PLACES
--------------------------------------------------------------------------
function Builders.SariSari()
	local m = newModel("SariSari", "SariSari")
	P(m, { Name = "Body", Size = V(14, 9, 10), CFrame = CF(0, 4.5, 0), Color = C(232, 222, 190), Material = MAT.Concrete })
	P(m, { Size = V(14.1, 3, 10.1), CFrame = CF(0, 1.5, 0), Color = C(90, 150, 120), Material = MAT.Concrete })
	P(m, { Name = "Loob", Size = V(9, 3.6, 0.2), CFrame = CF(0, 4.5, 5.05), Color = C(45, 32, 25) })
	for i = 0, 11 do
		P(m, { Size = V(0.12, 3.6, 0.12), CFrame = CF(-4.4 + i * 0.8, 4.5, 5.3), Color = C(60, 95, 60), Material = MAT.Metal })
	end
	P(m, { Size = V(9.2, 0.12, 0.12), CFrame = CF(0, 6.3, 5.3), Color = C(60, 95, 60), Material = MAT.Metal })
	P(m, { Name = "Counter", Size = V(10, 0.3, 1.4), CFrame = CF(0, 2.6, 5.7), Color = Palette.wood, Material = MAT.WoodPlanks })
	-- hanging "tingi" sachets
	local rng = Random.new(3)
	for i = 0, 10 do
		P(m, {
			Size = V(0.5, 1.5, 0.05),
			CFrame = CF(-4 + i * 0.8, 5.6, 5.45),
			Color = Color3.fromHSV(rng:NextNumber(), 0.75, 0.95),
			Material = MAT.SmoothPlastic,
			CanCollide = false,
		})
	end
	-- glass candy jars on the counter
	for i, x in { -3, -1.8, 1.8, 3 } do
		vcyl(m, x, 2.75, 5.7, 0.9, 0.8, C(220, 240, 255), MAT.Glass, { Transparency = 0.4 })
		vcyl(m, x, 2.8, 5.7, 0.5, 0.65, Color3.fromHSV(i / 5, 0.7, 0.95), MAT.SmoothPlastic)
	end
	-- corrugated GI roof (yero)
	P(m, { Name = "Yero", Size = V(15, 0.3, 13), CFrame = CF(0, 9.4, 1) * ANG(0.08, 0, 0), Color = C(150, 140, 130), Material = MAT.CorrodedMetal })
	local sign = P(m, { Name = "Karatula", Size = V(12, 2, 0.3), CFrame = CF(0, 7.6, 5.3), Color = C(252, 220, 70) })
	Util.surfaceText(sign, Enum.NormalId.Back, "SARI-SARI STORE NI ALING NENA", C(160, 20, 30))
	bench(m, CF(-4.5, 0, 8.2), 4.5)
	usePoint(m, CFrame.lookAt(V(0, 0, 7.2), V(0, 0, 0)))
	promptPart(m, CF(0, 3, 6.5))
	return m
end

function Builders.Monobloc(color: Color3?)
	local m = newModel("Monobloc")
	local col = color or Palette.white
	P(m, { ClassName = "Seat", Name = "Upuan", Size = V(1.8, 0.25, 1.8), CFrame = CF(0, 1.6, 0), Color = col, Material = MAT.SmoothPlastic })
	P(m, { Size = V(1.8, 2, 0.25), CFrame = CF(0, 2.7, 0.85) * ANG(-0.12, 0, 0), Color = col, Material = MAT.SmoothPlastic })
	for _, x in { -0.75, 0.75 } do
		for _, z in { -0.75, 0.75 } do
			P(m, { Size = V(0.22, 1.5, 0.22), CFrame = CF(x, 0.75, z), Color = col, Material = MAT.SmoothPlastic })
		end
	end
	return m
end

function Builders.Karinderya()
	local m = newModel("Karinderya", "Karinderya")
	P(m, { Name = "Counter", Size = V(10, 3, 2.5), CFrame = CF(0, 1.5, 0), Color = C(240, 240, 235), Material = MAT.SmoothPlastic })
	P(m, { Size = V(10.1, 0.6, 2.6), CFrame = CF(0, 0.3, 0), Color = Palette.flagBlue })
	P(m, { Name = "Salamin", Size = V(9.5, 1.6, 2.2), CFrame = CF(0, 3.8, 0), Color = C(200, 230, 240), Material = MAT.Glass, Transparency = 0.6 })
	local ulam = { C(110, 60, 30), C(200, 80, 40), C(80, 140, 60), C(220, 200, 150), C(50, 25, 25) }
	for i = 1, 5 do
		local x = -4.4 + (i - 1) * 2.2
		vcyl(m, x, 3.0, 0, 0.9, 1.5, C(175, 175, 180), MAT.Metal)
		vcyl(m, x, 3.88, 0, 0.05, 1.3, ulam[i], MAT.SmoothPlastic)
	end
	for _, x in { -6, 6 } do
		for _, z in { -3.5, 3.5 } do
			vcyl(m, x, 0, z, 8, 0.35, Palette.metal, MAT.Metal)
		end
	end
	P(m, { Name = "Trapal", Size = V(13, 0.2, 8.5), CFrame = CF(0, 8.1, 0), Color = C(40, 110, 200), Material = MAT.Fabric })
	P(m, { Size = V(13.05, 0.22, 1.2), CFrame = CF(0, 8.1, 0), Color = C(250, 250, 250), Material = MAT.Fabric })
	local sign = P(m, { Name = "Karatula", Size = V(8, 1.6, 0.2), CFrame = CF(0, 7, 4.2), Color = C(210, 40, 45) })
	Util.surfaceText(sign, Enum.NormalId.Back, "KARINDERYA · TURO-TURO", C(255, 240, 200))
	-- dining area with monobloc chairs
	for _, x in { -4, 4 } do
		P(m, { Size = V(3, 0.2, 3), CFrame = CF(x, 2.6, 8.5), Color = Palette.white, Material = MAT.SmoothPlastic })
		vcyl(m, x, 0, 8.5, 2.5, 0.3, Palette.white, MAT.SmoothPlastic)
		for _, dz in { -2.2, 2.2 } do
			local chair = Builders.Monobloc(if x < 0 then C(240, 70, 70) else Palette.white)
			chair:PivotTo(CF(x, 0, 8.5 + dz) * (if dz < 0 then ANG(0, PI, 0) else CFrame.identity))
			chair.Parent = m
		end
	end
	usePoint(m, CFrame.lookAt(V(0, 0, 3.6), V(0, 0, 0)))
	promptPart(m, CF(0, 3, 2))
	return m
end

function Builders.BasketballRing()
	local m = newModel("BasketballRing", "Basketball")
	P(m, { Size = V(0.8, 11, 0.8), CFrame = CF(0, 5.5, -2), Color = C(40, 60, 140), Material = MAT.Metal })
	P(m, { Size = V(0.6, 0.6, 2.4), CFrame = CF(0, 10.5, -0.8), Color = C(40, 60, 140), Material = MAT.Metal })
	P(m, { Name = "Board", Size = V(6, 3.6, 0.2), CFrame = CF(0, 11.5, 0.4), Color = Palette.white })
	for _, spec in {
		{ V(2, 0.12, 0.05), CF(0, 12.2, 0.52) },
		{ V(2, 0.12, 0.05), CF(0, 10.9, 0.52) },
		{ V(0.12, 1.4, 0.05), CF(-1, 11.55, 0.52) },
		{ V(0.12, 1.4, 0.05), CF(1, 11.55, 0.52) },
	} do
		P(m, { Size = spec[1], CFrame = spec[2], Color = Palette.flagRed })
	end
	local centre = V(0, 10.4, 1.4)
	for i = 0, 11 do
		local a = i / 12 * 2 * PI
		P(m, {
			Size = V(0.12, 0.12, 0.55),
			CFrame = CF(centre + V(math.cos(a) * 0.9, 0, math.sin(a) * 0.9)) * ANG(0, -a, 0),
			Color = C(240, 110, 30),
			Material = MAT.Metal,
			CanCollide = false,
		})
	end
	vcyl(m, 0, 9.3, 1.4, 1.1, 1.6, Palette.white, MAT.Fabric, { Transparency = 0.6, CanCollide = false })
	usePoint(m, CFrame.lookAt(V(0, 0, 9), V(0, 0, 0)))
	promptPart(m, CF(0, 3, 4))
	return m
end

function Builders.Jeepney(routeText: string?)
	local m = newModel("Jeepney", "Jeepney")
	local W = 6.4
	local silver = Palette.chrome
	P(m, { Name = "Chassis", Size = V(W - 0.6, 0.8, 19), CFrame = CF(0, 1.6, 0), Color = C(50, 50, 55), Material = MAT.Metal })
	-- passenger cabin (rear)
	P(m, { Name = "Body", Size = V(W, 4.2, 11.5), CFrame = CF(0, 4.1, 2.75), Color = silver, Material = MAT.Metal, Reflectance = 0.15 })
	P(m, { Size = V(W + 0.05, 1.4, 10.5), CFrame = CF(0, 5.2, 2.9), Color = C(30, 35, 40), Material = MAT.Glass })
	for i, col in { Palette.flagRed, Palette.flagYellow, Palette.flagBlue } do
		P(m, { Size = V(W + 0.1, 0.35, 11.5), CFrame = CF(0, 2.8 + i * 0.35, 2.75), Color = col })
	end
	P(m, { Size = V(3, 0.3, 1.2), CFrame = CF(0, 1.3, 9), Color = Palette.metal, Material = MAT.DiamondPlate })
	-- driver's cab (hollow so the driver is visible)
	for _, sx in { -1, 1 } do
		P(m, { Size = V(0.3, 2, 3.5), CFrame = CF(sx * (W / 2 - 0.15), 3, -4.75), Color = Palette.flagRed })
		P(m, { Size = V(0.2, 2.2, 3.5), CFrame = CF(sx * (W / 2 - 0.15), 5.1, -4.75), Color = C(160, 200, 220), Material = MAT.Glass, Transparency = 0.5 })
	end
	P(m, { Size = V(W, 1.6, 0.3), CFrame = CF(0, 2.8, -6.35), Color = Palette.flagRed })
	P(m, { Name = "Windshield", Size = V(W - 0.4, 2.6, 0.1), CFrame = CF(0, 4.9, -6.4), Color = C(160, 200, 220), Material = MAT.Glass, Transparency = 0.5 })
	-- hood, grill, lights, ornaments
	P(m, { Name = "Hood", Size = V(W - 0.8, 1.8, 3), CFrame = CF(0, 2.9, -8), Color = silver, Material = MAT.Metal, Reflectance = 0.2 })
	P(m, { Size = V(W - 1.4, 1.2, 0.1), CFrame = CF(0, 2.8, -9.55), Color = Palette.metal, Material = MAT.DiamondPlate })
	for _, sx in { -1, 1 } do
		P(m, {
			Shape = Enum.PartType.Cylinder,
			Size = V(0.15, 0.9, 0.9),
			CFrame = CF(sx * 2, 3.1, -9.6) * ANG(0, PI / 2, 0),
			Color = C(255, 250, 220),
			Material = MAT.Neon,
		})
		P(m, { Name = "Kabayo", Size = V(0.3, 1, 0.9), CFrame = CF(sx * 1.4, 4.3, -8.8), Color = silver, Material = MAT.Metal, Reflectance = 0.3 })
		P(m, { Size = V(0.1, 2.5, 0.1), CFrame = CF(sx * 2.6, 5.2, -9.2), Color = silver, Material = MAT.Metal })
	end
	-- roof and route sign
	P(m, { Name = "Roof", Size = V(W + 0.6, 0.4, 15.2), CFrame = CF(0, 6.4, 1.1), Color = silver, Material = MAT.Metal })
	local sign = P(m, { Name = "Ruta", Size = V(5, 1.1, 0.3), CFrame = CF(0, 7.15, -6.2), Color = Palette.white })
	Util.surfaceText(sign, Enum.NormalId.Front, routeText or "BAYAN - PALENGKE", Palette.flagBlue)
	-- wheels
	for _, sx in { -1, 1 } do
		for _, z in { -6.6, 6.2 } do
			P(m, {
				Shape = Enum.PartType.Cylinder,
				Size = V(1, 2.6, 2.6),
				CFrame = CF(sx * (W / 2 - 0.2), 1.3, z),
				Color = C(25, 25, 25),
				Material = MAT.SmoothPlastic,
			})
		end
	end
	-- driver seat (left-hand drive) and steering wheel
	seatPoint(m, CF(-1.6, 2.4, -4.6), V(1.8, 0.3, 1.8), C(120, 30, 30), MAT.Fabric)
	P(m, {
		Shape = Enum.PartType.Cylinder,
		Size = V(0.15, 1.3, 1.3),
		CFrame = CF(-1.6, 3.9, -5.8) * ANG(0, PI / 2, 0),
		Color = C(30, 30, 30),
	})
	promptPart(m, CF(-W / 2 - 1, 3, -4.75))
	return m
end

function Builders.Palengke(variant: number?)
	local m = newModel("Palengke", "Palengke")
	local rng = Random.new(variant or 1)
	P(m, { Name = "Mesa", Size = V(8, 2.8, 3.5), CFrame = CF(0, 1.4, 0), Color = Palette.wood, Material = MAT.WoodPlanks })
	for _, x in { -4.2, 4.2 } do
		for _, z in { -2, 2 } do
			vcyl(m, x, 0, z, 8, 0.4, Palette.bambooDark)
		end
	end
	P(m, {
		Name = "Trapal",
		Size = V(9.5, 0.25, 5.8),
		CFrame = CF(0, 8, 0) * ANG(-0.1, 0, 0),
		Color = Color3.fromHSV(rng:NextNumber(), 0.7, 0.9),
		Material = MAT.Fabric,
	})
	local produce = {
		{ C(250, 200, 50), 0.7 }, -- mangga
		{ C(220, 40, 40), 0.55 }, -- kamatis
		{ C(110, 50, 140), 0.6 }, -- talong
		{ C(240, 220, 90), 0.5 }, -- saging
	}
	for i, x in { -2.6, 0, 2.6 } do
		vcyl(m, x, 2.8, 0.5, 0.2, 2.3, Palette.bamboo, MAT.Fabric) -- bilao
		local item = produce[((i + (variant or 1)) % #produce) + 1]
		for _ = 1, 6 do
			ball(m, CF(x + rng:NextNumber(-0.6, 0.6), 3.2 + rng:NextNumber(0, 0.25), 0.5 + rng:NextNumber(-0.6, 0.6)), item[2], item[1])
		end
	end
	-- fresh fish on ice
	P(m, { Size = V(2.4, 0.2, 1), CFrame = CF(0, 2.9, -1.1), Color = C(235, 245, 255), Material = MAT.Ice })
	for i = 0, 3 do
		P(m, { Size = V(0.9, 0.25, 0.35), CFrame = CF(-0.8 + i * 0.55, 3.1, -1.1) * ANG(0, 0.3, 0), Color = C(170, 180, 190), Material = MAT.Metal })
	end
	P(m, { Name = "Timbangan", Size = V(1, 0.8, 1), CFrame = CF(3.2, 3.2, -1.1), Color = C(200, 40, 40) })
	usePoint(m, CFrame.lookAt(V(0, 0, -3.3), V(0, 0, 0))) -- vendor stands behind the table
	return m
end

function Builders.Bangka()
	local m = newModel("Bangka", "Bangka")
	P(m, { Name = "Katawan", Size = V(2.6, 1.4, 9), CFrame = CF(0, 0.5, 0), Color = Palette.white, Material = MAT.Wood })
	P(m, { Size = V(2.65, 0.4, 9), CFrame = CF(0, 0, 0), Color = Palette.flagBlue })
	P(m, { ClassName = "WedgePart", Size = V(2.6, 1.4, 3), CFrame = CF(0, 0.5, -6) * ANG(0, 0, PI), Color = Palette.white, Material = MAT.Wood })
	P(m, { ClassName = "WedgePart", Size = V(2.6, 1.4, 3), CFrame = CF(0, 0.5, 6) * ANG(0, PI, PI), Color = Palette.white, Material = MAT.Wood })
	P(m, { Size = V(2.7, 0.3, 0.6), CFrame = CF(0, 1.1, -3), Color = Palette.flagRed })
	-- katig (bamboo outriggers) and crossbars
	for _, sx in { -1, 1 } do
		P(m, {
			Shape = Enum.PartType.Cylinder,
			Size = V(14, 0.6, 0.6),
			CFrame = CF(sx * 5.5, 0.1, 0) * ANG(0, PI / 2, 0),
			Color = Palette.bamboo,
			Material = MAT.Wood,
		})
	end
	for _, z in { -3, 3 } do
		P(m, {
			Shape = Enum.PartType.Cylinder,
			Size = V(11.5, 0.35, 0.35),
			CFrame = CF(0, 1.3, z),
			Color = Palette.bambooDark,
			Material = MAT.Wood,
		})
	end
	seatPoint(m, CF(0, 1.35, 1.5), V(2.2, 0.3, 1.2), Palette.wood, MAT.WoodPlanks)
	P(m, { Name = "Pamingwit", Size = V(0.12, 0.12, 6), CFrame = CF(0.9, 2.4, -1.5) * ANG(0.35, 0.2, 0), Color = C(110, 75, 40), CanCollide = false })
	promptPart(m, CF(0, 2, 0))
	return m
end

function Builders.Simbahan()
	local m = newModel("Simbahan", "Simbahan")
	local stone = C(196, 168, 126)
	local stoneLight = C(214, 190, 150)
	P(m, { Name = "Nave", Size = V(28, 20, 40), CFrame = CF(0, 10, -20), Color = stone, Material = MAT.Sandstone })
	P(m, { Name = "Fachada", Size = V(32, 26, 3), CFrame = CF(0, 13, 1.5), Color = stoneLight, Material = MAT.Sandstone })
	-- pediment (triangle on top of the facade)
	P(m, { ClassName = "WedgePart", Size = V(3, 8, 16), CFrame = CF(-8, 30, 1.5) * ANG(0, PI / 2, 0), Color = stoneLight, Material = MAT.Sandstone })
	P(m, { ClassName = "WedgePart", Size = V(3, 8, 16), CFrame = CF(8, 30, 1.5) * ANG(0, -PI / 2, 0), Color = stoneLight, Material = MAT.Sandstone })
	-- buttresses (common on Philippine baroque churches)
	for _, x in { -15, 15 } do
		P(m, { ClassName = "WedgePart", Size = V(3, 14, 6), CFrame = CF(x, 7, 6) * ANG(0, PI, 0), Color = stone, Material = MAT.Sandstone })
	end
	-- door with arch
	P(m, { Name = "Pinto", Size = V(7, 11, 0.3), CFrame = CF(0, 6.7, 3.1), Color = C(80, 50, 30), Material = MAT.WoodPlanks })
	P(m, { Shape = Enum.PartType.Cylinder, Size = V(0.3, 7, 7), CFrame = CF(0, 12.2, 3.1) * ANG(0, PI / 2, 0), Color = C(80, 50, 30), Material = MAT.WoodPlanks })
	P(m, { Shape = Enum.PartType.Cylinder, Size = V(0.3, 4.5, 4.5), CFrame = CF(0, 20, 3.1) * ANG(0, PI / 2, 0), Color = C(80, 130, 210), Material = MAT.Glass, Transparency = 0.1 })
	for _, x in { -9, 9 } do
		P(m, { Size = V(2.4, 5, 0.3), CFrame = CF(x, 16, 3.1), Color = C(80, 130, 210), Material = MAT.Glass })
	end
	-- steps
	P(m, { Size = V(14, 0.6, 3), CFrame = CF(0, 0.3, 4.5), Color = C(170, 165, 155), Material = MAT.Concrete })
	P(m, { Size = V(12, 0.6, 1.5), CFrame = CF(0, 0.9, 3.8), Color = C(170, 165, 155), Material = MAT.Concrete })
	-- bell tower (kampanaryo)
	P(m, { Name = "Kampanaryo", Size = V(9, 34, 9), CFrame = CF(-20.5, 17, -2), Color = stone, Material = MAT.Sandstone })
	P(m, { Size = V(4, 5, 9.2), CFrame = CF(-20.5, 28, -2), Color = C(40, 35, 30) })
	P(m, { Size = V(9.2, 5, 4), CFrame = CF(-20.5, 28, -2), Color = C(40, 35, 30) })
	vcyl(m, -20.5, 26.5, -2, 2, 2, C(180, 150, 60), MAT.Metal)
	P(m, { Size = V(10, 1, 10), CFrame = CF(-20.5, 34.5, -2), Color = stoneLight, Material = MAT.Sandstone })
	P(m, { Size = V(6, 3, 6), CFrame = CF(-20.5, 36.5, -2), Color = stoneLight, Material = MAT.Sandstone })
	for _, spec in { { -20.5, 38 }, { 0, 34 } } do
		P(m, { Size = V(0.6, 4, 0.6), CFrame = CF(spec[1], spec[2] + 2, if spec[1] == 0 then 1.5 else -2), Color = Palette.white })
		P(m, { Size = V(2.6, 0.6, 0.6), CFrame = CF(spec[1], spec[2] + 2.8, if spec[1] == 0 then 1.5 else -2), Color = Palette.white })
	end
	usePoint(m, CFrame.lookAt(V(0, 0, 8), V(0, 0, 0)))
	promptPart(m, CF(0, 3, 6))
	return m
end

function Builders.Poso()
	local m = newModel("Poso", "Poso")
	local green = C(40, 110, 70)
	P(m, { Size = V(4, 0.4, 4), CFrame = CF(0, 0.2, 0), Color = C(170, 170, 165), Material = MAT.Concrete })
	vcyl(m, 0, 0.4, -0.8, 3.6, 0.9, green, MAT.Metal)
	P(m, { Name = "Spout", Size = V(0.4, 0.4, 1.2), CFrame = CF(0, 3.2, -0.1), Color = green, Material = MAT.Metal })
	P(m, { Name = "Hawakan", Size = V(0.25, 0.25, 3), CFrame = CF(0, 4.3, -1.8) * ANG(0.35, 0, 0), Color = green, Material = MAT.Metal })
	vcyl(m, 0, 0.4, 0.6, 1.2, 1.6, C(40, 110, 220), MAT.SmoothPlastic) -- timba sa ilalim
	usePoint(m, CFrame.lookAt(V(0, 0.4, 2.4), V(0, 0.4, 0)))
	return m
end

--------------------------------------------------------------------------
-- DECOR & STRUCTURES
--------------------------------------------------------------------------
function Builders.CoconutTree(seed: number?)
	local m = newModel("Niyog")
	local rng = Random.new(seed or 1)
	local height = rng:NextNumber(16, 24)
	local segments = 8
	local lean = rng:NextNumber(0.15, 0.35)
	local cf = CF(0, 0, 0) * ANG(0, rng:NextNumber(0, 2 * PI), 0)
	for i = 1, segments do
		local segLen = height / segments
		local d = 1.5 - (i / segments) * 0.5
		cf *= ANG(lean / segments, 0, 0)
		P(m, {
			Shape = Enum.PartType.Cylinder,
			Size = V(segLen + 0.3, d, d),
			CFrame = cf * CF(0, segLen / 2, 0) * ANG(0, 0, PI / 2),
			Color = if i % 2 == 0 then C(140, 112, 80) else C(125, 98, 70),
			Material = MAT.Wood,
		})
		cf *= CF(0, segLen, 0)
	end
	for i = 1, 3 do
		local a = i / 3 * 2 * PI
		ball(m, cf * CF(math.cos(a) * 0.7, -0.6, math.sin(a) * 0.7), 1.1, C(90, 120, 40))
	end
	for j = 0, 7 do
		local yaw = j / 8 * 2 * PI + rng:NextNumber(-0.15, 0.15)
		local up = rng:NextNumber(0.15, 0.4)
		local frame = cf * ANG(0, yaw, 0) * ANG(up, 0, 0)
		P(m, { Size = V(1.8, 0.15, 6.2), CFrame = frame * CF(0, 0, -3), Color = Palette.leaf, CanCollide = false })
		P(m, {
			Size = V(1.4, 0.15, 5.8),
			CFrame = frame * CF(0, 0, -6) * ANG(-0.75, 0, 0) * CF(0, 0, -2.8),
			Color = Palette.leafDark,
			CanCollide = false,
		})
	end
	return m
end

function Builders.StreetLamp()
	local m = newModel("Poste")
	vcyl(m, 0, 0, 0, 12.5, 0.5, C(40, 70, 50), MAT.Metal)
	P(m, { Size = V(0.3, 0.3, 3), CFrame = CF(0, 12.2, 1.4), Color = C(40, 70, 50), Material = MAT.Metal })
	local lamp = P(m, { Name = "Ilaw", Size = V(1.2, 0.5, 1.8), CFrame = CF(0, 11.9, 2.8), Color = C(255, 230, 170), Material = MAT.Neon })
	nightLight(lamp, 32, 3, C(255, 210, 140), true)
	P(m, { Name = "Top", Size = V(0.2, 0.2, 0.2), CFrame = CF(0, 12.6, 0), Transparency = 1, CanCollide = false })
	return m
end

-- String of fiesta flags between two world points. Returned model is in world space.
function Builders.Banderitas(a: Vector3, b: Vector3, sag: number?, seed: number?)
	local m = Instance.new("Model")
	m.Name = "Banderitas"
	local rng = Random.new(seed or 1)
	local dist = (b - a).Magnitude
	local count = math.max(2, math.floor(dist / 1.7))
	local sagDepth = sag or 2.5
	local flat = V(b.X - a.X, 0, b.Z - a.Z)
	flat = if flat.Magnitude > 0 then flat.Unit else V(1, 0, 0)
	local points = {}
	for i = 0, count do
		local t = i / count
		points[i] = a:Lerp(b, t) - V(0, 4 * sagDepth * t * (1 - t), 0)
	end
	for i = 0, count - 1 do
		local p0, p1 = points[i], points[i + 1]
		local mid = (p0 + p1) / 2
		P(m, {
			Size = V(0.06, 0.06, (p1 - p0).Magnitude),
			CFrame = CFrame.lookAt(mid, p1),
			Color = C(240, 240, 240),
			CanCollide = false,
			CastShadow = false,
		})
		pennant(m, CFrame.lookAt(mid, mid + flat), 1.3, 0.6, BANDERITAS_COLORS[rng:NextInteger(1, #BANDERITAS_COLORS)])
	end
	return m
end

function Builders.Bench()
	local m = newModel("Bangko")
	bench(m, CFrame.identity, 6)
	P(m, { Size = V(6, 1.2, 0.25), CFrame = CF(0, 2.6, 0.55), Color = Palette.wood, Material = MAT.WoodPlanks })
	return m
end

-- Open-sided hut with a nipa roof (used for the videoke area and beach cottage).
function Builders.Pavilion(width: number?, depth: number?)
	local m = newModel("Pavilion")
	local W, D = width or 14, depth or 12
	P(m, { Size = V(W, 0.4, D), CFrame = CF(0, 0.2, 0), Color = C(185, 175, 160), Material = MAT.Concrete })
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			vcyl(m, sx * (W / 2 - 0.6), 0.4, sz * (D / 2 - 0.6), 8.6, 0.7, Palette.bambooDark)
		end
	end
	gableRoof(m, CF(0, 9, 0), W, D, 4.5, 1.5, Palette.nipa, MAT.Grass, false)
	return m
end

function Builders.Shed(text: string?)
	local m = newModel("Shed")
	for _, x in { -5, 5 } do
		vcyl(m, x, 0, -1, 8, 0.5, Palette.metal, MAT.Metal)
	end
	P(m, { Size = V(12, 0.3, 5), CFrame = CF(0, 8, 0) * ANG(-0.12, 0, 0), Color = C(200, 60, 50), Material = MAT.CorrodedMetal })
	bench(m, CF(0, 0, -1), 9)
	local sign = P(m, { Size = V(8, 1.4, 0.2), CFrame = CF(0, 6.9, 2.3), Color = Palette.flagYellow })
	Util.surfaceText(sign, Enum.NormalId.Back, text or "SAKAYAN NG JEEP", Palette.flagBlue)
	return m
end

function Builders.Building(width: number, depth: number, height: number, color: Color3, text: string?, stationId: string?)
	local m = newModel("Gusali", stationId)
	P(m, { Size = V(width, height, depth), CFrame = CF(0, height / 2, 0), Color = color, Material = MAT.Concrete })
	P(m, { Size = V(width + 1, 0.6, depth + 1), CFrame = CF(0, height + 0.3, 0), Color = C(120, 110, 100), Material = MAT.Concrete })
	P(m, { Size = V(4, 7, 0.3), CFrame = CF(0, 3.5, depth / 2 + 0.1), Color = C(70, 50, 35), Material = MAT.WoodPlanks })
	for _, x in { -width / 3, width / 3 } do
		P(m, { Size = V(4, 3, 0.2), CFrame = CF(x, height * 0.55, depth / 2 + 0.1), Color = C(150, 190, 220), Material = MAT.Glass })
	end
	if text then
		local sign = P(m, { Size = V(width * 0.7, 2, 0.3), CFrame = CF(0, height - 1.6, depth / 2 + 0.2), Color = Palette.white })
		Util.surfaceText(sign, Enum.NormalId.Back, text, Palette.flagBlue)
	end
	if stationId then
		usePoint(m, CFrame.lookAt(V(0, 0, depth / 2 + 2.5), V(0, 0, 0)))
		promptPart(m, CF(0, 3, depth / 2 + 1.5))
	end
	return m
end

function Builders.Bantayog()
	local m = newModel("Bantayog")
	P(m, { Size = V(12, 1, 12), CFrame = CF(0, 0.5, 0), Color = C(190, 185, 175), Material = MAT.Granite })
	P(m, { Size = V(8, 1, 8), CFrame = CF(0, 1.5, 0), Color = C(200, 195, 185), Material = MAT.Granite })
	P(m, { Size = V(3, 14, 3), CFrame = CF(0, 9, 0), Color = C(220, 215, 205), Material = MAT.Marble })
	P(m, { ClassName = "WedgePart", Size = V(3, 2, 1.5), CFrame = CF(0, 17, 0.75) * ANG(0, PI, 0), Color = C(220, 215, 205), Material = MAT.Marble })
	P(m, { ClassName = "WedgePart", Size = V(3, 2, 1.5), CFrame = CF(0, 17, -0.75), Color = C(220, 215, 205), Material = MAT.Marble })
	for i = 0, 3 do
		local a = i * PI / 2
		local frame = ANG(0, a, 0) * CF(0, 1.2, 5)
		P(m, { Size = V(6, 0.6, 1.4), CFrame = frame, Color = C(90, 60, 40), Material = MAT.Ground })
		for k = -2, 2 do
			ball(m, frame * CF(k * 1.1, 0.5, 0), 0.6, if k % 2 == 0 then C(230, 50, 80) else C(255, 200, 40))
		end
	end
	return m
end

-- The player's house. style = "Kubo" (bamboo on stilts) or "Bungalow" (concrete, Metro style).
-- Both share the same footprint so saved furniture fits either one.
function Builders.House(style: string?)
	style = style or "Kubo"
	local isKubo = style == "Kubo"
	local m = newModel(if isKubo then "BahayKubo" else "Bungalow")
	local W, D = 30, 24
	local FH = Config.HouseTypes[style].floorY
	local WH = 9
	local wallColor = if isKubo then Palette.sawali else C(236, 226, 200)
	local wallMat = if isKubo then MAT.Fabric else MAT.Concrete

	if isKubo then
		-- haligi (stilts) — the open space underneath is the "silong"
		for _, x in { -W / 2 + 1, 0, W / 2 - 1 } do
			for _, z in { -D / 2 + 1, 0, D / 2 - 1 } do
				vcyl(m, x, 0, z, FH, 1.2, Palette.bambooDark)
			end
		end
		P(m, { Name = "Sahig", Size = V(W, 0.6, D), CFrame = CF(0, FH - 0.3, 0), Color = Palette.bamboo, Material = MAT.WoodPlanks })
	else
		P(m, { Name = "Sahig", Size = V(W, FH, D), CFrame = CF(0, FH / 2, 0), Color = C(200, 190, 175), Material = MAT.Concrete })
		P(m, { Size = V(W - 1, 0.05, D - 1), CFrame = CF(0, FH + 0.02, 0), Color = C(190, 150, 110), Material = MAT.Marble })
	end

	local front = { { c = 0, w = 5, bottom = 0, top = 7 }, { c = -9, w = 5, bottom = 3, top = 6.5 }, { c = 9, w = 5, bottom = 3, top = 6.5 } }
	wall(m, CF(0, FH, D / 2 - 0.25), W, WH, 0.5, front, wallColor, wallMat)
	wall(m, CF(0, FH, -D / 2 + 0.25), W, WH, 0.5, {
		{ c = -6, w = 5, bottom = 3, top = 6.5 },
		{ c = 6, w = 5, bottom = 3, top = 6.5 },
	}, wallColor, wallMat)
	for _, sx in { 1, -1 } do
		wall(m, CF(sx * (W / 2 - 0.25), FH, 0) * ANG(0, PI / 2, 0), D - 1, WH, 0.5, {
			{ c = 0, w = 5, bottom = 3, top = 6.5 },
		}, wallColor, wallMat)
	end

	if isKubo then
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				vcyl(m, sx * (W / 2 - 0.3), FH, sz * (D / 2 - 0.3), WH, 0.8, Palette.bambooDark)
			end
		end
		-- propped-open window shutters (tukod)
		for _, x in { -9, 9 } do
			P(m, { Size = V(5.4, 0.2, 2.6), CFrame = CF(x, FH + 6.8, D / 2 + 1.0) * ANG(0.45, 0, 0), Color = Palette.nipa, Material = MAT.Grass })
		end
		gableRoof(m, CF(0, FH + WH, 0), W, D, 8, 2, Palette.nipa, MAT.Grass, true)
		-- hagdan (front stairs) with railing
		for i = 1, 3 do
			local top = FH - i
			P(m, { Size = V(5, top, 1.2), CFrame = CF(0, top / 2, D / 2 + (i - 0.5) * 1.2), Color = Palette.bamboo, Material = MAT.WoodPlanks })
		end
		for _, sx in { -1, 1 } do
			vcyl(m, sx * 2.6, 0, D / 2 + 3.6, 3.5, 0.3, Palette.bambooDark)
			P(m, {
				Size = V(0.25, 0.25, 4.2),
				CFrame = CF(sx * 2.6, 4.6, D / 2 + 1.8) * ANG(-0.6, 0, 0),
				Color = Palette.bambooDark,
				Material = MAT.Wood,
			})
		end
	else
		-- painted lower band, window grills, red GI roof, front porch
		for _, spec in { { V(W + 0.1, 1.2, 0.1), CF(0, FH + 0.6, D / 2) }, { V(W + 0.1, 1.2, 0.1), CF(0, FH + 0.6, -D / 2) } } do
			P(m, { Size = spec[1], CFrame = spec[2], Color = C(90, 140, 160), Material = MAT.Concrete })
		end
		for _, x in { -9, 9 } do
			for i = 0, 4 do
				P(m, { Size = V(0.12, 3.5, 0.12), CFrame = CF(x - 2 + i, FH + 4.75, D / 2 + 0.1), Color = C(40, 40, 40), Material = MAT.Metal })
			end
		end
		gableRoof(m, CF(0, FH + WH, 0), W, D, 4, 1.5, C(170, 60, 50), MAT.CorrodedMetal, true)
		P(m, { Size = V(10, FH, 3), CFrame = CF(0, FH / 2, D / 2 + 1.5), Color = C(200, 190, 175), Material = MAT.Concrete })
		P(m, { ClassName = "WedgePart", Size = V(10, 0.6, 1.5), CFrame = CF(0, FH / 2, D / 2 + 3.75) * ANG(0, PI, 0), Color = C(200, 190, 175), Material = MAT.Concrete })
	end
	return m
end

function Builders.BahayKubo()
	return Builders.House("Kubo")
end

-- A whole residential lot: plot, fence (bakod), sign, house, tree.
function Builders.Lot(style: string?)
	style = style or "Kubo"
	local isKubo = style == "Kubo"
	local m = newModel("Lot")
	local half = 28
	P(m, { Name = "Plot", Size = V(half * 2, 0.2, half * 2), CFrame = CF(0, -0.1, 0), Color = C(112, 168, 76), Material = MAT.Grass })
	local railColor = if isKubo then Palette.bamboo else C(220, 215, 205)
	local postColor = if isKubo then Palette.bambooDark else C(200, 195, 185)
	local function rail(fromV: Vector3, toV: Vector3)
		local mid = (fromV + toV) / 2
		for _, y in { 1.1, 2.4 } do
			P(m, {
				Size = V(0.25, 0.25, (toV - fromV).Magnitude),
				CFrame = CFrame.lookAt(mid + V(0, y, 0), toV + V(0, y, 0)),
				Color = railColor,
				Material = if isKubo then MAT.Wood else MAT.Concrete,
			})
		end
		local steps = math.floor((toV - fromV).Magnitude / 4)
		for i = 0, steps do
			local p = fromV:Lerp(toV, i / math.max(steps, 1))
			if isKubo then
				vcyl(m, p.X, 0, p.Z, 3, 0.4, postColor)
			else
				P(m, { Size = V(0.6, 3, 0.6), CFrame = CF(p.X, 1.5, p.Z), Color = postColor, Material = MAT.Concrete })
			end
		end
	end
	rail(V(-half, 0, -half), V(half, 0, -half))
	rail(V(-half, 0, -half), V(-half, 0, half))
	rail(V(half, 0, -half), V(half, 0, half))
	rail(V(-half, 0, half), V(-5, 0, half))
	rail(V(5, 0, half), V(half, 0, half))
	local house = Builders.House(style)
	house:PivotTo(CF(0, 0, -8))
	house.Parent = m
	P(m, { Size = V(4, 0.1, 12), CFrame = CF(0, 0.05, 22), Color = if isKubo then C(150, 120, 85) else C(170, 168, 160), Material = if isKubo then MAT.Ground else MAT.Concrete })
	vcyl(m, 18, 0, 26, 5, 0.35, Palette.woodDark)
	local board = P(m, { Name = "Sign", Size = V(8, 2.5, 0.3), CFrame = CF(18, 4.6, 26.2) * ANG(0, PI, 0), Color = Palette.wood, Material = MAT.WoodPlanks })
	Util.surfaceText(board, Enum.NormalId.Front, "Bakanteng Lote", C(255, 240, 200))
	local tree = Builders.CoconutTree(math.random(1, 1000))
	tree:PivotTo(CF(-23, 0, 22))
	tree.Parent = m
	if isKubo then
		local tree2 = Builders.CoconutTree(math.random(1, 1000))
		tree2:PivotTo(CF(23, 0, -23))
		tree2.Parent = m
	end
	return m
end

--------------------------------------------------------------------------
-- PHASE 0 ADDITIONS: travel, work places, metro & farm scenery
--------------------------------------------------------------------------

-- Provincial bus. Front is -Z (it drives "forward" along its LookVector). Seats are named "BusSeat".
function Builders.Bus(color: Color3?, signText: string?)
	local m = newModel("Bus")
	local body = color or C(210, 55, 50)
	local W, L = 7, 24
	local glass = C(150, 190, 210)
	P(m, { Name = "Floor", Size = V(W, 0.5, L), CFrame = CF(0, 1.75, 0), Color = C(60, 60, 64), Material = MAT.DiamondPlate })
	P(m, { Name = "Chassis", Size = V(W - 0.6, 1, L - 1), CFrame = CF(0, 1, 0), Color = C(40, 40, 44), Material = MAT.Metal })
	-- left wall (solid lower, glass upper)
	P(m, { Size = V(0.3, 2.4, L), CFrame = CF(-W / 2 + 0.15, 3.2, 0), Color = body, Material = MAT.Metal })
	P(m, { Size = V(0.2, 2.4, L), CFrame = CF(-W / 2 + 0.15, 5.6, 0), Color = glass, Material = MAT.Glass, Transparency = 0.55 })
	-- right wall with a door gap at the front
	P(m, { Size = V(0.3, 2.4, L - 3), CFrame = CF(W / 2 - 0.15, 3.2, 1.5), Color = body, Material = MAT.Metal })
	P(m, { Size = V(0.2, 2.4, L - 3), CFrame = CF(W / 2 - 0.15, 5.6, 1.5), Color = glass, Material = MAT.Glass, Transparency = 0.55 })
	-- white stripe both sides
	for _, sx in { -1, 1 } do
		P(m, { Size = V(0.35, 0.4, L), CFrame = CF(sx * (W / 2 - 0.1), 4.25, 0), Color = Palette.white, Material = MAT.SmoothPlastic, CanCollide = false })
	end
	-- front and back
	P(m, { Size = V(W, 2.4, 0.3), CFrame = CF(0, 3.2, -L / 2 + 0.15), Color = body, Material = MAT.Metal })
	P(m, { Name = "Windshield", Size = V(W - 0.4, 2.6, 0.1), CFrame = CF(0, 5.6, -L / 2 + 0.1), Color = glass, Material = MAT.Glass, Transparency = 0.5 })
	P(m, { Size = V(W, 5, 0.3), CFrame = CF(0, 4.4, L / 2 - 0.15), Color = body, Material = MAT.Metal })
	P(m, { Name = "Roof", Size = V(W + 0.2, 0.4, L + 0.2), CFrame = CF(0, 7.1, 0), Color = Palette.white, Material = MAT.Metal })
	local sign = P(m, { Name = "Ruta", Size = V(5.5, 1, 0.2), CFrame = CF(0, 6.4, -L / 2 + 0.05), Color = C(30, 30, 30), Material = MAT.SmoothPlastic, CanCollide = false })
	local label = Util.surfaceText(sign, Enum.NormalId.Front, signText or "BIYAHE", C(255, 200, 60), Enum.Font.GothamBold)
	label.Name = "RouteLabel"
	for _, sx in { -1, 1 } do
		P(m, { Shape = Enum.PartType.Cylinder, Size = V(0.15, 0.8, 0.8), CFrame = CF(sx * 2.5, 2.6, -L / 2 - 0.05) * ANG(0, PI / 2, 0), Color = C(255, 250, 220), Material = MAT.Neon })
		for _, z in { -L / 2 + 4, L / 2 - 4 } do
			P(m, { Shape = Enum.PartType.Cylinder, Size = V(1, 2.6, 2.6), CFrame = CF(sx * (W / 2 - 0.3), 1.3, z), Color = C(25, 25, 25), Material = MAT.SmoothPlastic })
		end
	end
	-- driver (decor seat + steering wheel)
	P(m, { Size = V(1.8, 0.3, 1.8), CFrame = CF(-2, 2.6, -L / 2 + 2.5), Color = C(30, 30, 30) })
	P(m, { Shape = Enum.PartType.Cylinder, Size = V(0.15, 1.3, 1.3), CFrame = CF(-2, 4, -L / 2 + 1.4) * ANG(0, PI / 2, 0), Color = C(20, 20, 20) })
	-- passenger seats: 7 rows × 2 sides, facing forward (-Z)
	for row = 0, 6 do
		local z = -L / 2 + 6 + row * 2.6
		for _, x in { -2, 2 } do
			P(m, { ClassName = "Seat", Name = "BusSeat", Size = V(2.4, 0.3, 1.6), CFrame = CF(x, 2.6, z), Color = C(40, 80, 150), Material = MAT.Fabric })
			P(m, { Size = V(2.4, 1.8, 0.25), CFrame = CF(x, 3.5, z + 0.9), Color = C(40, 80, 150), Material = MAT.Fabric })
		end
	end
	promptPart(m, CF(W / 2 + 0.8, 3, -L / 2 + 1.5))
	return m
end

function Builders.BusTerminal(text: string?)
	local m = newModel("Terminal")
	P(m, { Size = V(18, 0.4, 7), CFrame = CF(0, 0.2, 0), Color = C(180, 178, 170), Material = MAT.Concrete })
	for _, x in { -8, 8 } do
		for _, z in { -3, 3 } do
			vcyl(m, x, 0.4, z, 7.5, 0.4, Palette.metal, MAT.Metal)
		end
	end
	P(m, { Size = V(19, 0.3, 8), CFrame = CF(0, 8, 0), Color = C(30, 90, 160), Material = MAT.CorrodedMetal })
	bench(m, CF(-4, 0.4, -1.5), 6)
	bench(m, CF(4, 0.4, -1.5), 6)
	local sign = P(m, { Size = V(14, 1.6, 0.2), CFrame = CF(0, 6.9, 3.6), Color = Palette.flagYellow })
	Util.surfaceText(sign, Enum.NormalId.Back, text or "TERMINAL", Palette.flagBlue)
	return m
end

-- Rice paddy with dikes (pilapil), rice tufts and a little farm hut. Station: Palayan.
function Builders.Palayan(seed: number?)
	local m = newModel("Palayan", "Palayan")
	local rng = Random.new(seed or 1)
	P(m, { Name = "Tubig", Size = V(24, 0.3, 16), CFrame = CF(0, 0.05, 0), Color = C(110, 120, 70), Material = MAT.Mud })
	for _, spec in { { V(25, 0.6, 1), CF(0, 0.3, 8) }, { V(25, 0.6, 1), CF(0, 0.3, -8) }, { V(1, 0.6, 16), CF(12, 0.3, 0) }, { V(1, 0.6, 16), CF(-12, 0.3, 0) } } do
		P(m, { Size = spec[1], CFrame = spec[2], Color = C(120, 95, 60), Material = MAT.Ground })
	end
	for ix = 0, 9 do
		for iz = 0, 5 do
			P(m, {
				Size = V(0.5, rng:NextNumber(0.9, 1.4), 0.5),
				CFrame = CF(-10.5 + ix * 2.33, 0.7, -6 + iz * 2.4),
				Color = Color3.fromHSV(rng:NextNumber(0.22, 0.28), 0.7, 0.75),
				Material = MAT.Grass,
				CanCollide = false,
			})
		end
	end
	-- kubo-kubo (rest hut)
	for _, x in { 13.5, 18.5 } do
		for _, z in { 5.5, 9.5 } do
			vcyl(m, x, 0, z, 5, 0.4, Palette.bambooDark)
		end
	end
	P(m, { Size = V(6, 0.3, 5), CFrame = CF(16, 1.6, 7.5), Color = Palette.bamboo, Material = MAT.WoodPlanks })
	gableRoof(m, CF(16, 5, 7.5), 6, 5, 2, 0.6, Palette.nipa, MAT.Grass, false)
	usePoint(m, CFrame.lookAt(V(0, 0.6, 9.5), V(0, 0.6, 0)))
	promptPart(m, CF(0, 2, 8.5))
	return m
end

function Builders.Kalabaw()
	local m = newModel("Kalabaw")
	local gray = C(70, 70, 75)
	P(m, { Size = V(2.4, 2.2, 5), CFrame = CF(0, 2.6, 0), Color = gray })
	P(m, { Size = V(1.6, 1.5, 1.8), CFrame = CF(0, 3, -3.1), Color = gray })
	P(m, { Size = V(1.2, 0.8, 0.6), CFrame = CF(0, 2.6, -4.1), Color = C(55, 55, 60) })
	for _, sx in { -1, 1 } do
		P(m, { Size = V(1.6, 0.3, 0.3), CFrame = CF(sx * 1.4, 4, -3.2) * ANG(0, 0, sx * -0.5), Color = C(220, 210, 190) })
		for _, z in { -1.8, 1.8 } do
			P(m, { Size = V(0.6, 1.6, 0.6), CFrame = CF(sx * 0.8, 0.8, z), Color = gray })
		end
	end
	P(m, { Size = V(0.2, 1.4, 0.2), CFrame = CF(0, 2.6, 2.6) * ANG(0.4, 0, 0), Color = gray })
	return m
end

function Builders.ConstructionSite()
	local m = newModel("Construction", "Construction")
	local block = C(150, 150, 145)
	P(m, { Size = V(16, 0.3, 12), CFrame = CF(0, 0.15, 0), Color = C(150, 130, 100), Material = MAT.Ground })
	for i = 0, 5 do
		P(m, { Size = V(14, 1, 0.8), CFrame = CF(0, 0.8 + i, -4), Color = if i % 2 == 0 then block else C(160, 160, 155), Material = MAT.Concrete })
	end
	P(m, { Size = V(0.8, 6, 7), CFrame = CF(-7, 3.3, -0.5), Color = block, Material = MAT.Concrete })
	-- bamboo scaffolding
	for _, x in { -6, -2, 2, 6 } do
		vcyl(m, x, 0.3, -2.5, 10, 0.25, Palette.bambooDark)
	end
	for _, y in { 3, 6, 9 } do
		P(m, { Shape = Enum.PartType.Cylinder, Size = V(13, 0.25, 0.25), CFrame = CF(0, y, -2.5), Color = Palette.bamboo, Material = MAT.Wood })
	end
	-- cement mixer and sand pile
	P(m, { Shape = Enum.PartType.Cylinder, Size = V(2.4, 2, 2), CFrame = CF(4, 2, 2.5) * ANG(0, 0, 0.5), Color = C(240, 130, 30), Material = MAT.Metal })
	P(m, { Size = V(1.6, 1, 1.6), CFrame = CF(4, 0.8, 2.5), Color = C(60, 60, 60), Material = MAT.Metal })
	P(m, { ClassName = "WedgePart", Size = V(3, 1.5, 2), CFrame = CF(-3, 1.05, 3), Color = C(210, 180, 120), Material = MAT.Sand })
	P(m, { ClassName = "WedgePart", Size = V(3, 1.5, 2), CFrame = CF(-3, 1.05, 5) * ANG(0, PI, 0), Color = C(210, 180, 120), Material = MAT.Sand })
	local sign = P(m, { Size = V(6, 2, 0.2), CFrame = CF(5, 3, 6), Color = Palette.flagYellow })
	Util.surfaceText(sign, Enum.NormalId.Back, "MAY GINAGAWA · SAFETY FIRST", C(40, 40, 40))
	vcyl(m, 5, 0, 5.8, 2, 0.2, Palette.metal, MAT.Metal)
	usePoint(m, CFrame.lookAt(V(0, 0.3, 0), V(0, 0.3, -4)))
	promptPart(m, CF(0, 2, 2))
	return m
end

-- Office tower for the metro skyline. Optional stationId/sign makes it a workplace.
function Builders.Tower(width: number, depth: number, floors: number, color: Color3, stationId: string?, signText: string?)
	local m = newModel("Tower", stationId)
	local floorH = 4
	local height = floors * floorH
	P(m, { Name = "Body", Size = V(width, height, depth), CFrame = CF(0, height / 2, 0), Color = color, Material = MAT.Concrete })
	for f = 1, floors - 1 do
		P(m, {
			Size = V(width + 0.1, 1.8, depth + 0.1),
			CFrame = CF(0, f * floorH + 0.4, 0),
			Color = C(120, 170, 210),
			Material = MAT.Glass,
			Reflectance = 0.15,
			CanCollide = false,
		})
	end
	P(m, { Size = V(width * 0.4, 3, depth * 0.4), CFrame = CF(0, height + 1.5, 0), Color = C(170, 170, 170), Material = MAT.Concrete })
	vcyl(m, width * 0.25, height, depth * 0.25, 3, 2, C(80, 80, 85), MAT.Metal) -- water tank
	P(m, { Size = V(6, 3.2, 0.2), CFrame = CF(0, 1.6, depth / 2 + 0.05), Color = C(40, 50, 60), Material = MAT.Glass })
	if signText then
		local sign = P(m, { Size = V(math.min(width - 2, 18), 2, 0.3), CFrame = CF(0, height - 2, depth / 2 + 0.2), Color = Palette.white })
		Util.surfaceText(sign, Enum.NormalId.Back, signText, Palette.flagBlue)
	end
	if stationId then
		usePoint(m, CFrame.lookAt(V(0, 0, depth / 2 + 2.5), V(0, 0, 0)))
		promptPart(m, CF(0, 3, depth / 2 + 1.5))
	end
	return m
end

-- Pier and a passenger/cargo ship. Station: Pantalan (Seaman job).
function Builders.Pantalan()
	local m = newModel("Pantalan", "Pantalan")
	P(m, { Size = V(8, 0.8, 60), CFrame = CF(0, 1, -30), Color = Palette.wood, Material = MAT.WoodPlanks })
	for z = -58, -4, 9 do
		for _, x in { -3.5, 3.5 } do
			vcyl(m, x, -6, z, 7.4, 0.8, Palette.woodDark)
		end
	end
	local hull = C(240, 240, 240)
	P(m, { Name = "Barko", Size = V(16, 8, 50), CFrame = CF(13, -1, -38), Color = hull, Material = MAT.Metal })
	P(m, { Size = V(16.1, 2, 50.1), CFrame = CF(13, -4, -38), Color = Palette.flagBlue, Material = MAT.Metal })
	P(m, { ClassName = "WedgePart", Size = V(16, 8, 10), CFrame = CF(13, -1, -68) * ANG(0, 0, PI), Color = hull, Material = MAT.Metal })
	P(m, { Size = V(12, 6, 14), CFrame = CF(13, 6, -30), Color = hull, Material = MAT.Metal })
	P(m, { Size = V(12.1, 1.4, 14.1), CFrame = CF(13, 7, -30), Color = C(40, 60, 80), Material = MAT.Glass })
	vcyl(m, 13, 9, -22, 5, 3, Palette.flagRed, MAT.Metal)
	usePoint(m, CFrame.lookAt(V(0, 1.4, -55), V(13, 1.4, -55)))
	promptPart(m, CF(0, 3, -55))
	return m
end

-- Distant hill scenery (ellipsoid). Non-collidable so players never snag on its box.
function Builders.Bundok(size: Vector3, color: Color3?)
	local m = newModel("Bundok")
	local hill = P(m, { Size = size, CFrame = CF(0, size.Y * 0.3, 0), Color = color or C(70, 130, 60), Material = MAT.Grass, CanCollide = false, CanQuery = false })
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = hill
	return m
end

--------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------
function Models.has(id: string): boolean
	return Builders[id] ~= nil
end

function Models.build(id: string, ...): Model
	local builder = Builders[id]
	assert(builder, "Walang model builder para sa: " .. tostring(id))
	return builder(...)
end

return Models
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[--[[
	Util — small helpers shared by server and client.
]]

local Util = {}

-- Create an anchored, smooth part from a property table.
-- Pass ClassName = "WedgePart" / "Seat" etc. to make other part types.
function Util.part(props: { [string]: any }): BasePart
	local part = Instance.new(props.ClassName or "Part") :: BasePart
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		(part :: any).Shape = props.Shape
	end
	for key, value in props do
		if key ~= "ClassName" and key ~= "Parent" and key ~= "Shape" then
			(part :: any)[key] = value
		end
	end
	if props.Parent then
		part.Parent = props.Parent
	end
	return part
end

-- CFrame at `pos` whose +Z (our "front") faces `target` on the horizontal plane.
function Util.facing(pos: Vector3, target: Vector3): CFrame
	local flatTarget = Vector3.new(target.X, pos.Y, target.Z)
	if (flatTarget - pos).Magnitude < 1e-3 then
		return CFrame.new(pos)
	end
	return CFrame.lookAt(pos, pos + (pos - flatTarget))
end

-- Put a big, readable text label on one face of a part.
function Util.surfaceText(part: BasePart, face: Enum.NormalId, text: string, color: Color3?, font: Enum.Font?)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SurfaceText"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.3

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = font or Enum.Font.FredokaOne
	label.TextColor3 = color or Color3.new(0.1, 0.1, 0.1)
	label.Text = text
	label.Parent = gui

	gui.Parent = part
	return label
end

function Util.formatPesos(amount: number?): string
	local n = math.floor(amount or 0)
	local digits = tostring(math.abs(n))
	local withCommas = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if withCommas:sub(1, 1) == "," then
		withCommas = withCommas:sub(2)
	end
	return (if n < 0 then "-₱" else "₱") .. withCommas
end

function Util.formatClock(clockTime: number): string
	local hour = math.floor(clockTime) % 24
	local minute = math.floor((clockTime - math.floor(clockTime)) * 60)
	local suffix = if hour < 12 then "AM" else "PM"
	local hour12 = hour % 12
	if hour12 == 0 then
		hour12 = 12
	end
	return string.format("%d:%02d %s", hour12, minute, suffix)
end

function Util.formatHour(hour: number): string
	hour = hour % 24
	local suffix = if hour < 12 then "AM" else "PM"
	local hour12 = hour % 12
	if hour12 == 0 then
		hour12 = 12
	end
	return hour12 .. suffix
end

-- Filipino part-of-day label for the clock.
function Util.timeOfDay(clockTime: number): string
	if clockTime < 5 then
		return "Madaling-araw"
	elseif clockTime < 11 then
		return "Umaga"
	elseif clockTime < 13 then
		return "Tanghali"
	elseif clockTime < 18 then
		return "Hapon"
	end
	return "Gabi"
end

function Util.inHours(clockTime: number, hours: { number }?): boolean
	if not hours then
		return true
	end
	local open, close = hours[1], hours[2]
	if open < close then
		return clockTime >= open and clockTime < close
	end
	return clockTime >= open or clockTime < close -- wraps past midnight
end

function Util.averageNeeds(source: Instance, needOrder: { string }): number
	local total = 0
	for _, id in needOrder do
		total += source:GetAttribute("Need_" .. id) or 100
	end
	return total / #needOrder
end

return Util
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX24"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX23"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX7"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	Bahay Buhay — a Filipino-themed life simulation.
	Server entry point: builds the world and wires all services together.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local Services = script.Parent:WaitForChild("Services")
local Remotes = require(Services.Remotes)
local Overhead = require(Services.Overhead)
local NeedsService = require(Services.NeedsService)
local ActionService = require(Services.ActionService)
local StationService = require(Services.StationService)
local LotService = require(Services.LotService)
local BuildService = require(Services.BuildService)
local DataService = require(Services.DataService)
local TimeService = require(Services.TimeService)
local NPCService = require(Services.NPCService)
local WorldBuilder = require(Services.WorldBuilder)
local TravelService = require(Services.TravelService)
local IdentityService = require(Services.IdentityService)
local CareerService = require(Services.CareerService)

NeedsService.bind(ActionService)

-- 1) World (three cities in one shared map)
StationService.init()
WorldBuilder.build()
LotService.init()
NPCService.init()
TimeService.init()
TravelService.init()

-- 2) Systems
ActionService.init()
NeedsService.start()
BuildService.init()
IdentityService.init()
CareerService.init()

--------------------------------------------------------------------------
-- Players
--------------------------------------------------------------------------
local function teleportHome(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local lot = LotService.get(player)
	local target = if lot
		then LotService.spawnCFrame(lot)
		else CFrame.new(Config.city(player:GetAttribute("Hometown")).spawn)
	ActionService.stop(player, "cancel")
	-- with StreamingEnabled, load the destination for this player before moving them there
	pcall(function()
		player:RequestStreamAroundAsync(target.Position, 5)
	end)
	character:PivotTo(target)
end

local function onCharacterAdded(player: Player, character: Model)
	task.spawn(function()
		Overhead.attach(character)
		Overhead.setAge(player, player:GetAttribute("Age"))
	end)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if humanoid then
		humanoid.WalkSpeed = Config.WalkSpeed
	end
	character:WaitForChild("HumanoidRootPart", 10)
	task.wait() -- let the default spawn finish before moving the character
	teleportHome(player)
end

local function onPlayerAdded(player: Player)
	player.CameraMaxZoomDistance = 90

	local profile, isNew = DataService.load(player)
	if not player.Parent then
		return -- left while loading
	end

	-- Ikot ng Kapalaran: roll a starting life once, the first time we see this player
	local identity = IdentityService.sanitize(profile.Identity)
	if not identity then
		identity = IdentityService.roll()
		profile.IdentitySeen = false
		if isNew then
			profile.Pesos = Config.YamanEffects.startingPesos[identity.Yaman]
		end
	end
	DataService.apply(player, profile)
	IdentityService.apply(player, identity)
	player:GetAttributeChangedSignal("Age"):Connect(function()
		Overhead.setAge(player, player:GetAttribute("Age"))
	end)

	local lot = LotService.assign(player, identity.Hometown)
	if not lot then
		player:SetAttribute("HomeCity", identity.Hometown)
	end
	if lot then
		BuildService.load(player, profile.Furniture)
	end

	player:SetAttribute("Loaded", true)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		onCharacterAdded(player, player.Character)
	end

	task.delay(3, function()
		if not player.Parent then
			return
		end
		if player:GetAttribute("IdentitySeen") then
			Remotes.notify(player, "🏠 Maligayang pagbabalik, " .. player.DisplayName .. "!", "good")
		end
		if not lot then
			Remotes.notify(player, "Puno na ang mga lote sa server na ito. Makikitira ka muna sa bayan mo (boarding house: darating sa Phase 1).", "warn")
		elseif lot.city ~= identity.Hometown then
			Remotes.notify(player, "🏠 Puno na ang lote sa bayan mo, kaya sa " .. Config.city(lot.city).name .. " ka muna nakatira.", "info")
		end
	end)
end

local function savePlayer(player: Player)
	DataService.save(player, BuildService.serialize(player), IdentityService.collect(player))
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	ActionService.stop(player, "leave")
	savePlayer(player) -- must happen before the lot is cleared
	LotService.release(player)
	DataService.release(player)
end)

Remotes.GoHome.OnServerEvent:Connect(function(player)
	if LotService.get(player) then
		teleportHome(player)
	else
		Remotes.notify(player, "Wala kang sariling lote.", "warn")
	end
end)

-- Autosave
task.spawn(function()
	while true do
		task.wait(Config.AutosaveSeconds)
		for _, player in Players:GetPlayers() do
			task.spawn(savePlayer, player)
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for _, player in Players:GetPlayers() do
		pending += 1
		task.spawn(function()
			savePlayer(player)
			pending -= 1
		end)
	end
	local deadline = os.clock() + 25
	while pending > 0 and os.clock() < deadline do
		task.wait(0.2)
	end
end)

--------------------------------------------------------------------------
-- Every morning: bills, relationship decay, greeting
--------------------------------------------------------------------------
TimeService.onMorning(function(day)
	for _, player in Players:GetPlayers() do
		if not player:GetAttribute("Loaded") then
			continue
		end
		player:SetAttribute("DaysPlayed", (player:GetAttribute("DaysPlayed") or 0) + 1)
		player:SetAttribute("EarnedToday", 0)

		IdentityService.morningAllowance(player)

		-- aging: one year every Config.DaysPerYear mornings you're online for
		local ageDays = (player:GetAttribute("AgeDays") or 0) + 1
		if ageDays >= Config.DaysPerYear then
			ageDays = 0
			local age = (player:GetAttribute("Age") or Config.StartAge) + 1
			player:SetAttribute("Age", age)
			Remotes.notify(player, string.format("🎂 Maligayang kaarawan! %d taong gulang ka na.", age), "good")
		end
		player:SetAttribute("AgeDays", ageDays)

		local lot = LotService.get(player)
		local costMult = Config.city(lot and lot.city).costMult
		local bill = math.floor((Config.BillBase + Config.BillPerFurniture * BuildService.count(player)) * costMult + 0.5)
		local pesos = player:GetAttribute("Pesos") or 0
		local paid = math.min(bill, pesos)
		player:SetAttribute("Pesos", pesos - paid)

		Remotes.notify(player, string.format("☀️ Magandang umaga! Araw %d na.", day), "info")
		if paid < bill then
			Remotes.notify(player, "⚠️ Kulang ang pambayad sa kuryente at tubig! Magtrabaho ka na.", "bad")
			NeedsService.add(player, "Fun", -15)
		else
			Remotes.notify(player, "🧾 Bayad na ang kuryente at tubig: " .. Util.formatPesos(bill), "info")
		end

		for _, npc in Config.NPCs do
			local key = "Rel_" .. npc.id
			player:SetAttribute(key, math.max(0, (player:GetAttribute(key) or 0) - Config.RelationshipDailyDecay))
		end
	end
end)

print(string.format("[%s v%s] Handa na ang barangay!", Config.GameName, Config.Version))
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX22"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">ActionService</string><ProtectedString name="Source"><![CDATA[--[[
	ActionService — runs timed interactions (sleeping, cooking, working, chatting…).

	Flow: StationService (prompt/menu) → ActionService.start(player, station, actionId)
	      → character is positioned at the station's UsePoint
	      → every tick: needs change, pay & skill xp accumulate, progress updates
	      → finishes after `duration`, or is cancelled (player moves / jumps / presses Itigil).

	Replicated state lives in player attributes:
	  CurrentAction (string verb) and ActionProgress (0..1).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Remotes = require(script.Parent.Remotes)
local Overhead = require(script.Parent.Overhead)
local NeedsService = require(script.Parent.NeedsService)

local ActionService = {}

type ActiveAction = {
	id: string,
	def: any,
	station: Model?,
	elapsed: number,
	paidFraction: number,
	xpFraction: number,
	xpMult: number,
	seat: Seat?,
	lying: boolean,
	effectMult: number,
	payMult: number,
}

local active: { [Player]: ActiveAction } = {}
local TICK = 0.25
local FISH = { "bangus", "tilapia", "galunggong", "lapu-lapu", "tamban", "dilis", "tulingan" }

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------
local function getParts(player: Player)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil, nil
	end
	return humanoid, root
end

local function skillLevel(player: Player, skill: string?): number
	if not skill then
		return 0
	end
	return Config.skillLevel(player:GetAttribute("Skill_" .. skill))
end

local function addSkillXp(player: Player, skill: string, xp: number)
	local key = "Skill_" .. skill
	local before = player:GetAttribute(key) or 0
	local after = before + xp
	player:SetAttribute(key, after)
	local oldLevel, newLevel = Config.skillLevel(before), Config.skillLevel(after)
	if newLevel > oldLevel then
		local info = Config.Skills[skill]
		Remotes.notify(player, string.format("%s Tumaas ang %s mo! Level %d na.", info.icon, info.label, newLevel), "good")
	end
end

local function addRelationship(player: Player, npcId: string, amount: number)
	local key = "Rel_" .. npcId
	local before = player:GetAttribute(key) or 0
	local after = math.clamp(before + amount, 0, 100)
	player:SetAttribute(key, after)
	local oldLabel, newLabel = Config.relationshipLabel(before), Config.relationshipLabel(after)
	local npc = Config.NPCById[npcId]
	if npc and oldLabel ~= newLabel and after > before then
		Remotes.notify(player, string.format("❤️ %s mo na si %s!", newLabel, npc.name), "good")
	end
end

local function otherPlayerNearby(player: Player, position: Vector3, radius: number): boolean
	for _, other in Players:GetPlayers() do
		if other ~= player and other.Character then
			local root = other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and (root.Position - position).Magnitude <= radius then
				return true
			end
		end
	end
	return false
end

local function standOffset(humanoid: Humanoid, root: BasePart): number
	return humanoid.HipHeight + root.Size.Y / 2
end

local function stationUsable(station: Model, player: Player): (boolean, string?)
	local userId = station:GetAttribute("InUseBy")
	if userId and userId ~= player.UserId and Players:GetPlayerByUserId(userId) then
		local npcId = station:GetAttribute("NpcId")
		if npcId then
			return false, "Abala pa si " .. Config.NPCById[npcId].name .. ". Hintay lang."
		end
		return false, "May gumagamit pa nito. Hintay lang."
	end
	return true
end

-- Move the character into position for the action.
local function positionCharacter(state: ActiveAction, humanoid: Humanoid, root: BasePart)
	local station = state.station
	local point = station and station:FindFirstChild("UsePoint", true) :: BasePart?

	if point and point:IsA("Seat") then
		state.seat = point
		point:Sit(humanoid)
		return
	end

	root.Anchored = true
	if state.def.pose == "lie" then
		state.lying = true
		humanoid.PlatformStand = true
		local base: CFrame
		if point then
			base = point.CFrame
		else
			-- lie down right where you are (e.g. passing out)
			local yaw = select(2, root.CFrame:ToOrientation())
			local groundY = root.Position.Y - standOffset(humanoid, root)
			base = CFrame.new(root.Position.X, groundY, root.Position.Z) * CFrame.Angles(0, yaw, 0)
		end
		root.CFrame = base * CFrame.new(0, 1, 0) * CFrame.Angles(math.pi / 2, 0, 0)
	elseif point then
		root.CFrame = point.CFrame + Vector3.new(0, standOffset(humanoid, root), 0)
	elseif station then
		local target = station:GetPivot().Position
		local pos = root.Position
		local flat = Vector3.new(target.X, pos.Y, target.Z)
		if (flat - pos).Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(pos, flat)
		end
	end
end

local function restoreCharacter(player: Player, state: ActiveAction)
	local humanoid, root = getParts(player)
	if not humanoid or not root then
		return
	end
	if state.seat then
		local weld = state.seat:FindFirstChild("SeatWeld")
		if weld then
			weld:Destroy()
		end
		humanoid.Sit = false
		return
	end
	if state.lying then
		humanoid.PlatformStand = false
		local yaw = select(2, root.CFrame:ToOrientation())
		root.CFrame = CFrame.new(root.Position + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, yaw, 0)
	end
	root.Anchored = false
end

local function runDoneHook(player: Player, state: ActiveAction)
	local def = state.def
	if def.doneHook == "VideokeScore" then
		local score = math.clamp(math.random(55, 92) + skillLevel(player, "Pagkanta") * 2, 0, 100)
		local comment = if score >= 95
			then "PERFECT! Pang-concert ang boses mo! 🎉"
			elseif score >= 80 then "Ang galing! Palakpakan!"
			elseif score >= 65 then "Pwede na! Next song!"
			else "Medyo sintunado... pero masaya naman!"
		Remotes.notify(player, string.format("🎤 Videoke score: %d — %s", score, comment), "good")
		if score >= 95 then
			NeedsService.add(player, "Fun", 10)
		end
	elseif def.doneHook == "Fishing" then
		local fish = FISH[math.random(1, #FISH)]
		Remotes.notify(player, "🐟 Nakahuli ka ng " .. fish .. "! Naibenta mo sa palengke.", "good")
	end
end

--------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------
function ActionService.isActive(player: Player): boolean
	return active[player] ~= nil
end

function ActionService.currentActionId(player: Player): string?
	local state = active[player]
	return state and state.id
end

-- True while the current action is raising this need (so it doesn't also decay).
function ActionService.isBoosting(player: Player, needId: string): boolean
	local state = active[player]
	return state ~= nil and (state.def.effects[needId] or 0) > 0
end

function ActionService.stop(player: Player, reason: string?)
	local state = active[player]
	if not state then
		return
	end
	active[player] = nil

	if state.station and state.station.Parent then
		state.station:SetAttribute("InUseBy", nil)
	end
	player:SetAttribute("CurrentAction", nil)
	player:SetAttribute("ActionProgress", nil)
	Overhead.setBubble(player, nil)
	restoreCharacter(player, state)

	if reason == "done" then
		local def = state.def
		if def.relationship and state.station then
			local npcId = state.station:GetAttribute("NpcId")
			if npcId then
				addRelationship(player, npcId, def.relationship)
			end
		end
		runDoneHook(player, state)
		if def.doneMessages then
			Remotes.notify(player, def.doneMessages[math.random(1, #def.doneMessages)], "good")
		end
	end
end

local function begin(player: Player, actionId: string, station: Model?): (boolean, string?)
	local def = Config.Actions[actionId]
	if not def then
		return false, "Hindi kilalang gawain."
	end
	local humanoid, root = getParts(player)
	if not humanoid or not root then
		return false, nil
	end

	if def.profession and player:GetAttribute("Profession") ~= def.profession then
		local prof = Config.Professions[def.profession]
		return false, "💼 Hindi ito ang trabaho mo. Mag-apply muna bilang " .. prof.label .. " sa PESO Office."
	end

	if def.hours and not Util.inHours(Lighting.ClockTime, def.hours) then
		return false, string.format(
			"⏰ Hindi pa pwede ngayon. Bukas mula %s hanggang %s.",
			Util.formatHour(def.hours[1]),
			Util.formatHour(def.hours[2])
		)
	end

	if station then
		local ok, msg = stationUsable(station, player)
		if not ok then
			return false, msg
		end
	end

	local cityId = station and station:GetAttribute("City")
	local cost = Config.scaledCost(def, cityId)
	local pesos = player:GetAttribute("Pesos") or 0
	if cost > pesos then
		return false, "💸 Kulang ang pera mo! Kailangan mo ng " .. Util.formatPesos(cost) .. "."
	end

	if active[player] then
		ActionService.stop(player, "switch")
	end

	if cost > 0 then
		player:SetAttribute("Pesos", pesos - cost)
	end

	local level = skillLevel(player, def.skill)
	local state: ActiveAction = {
		id = actionId,
		def = def,
		station = station,
		elapsed = 0,
		paidFraction = 0,
		xpFraction = 0,
		seat = nil,
		lying = false,
		effectMult = if def.skillBoost then 1 + level * Config.SkillEffectBonus else 1,
		payMult = NeedsService.getMood(player).payMult
			* (if def.payBoost then 1 + level * Config.SkillPayBonus else 1)
			* Config.city(cityId).payMult,
		xpMult = Config.xpMultiplier(player, def.skill),
	}
	active[player] = state

	if station then
		station:SetAttribute("InUseBy", player.UserId)
	end
	player:SetAttribute("CurrentAction", def.verb or def.label)
	player:SetAttribute("ActionProgress", 0)
	Overhead.setBubble(player, def.bubble)
	positionCharacter(state, humanoid, root)
	return true, nil
end

function ActionService.start(player: Player, station: Model, actionId: string)
	local ok, msg = begin(player, actionId, station)
	if not ok and msg then
		Remotes.notify(player, msg, "warn")
	end
	return ok
end

-- Actions not tied to an object (e.g. passing out from exhaustion).
function ActionService.startSpecial(player: Player, actionId: string)
	local ok, msg = begin(player, actionId, nil)
	if not ok and msg then
		Remotes.notify(player, msg, "warn")
	end
	return ok
end

local function step(player: Player, state: ActiveAction, dt: number)
	local humanoid, root = getParts(player)
	if not humanoid or not root then
		ActionService.stop(player, "cancel")
		return
	end
	if state.station and not state.station.Parent then
		ActionService.stop(player, "cancel")
		return
	end
	if state.seat and humanoid.SeatPart ~= state.seat then
		-- give Seat:Sit a moment to weld before treating it as "stood up"
		if state.elapsed > 0.75 then
			ActionService.stop(player, "cancel")
			return
		end
	end

	local def = state.def
	local frac = math.min(dt, def.duration - state.elapsed) / def.duration
	state.elapsed += dt

	for needId, amount in def.effects do
		local mult = if amount > 0 then state.effectMult else 1
		NeedsService.add(player, needId, amount * frac * mult)
	end
	if def.socialNearby and otherPlayerNearby(player, root.Position, 18) then
		NeedsService.add(player, "Social", def.socialNearby * frac)
	end

	if def.pay then
		state.paidFraction += def.pay * frac * state.payMult
		local whole = math.floor(state.paidFraction)
		if whole > 0 then
			state.paidFraction -= whole
			player:SetAttribute("Pesos", (player:GetAttribute("Pesos") or 0) + whole)
			player:SetAttribute("EarnedToday", (player:GetAttribute("EarnedToday") or 0) + whole)
		end
	end

	if def.skill and def.skillXp then
		state.xpFraction += def.skillXp * frac * state.xpMult
		if state.xpFraction >= 1 then
			local whole = math.floor(state.xpFraction)
			state.xpFraction -= whole
			addSkillXp(player, def.skill, whole)
		end
	end

	player:SetAttribute("ActionProgress", math.clamp(state.elapsed / def.duration, 0, 1))
	if state.elapsed >= def.duration then
		ActionService.stop(player, "done")
	end
end

function ActionService.init()
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(TICK)
			local now = os.clock()
			local dt = now - last
			last = now
			for player, state in active do
				step(player, state, dt)
			end
		end
	end)

	Remotes.CancelAction.OnServerEvent:Connect(function(player)
		ActionService.stop(player, "cancel")
	end)
	Players.PlayerRemoving:Connect(function(player)
		ActionService.stop(player, "leave")
	end)
end

return ActionService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">BuildService</string><ProtectedString name="Source"><![CDATA[--[[
	BuildService — buying, placing and selling furniture on your own lot.
	The client sends lot-relative coordinates; the server validates everything
	(ownership, bounds, money, limits) before spawning the model.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Models = require(ReplicatedStorage.Shared.Models)
local Util = require(ReplicatedStorage.Shared.Util)
local Remotes = require(script.Parent.Remotes)
local LotService = require(script.Parent.LotService)
local StationService = require(script.Parent.StationService)

local BuildService = {}

local function isFiniteNumber(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

function BuildService.spawn(lot, id: string, x: number, y: number, z: number, rotation: number): Model?
	if not Config.FurnitureById[id] or not Models.has(id) then
		return nil
	end
	local model = Models.build(id)
	model:SetAttribute("FurnitureId", id)
	if lot.owner then
		model:SetAttribute("OwnerUserId", lot.owner.UserId)
	end
	model:SetAttribute("DisplayName", Config.FurnitureById[id].name)
	model:SetAttribute("City", lot.city)
	model:PivotTo(lot.origin * CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(rotation), 0))
	model.Parent = lot.furniture
	StationService.make(model)
	return model
end

-- Furniture → plain table for saving (lot-relative, so it loads on any lot).
-- Items inside the house store `fy` (height above the house floor) so they still sit
-- correctly if the player later gets a lot with a different house type.
function BuildService.serialize(player: Player): { any }
	local lot = LotService.get(player)
	local list = {}
	if not lot then
		return list
	end
	for _, model in lot.furniture:GetChildren() do
		local id = model:GetAttribute("FurnitureId")
		if id and model:IsA("Model") then
			local rel = lot.origin:ToObjectSpace(model:GetPivot())
			local _, ry, _ = rel:ToOrientation()
			local entry = {
				id = id,
				x = math.floor(rel.X * 100 + 0.5) / 100,
				z = math.floor(rel.Z * 100 + 0.5) / 100,
				r = (math.floor(math.deg(ry) / 90 + 0.5) * 90) % 360,
			}
			if Config.insideHouse(rel.X, rel.Z) then
				entry.fy = math.floor((rel.Y - lot.floorY) * 100 + 0.5) / 100
			else
				entry.y = math.floor(rel.Y * 100 + 0.5) / 100
			end
			table.insert(list, entry)
		end
	end
	return list
end

local LEGACY_FLOOR_Y = 4 -- v0.1 saves were all bahay kubo

function BuildService.load(player: Player, furniture: { any }?)
	local lot = LotService.get(player)
	if not lot then
		return
	end
	lot.furniture:ClearAllChildren()
	for _, item in furniture or Config.StarterFurniture do
		if type(item) ~= "table" or type(item.x) ~= "number" or type(item.z) ~= "number" then
			continue
		end
		local y
		if type(item.fy) == "number" then
			y = lot.floorY + item.fy
		elseif item.inHouse then
			y = lot.floorY + (item.y or 0)
		elseif type(item.y) == "number" and Config.insideHouse(item.x, item.z) then
			y = lot.floorY + (item.y - LEGACY_FLOOR_Y)
		else
			y = item.y or 0
		end
		BuildService.spawn(lot, item.id, item.x, y, item.z, item.r or 0)
	end
end

function BuildService.count(player: Player): number
	local lot = LotService.get(player)
	return if lot then #lot.furniture:GetChildren() else 0
end

local function place(player: Player, id: any, x: any, y: any, z: any, rotation: any): (boolean, string)
	if type(id) ~= "string" or not Config.FurnitureById[id] then
		return false, "Hindi kilalang gamit."
	end
	if not (isFiniteNumber(x) and isFiniteNumber(y) and isFiniteNumber(z) and isFiniteNumber(rotation)) then
		return false, "Maling posisyon."
	end
	local lot = LotService.get(player)
	if not lot then
		return false, "Wala kang lote."
	end
	local half = Config.LotHalfSize
	if math.abs(x) > half or math.abs(z) > half or y < -0.5 or y > Config.MaxBuildHeight then
		return false, "Sa loob lang ng lote mo pwedeng maglagay."
	end
	if #lot.furniture:GetChildren() >= Config.MaxFurniturePerLot then
		return false, "Puno na ang bahay mo! Magbenta muna ng gamit."
	end
	local item = Config.FurnitureById[id]
	local pesos = player:GetAttribute("Pesos") or 0
	if pesos < item.price then
		return false, "💸 Kulang ang pera mo para sa " .. item.name .. "."
	end

	x = math.floor(x * 2 + 0.5) / 2
	z = math.floor(z * 2 + 0.5) / 2
	rotation = (math.floor(rotation / 90 + 0.5) * 90) % 360

	player:SetAttribute("Pesos", pesos - item.price)
	BuildService.spawn(lot, id, x, y, z, rotation)
	return true, "🛒 Nabili mo ang " .. item.name .. " (" .. Util.formatPesos(item.price) .. ")"
end

local function sell(player: Player, model: any): (boolean, string)
	local lot = LotService.get(player)
	if not lot or typeof(model) ~= "Instance" or model.Parent ~= lot.furniture then
		return false, "Hindi mo ito pwedeng ibenta."
	end
	if model:GetAttribute("InUseBy") then
		return false, "May gumagamit pa nito."
	end
	local item = Config.FurnitureById[model:GetAttribute("FurnitureId")]
	local refund = if item then math.floor(item.price * Config.SellRefund) else 0
	model:Destroy()
	player:SetAttribute("Pesos", (player:GetAttribute("Pesos") or 0) + refund)
	return true, "💰 Naibenta sa halagang " .. Util.formatPesos(refund)
end

function BuildService.init()
	Remotes.PlaceFurniture.OnServerInvoke = function(player, id, x, y, z, rotation)
		local ok, msg = place(player, id, x, y, z, rotation)
		return ok, msg
	end
	Remotes.SellFurniture.OnServerInvoke = function(player, model)
		local ok, msg = sell(player, model)
		return ok, msg
	end
end

return BuildService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">CareerService</string><ProtectedString name="Source"><![CDATA[--[[
	CareerService — the PESO (Public Employment Service Office) job board.
	Players pick one of the 10 professions; education gates some of them.
	A profession's job can only be done in the cities listed for it, so where
	you live vs. where you work becomes a real decision (commute or move).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(script.Parent.Remotes)

local CareerService = {}

local lastChange: { [Player]: number } = {}
local CHANGE_COOLDOWN = 30

function CareerService.init()
	Remotes.ChooseProfession.OnServerEvent:Connect(function(player, professionId)
		local prof = type(professionId) == "string" and Config.Professions[professionId]
		if not prof then
			return
		end
		if player:GetAttribute("Profession") == professionId then
			Remotes.notify(player, "Ito na ang trabaho mo ngayon.", "info")
			return
		end
		if not Config.meetsEducation(player:GetAttribute("Education"), prof.education) then
			local need = Config.Education[prof.education]
			Remotes.notify(player, "🔒 Kailangan mo ng " .. (need and need.label or prof.education) .. " para maging " .. prof.label .. ".", "warn")
			return
		end
		local now = os.clock()
		if lastChange[player] and now - lastChange[player] < CHANGE_COOLDOWN then
			Remotes.notify(player, "Kakapalit mo lang ng trabaho. Sandali lang.", "warn")
			return
		end
		lastChange[player] = now
		player:SetAttribute("Profession", professionId)

		local places = {}
		for _, cityId in prof.cities do
			table.insert(places, Config.city(cityId).name)
		end
		Remotes.notify(player, string.format("%s Natanggap ka bilang %s! Pwede kang magtrabaho sa: %s.",
			prof.icon, prof.label, table.concat(places, ", ")), "good")
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastChange[player] = nil
	end)
end

return CareerService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	DataService — loads and saves player progress with DataStoreService.

	Saved: pesos, needs, skills, relationships, furniture layout.
	In Studio, enable Game Settings → Security → "Enable Studio Access to API Services"
	to test saving. Without it the game still runs; progress just isn't saved.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[Bahay Buhay] DataStore unavailable, progress will not be saved:", result)
	end
end

local canSave: { [Player]: boolean } = {}

local function key(player: Player): string
	return "player_" .. player.UserId
end

function DataService.defaultProfile()
	local needs = {}
	for _, id in Config.NeedOrder do
		needs[id] = 85
	end
	return {
		Version = 2,
		Pesos = Config.StartingPesos,
		Identity = nil, -- rolled by IdentityService on first join
		IdentitySeen = false,
		Age = Config.StartAge,
		AgeDays = 0,
		Education = Config.StartEducation,
		Profession = nil,
		Needs = needs,
		Skills = {},
		Relationships = {},
		Furniture = nil, -- nil = give starter furniture
		DaysPlayed = 0,
	}
end

function DataService.load(player: Player)
	local data = nil
	local success = false
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync(key(player))
			end)
			if ok then
				data = result
				success = true
				break
			end
			warn(string.format("[Bahay Buhay] Load failed for %s (attempt %d): %s", player.Name, attempt, tostring(result)))
			if RunService:IsStudio() then
				break -- usually "API access not enabled"; don't make testers wait
			end
			task.wait(attempt * 1.5)
		end
	end
	canSave[player] = success

	local profile = DataService.defaultProfile()
	local isNew = true
	if type(data) == "table" then
		isNew = false
		profile.Pesos = tonumber(data.Pesos) or profile.Pesos
		profile.DaysPlayed = tonumber(data.DaysPlayed) or 0
		if type(data.Needs) == "table" then
			for id in profile.Needs do
				profile.Needs[id] = tonumber(data.Needs[id]) or profile.Needs[id]
			end
		end
		profile.Skills = if type(data.Skills) == "table" then data.Skills else {}
		profile.Relationships = if type(data.Relationships) == "table" then data.Relationships else {}
		profile.Furniture = if type(data.Furniture) == "table" then data.Furniture else nil
		profile.Identity = if type(data.Identity) == "table" then data.Identity else nil
		profile.IdentitySeen = data.IdentitySeen == true
		profile.Age = tonumber(data.Age) or Config.StartAge
		profile.AgeDays = tonumber(data.AgeDays) or 0
		profile.Education = if Config.Education[data.Education] then data.Education else Config.StartEducation
		profile.Profession = if Config.Professions[data.Profession] then data.Profession else nil
	end
	return profile, isNew
end

-- Push a profile into player attributes (the live source of truth while playing).
function DataService.apply(player: Player, profile)
	player:SetAttribute("Pesos", profile.Pesos)
	player:SetAttribute("DaysPlayed", profile.DaysPlayed)
	player:SetAttribute("IdentitySeen", profile.IdentitySeen)
	player:SetAttribute("Age", profile.Age)
	player:SetAttribute("AgeDays", profile.AgeDays)
	player:SetAttribute("Education", profile.Education)
	player:SetAttribute("Profession", profile.Profession)
	for _, id in Config.NeedOrder do
		player:SetAttribute("Need_" .. id, profile.Needs[id])
	end
	for id in Config.Skills do
		player:SetAttribute("Skill_" .. id, tonumber(profile.Skills[id]) or 0)
	end
	for _, npc in Config.NPCs do
		player:SetAttribute("Rel_" .. npc.id, tonumber(profile.Relationships[npc.id]) or 0)
	end
end

function DataService.collect(player: Player, furniture: { any }, identity: any)
	local profile = DataService.defaultProfile()
	profile.Identity = identity
	profile.IdentitySeen = player:GetAttribute("IdentitySeen") == true
	profile.Age = player:GetAttribute("Age") or Config.StartAge
	profile.AgeDays = player:GetAttribute("AgeDays") or 0
	profile.Education = player:GetAttribute("Education") or Config.StartEducation
	profile.Profession = player:GetAttribute("Profession")
	profile.Pesos = player:GetAttribute("Pesos") or 0
	profile.DaysPlayed = player:GetAttribute("DaysPlayed") or 0
	for _, id in Config.NeedOrder do
		profile.Needs[id] = math.floor((player:GetAttribute("Need_" .. id) or 85) * 10) / 10
	end
	for id in Config.Skills do
		profile.Skills[id] = player:GetAttribute("Skill_" .. id) or 0
	end
	for _, npc in Config.NPCs do
		profile.Relationships[npc.id] = player:GetAttribute("Rel_" .. npc.id) or 0
	end
	profile.Furniture = furniture
	return profile
end

function DataService.save(player: Player, furniture: { any }, identity: any)
	if not store or not canSave[player] or not player:GetAttribute("Loaded") then
		return
	end
	local profile = DataService.collect(player, furniture, identity)
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function()
			return profile
		end)
	end)
	if not ok then
		warn("[Bahay Buhay] Save failed for " .. player.Name .. ": " .. tostring(err))
	end
end

function DataService.release(player: Player)
	canSave[player] = nil
end

return DataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">IdentityService</string><ProtectedString name="Source"><![CDATA[--[[
	IdentityService — "Ikot ng Kapalaran". Rolls a new player's starting life:
	hometown, Yaman (wealth), Swerte (luck), DNA (talent), a natural talent skill,
	and their parents' jobs (derived from hometown + Yaman, never shown as characters).

	The roll happens on the server once and is saved, so rejoining never re-rolls.
	The client only animates the reveal of the result.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Remotes = require(script.Parent.Remotes)

local IdentityService = {}

local rng = Random.new()

local function weightedPick(entries: { any }, weightOf: (any) -> number): number
	local total = 0
	for _, e in entries do
		total += weightOf(e)
	end
	local roll = rng:NextNumber() * total
	for i, e in entries do
		roll -= weightOf(e)
		if roll <= 0 then
			return i
		end
	end
	return #entries
end

function IdentityService.roll()
	local cityIndex = weightedPick(Config.CityOrder, function(id)
		return Config.Cities[id].weight
	end)
	local hometown = Config.CityOrder[cityIndex]
	local identity = { Hometown = hometown }
	for _, metric in Config.MetricOrder do
		identity[metric] = weightedPick(Config.Metrics[metric].tiers, function(t)
			return t.weight
		end)
	end
	identity.Talent = Config.SkillOrder[rng:NextInteger(1, #Config.SkillOrder)]
	local pair = Config.ParentJobs[hometown][identity.Yaman]
	if rng:NextNumber() < 0.5 then
		identity.Papa, identity.Mama = pair[1], pair[2]
	else
		identity.Papa, identity.Mama = pair[2], pair[1]
	end
	return identity
end

-- Validates a saved identity table; returns nil if anything is off (so we re-roll).
function IdentityService.sanitize(data: any)
	if type(data) ~= "table" or not Config.Cities[data.Hometown] then
		return nil
	end
	for _, metric in Config.MetricOrder do
		local tier = data[metric]
		if type(tier) ~= "number" or tier < 1 or tier > 3 then
			return nil
		end
	end
	if not Config.Skills[data.Talent] or not Config.Professions[data.Papa] or not Config.Professions[data.Mama] then
		return nil
	end
	return data
end

function IdentityService.apply(player: Player, identity)
	player:SetAttribute("Hometown", identity.Hometown)
	for _, metric in Config.MetricOrder do
		player:SetAttribute(metric, identity[metric])
	end
	player:SetAttribute("Talent", identity.Talent)
	player:SetAttribute("Papa", identity.Papa)
	player:SetAttribute("Mama", identity.Mama)
end

function IdentityService.collect(player: Player)
	local identity = { Hometown = player:GetAttribute("Hometown") }
	for _, metric in Config.MetricOrder do
		identity[metric] = player:GetAttribute(metric)
	end
	identity.Talent = player:GetAttribute("Talent")
	identity.Papa = player:GetAttribute("Papa")
	identity.Mama = player:GetAttribute("Mama")
	return IdentityService.sanitize(identity)
end

-- Story messages from the (unseen) parents right after the reveal.
local function introStory(player: Player)
	local yaman = player:GetAttribute("Yaman") or 2
	local city = Config.city(player:GetAttribute("Hometown"))
	local papa = Config.Professions[player:GetAttribute("Papa")]
	local mama = Config.Professions[player:GetAttribute("Mama")]
	Remotes.notify(player, string.format("%s Ipinanganak ka sa %s. Si Papa ay %s, si Mama ay %s.",
		city.icon, city.name, papa.label:lower(), mama.label:lower()), "info")
	task.wait(3)
	Remotes.notify(player, Config.ParentIntro[yaman], "info")
	task.wait(3)
	if not player:GetAttribute("Profession") then
		Remotes.notify(player, "💼 Wala ka pang trabaho. Pumunta sa PESO Office para mag-apply!", "warn")
	end
end

-- Morning "padala" from parents, scaled by Yaman.
function IdentityService.morningAllowance(player: Player)
	local yaman = player:GetAttribute("Yaman") or 2
	local amount = Config.YamanEffects.dailyAllowance[yaman] or 0
	if amount > 0 then
		player:SetAttribute("Pesos", (player:GetAttribute("Pesos") or 0) + amount)
		local who = if math.random() < 0.5 then "Papa" else "Mama"
		Remotes.notify(player, string.format("📱 %s: Nagpadala ako ng %s pang-gastos mo. Ingat, anak!", who, Util.formatPesos(amount)), "good")
	elseif math.random() < 0.35 then
		Remotes.notify(player, "📱 Mama: Anak, kumusta ka na? Pasensya na at wala kaming maipadala ngayon.", "info")
	end
end

function IdentityService.init()
	Remotes.IdentitySeen.OnServerEvent:Connect(function(player)
		if player:GetAttribute("IdentitySeen") then
			return
		end
		player:SetAttribute("IdentitySeen", true)
		task.spawn(introStory, player)
	end)
end

return IdentityService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">LotService</string><ProtectedString name="Source"><![CDATA[--[[
	LotService — residential lots in each of the three cities.
	Baybay Alon and San Bukid lots have a bahay kubo; Metro Dakila lots have a concrete bungalow.
	A joining player gets a free lot in their hometown if possible, otherwise any free lot.

	Lot model layout (in workspace.Lots):
	  <City>Lot<N> (Model, attributes OwnerUserId, City, LotIndex)
	    ├─ Origin    invisible part; its CFrame is the lot's coordinate frame (+Z faces the road)
	    ├─ Furniture folder of placed furniture models
	    └─ … plot, fence, house, sign
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Models = require(ReplicatedStorage.Shared.Models)
local Util = require(ReplicatedStorage.Shared.Util)

local LotService = {}

export type Lot = {
	index: number,
	city: string,
	floorY: number,
	origin: CFrame,
	model: Model,
	furniture: Folder,
	owner: Player?,
}

local lots: { Lot } = {}

-- Lot centres relative to each city's origin, and the direction toward the road.
local LOT_OFFSETS = {
	{ pos = Vector3.new(-60, 0.2, 115), toRoad = Vector3.new(0, 0, -1) },
	{ pos = Vector3.new(0, 0.2, 115), toRoad = Vector3.new(0, 0, -1) },
	{ pos = Vector3.new(60, 0.2, 115), toRoad = Vector3.new(0, 0, -1) },
	{ pos = Vector3.new(-60, 0.2, -115), toRoad = Vector3.new(0, 0, 1) },
	{ pos = Vector3.new(0, 0.2, -115), toRoad = Vector3.new(0, 0, 1) },
	{ pos = Vector3.new(60, 0.2, -115), toRoad = Vector3.new(0, 0, 1) },
}

local function setSign(lot: Lot, text: string)
	local sign = lot.model:FindFirstChild("Sign", true)
	local label = sign and sign:FindFirstChild("Label", true)
	if label then
		(label :: TextLabel).Text = text
	end
end

function LotService.init()
	local folder = Instance.new("Folder")
	folder.Name = "Lots"
	folder.Parent = workspace

	for _, cityId in Config.CityOrder do
		local city = Config.Cities[cityId]
		local style = city.house
		for n, layout in LOT_OFFSETS do
			local pos = city.origin + layout.pos
			-- lookAt makes -Z face the target; we want +Z to face the road.
			local origin = CFrame.lookAt(pos, pos - layout.toRoad)
			local model = Models.build("Lot", style)
			model.Name = cityId .. "Lot" .. n
			model:PivotTo(origin)

			Util.part({
				Name = "Origin",
				Size = Vector3.new(1, 1, 1),
				CFrame = origin,
				Transparency = 1,
				CanCollide = false,
				CanTouch = false,
				CanQuery = false,
				Parent = model,
			})
			local furniture = Instance.new("Folder")
			furniture.Name = "Furniture"
			furniture.Parent = model

			local index = #lots + 1
			model:SetAttribute("LotIndex", index)
			model:SetAttribute("City", cityId)
			model.Parent = folder

			lots[index] = {
				index = index,
				city = cityId,
				floorY = Config.HouseTypes[style].floorY,
				origin = origin,
				model = model,
				furniture = furniture,
				owner = nil,
			}
		end
	end
end

local function claim(lot: Lot, player: Player)
	lot.owner = player
	lot.model:SetAttribute("OwnerUserId", player.UserId)
	player:SetAttribute("LotIndex", lot.index)
	player:SetAttribute("HomeCity", lot.city)
	setSign(lot, "Bahay ni " .. player.DisplayName)
end

-- Prefer a lot in `preferredCity`; fall back to any free lot.
function LotService.assign(player: Player, preferredCity: string?): Lot?
	for _, lot in lots do
		if lot.owner == nil and lot.city == preferredCity then
			claim(lot, player)
			return lot
		end
	end
	for _, lot in lots do
		if lot.owner == nil then
			claim(lot, player)
			return lot
		end
	end
	return nil
end

function LotService.release(player: Player)
	for _, lot in lots do
		if lot.owner == player then
			lot.owner = nil
			lot.model:SetAttribute("OwnerUserId", nil)
			lot.furniture:ClearAllChildren()
			setSign(lot, "Bakanteng Lote")
		end
	end
end

function LotService.get(player: Player): Lot?
	for _, lot in lots do
		if lot.owner == player then
			return lot
		end
	end
	return nil
end

-- Where a player appears at home: in the yard, facing the house.
function LotService.spawnCFrame(lot: Lot): CFrame
	return lot.origin * CFrame.new(0, 3.5, 18)
end

function LotService.all(): { Lot }
	return lots
end

return LotService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">NPCService</string><ProtectedString name="Source"><![CDATA[--[[
	NPCService — the neighbours (mga kapitbahay) who wander the barangay.
	Talk to them to raise Pakikisama and build a relationship.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local StationService = require(script.Parent.StationService)

local NPCService = {}

local C = Color3.fromRGB

-- Roblox's default R15 animation ids (the same ones the stock Animate script uses).
local WALK_ANIM = "rbxassetid://507777826"
local IDLE_ANIM = "rbxassetid://507766388"

local function weldTo(head: BasePart, part: BasePart, offset: CFrame)
	part.Anchored = false
	part.CanCollide = false
	part.Massless = true
	part.CFrame = head.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = part
	weld.Parent = part
	part.Parent = head.Parent
end

local function addAccessory(model: Model, kind: string?)
	local head = model:FindFirstChild("Head") :: BasePart?
	local torso = (model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")) :: BasePart?
	if not head then
		return
	end
	if kind == "Salakot" then
		-- traditional wide farmer's hat
		weldTo(head, Util.part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 3.2, 3.2), Color = C(205, 170, 100), Material = Enum.Material.Fabric }),
			CFrame.new(0, 0.75, 0) * CFrame.Angles(0, 0, math.pi / 2))
		weldTo(head, Util.part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 1.6, 1.6), Color = C(185, 150, 85), Material = Enum.Material.Fabric }),
			CFrame.new(0, 1.05, 0) * CFrame.Angles(0, 0, math.pi / 2))
	elseif kind == "Bun" then
		weldTo(head, Util.part({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.3, 1.3, 1.3), Color = C(200, 200, 205), Material = Enum.Material.Fabric }),
			CFrame.new(0, 0.2, 0.15))
		weldTo(head, Util.part({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.7, 0.7, 0.7), Color = C(200, 200, 205), Material = Enum.Material.Fabric }),
			CFrame.new(0, 0.5, 0.7))
	elseif kind == "Towel" and torso then
		weldTo(torso, Util.part({ Size = Vector3.new(0.6, 0.15, 1.4), Color = C(245, 245, 245), Material = Enum.Material.Fabric }),
			CFrame.new(0.55, 1.05, 0))
		weldTo(head, Util.part({ Size = Vector3.new(1.3, 0.35, 1.3), Color = C(40, 80, 160), Material = Enum.Material.Fabric }),
			CFrame.new(0, 0.65, 0))
	elseif kind == "Apron" and torso then
		weldTo(torso, Util.part({ Size = Vector3.new(1.6, 1.8, 0.1), Color = C(255, 240, 200), Material = Enum.Material.Fabric }),
			CFrame.new(0, -0.6, -0.55))
	end
end

local function buildRig(def): Model?
	local ok, result = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = def.skin
		desc.LeftArmColor = def.skin
		desc.RightArmColor = def.skin
		desc.TorsoColor = def.shirt
		desc.LeftLegColor = def.pants
		desc.RightLegColor = def.pants
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and result then
		return result
	end
	warn("[Bahay Buhay] Could not build NPC rig for " .. def.name .. ": " .. tostring(result))
	return nil
end

local function speechBubble(model: Model)
	local head = model:FindFirstChild("Head")
	if not head then
		return nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Speech"
	gui.Size = UDim2.new(8, 0, 1.6, 0)
	gui.StudsOffset = Vector3.new(0, 3.4, 0)
	gui.MaxDistance = 60
	gui.Enabled = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.new(1, 1, 1)
	label.TextColor3 = C(40, 30, 30)
	label.Font = Enum.Font.GothamMedium
	label.TextScaled = true
	label.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.4, 0)
	corner.Parent = label
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.Parent = label
	gui.Parent = head
	return gui
end

local function say(gui: BillboardGui?, text: string)
	if not gui then
		return
	end
	(gui:FindFirstChildOfClass("TextLabel") :: TextLabel).Text = text
	gui.Enabled = true
	task.delay(4, function()
		if gui.Parent then
			gui.Enabled = false
		end
	end)
end

local function playAnimations(humanoid: Humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local ok = pcall(function()
		local walk = Instance.new("Animation")
		walk.AnimationId = WALK_ANIM
		local idle = Instance.new("Animation")
		idle.AnimationId = IDLE_ANIM
		local walkTrack = animator:LoadAnimation(walk)
		local idleTrack = animator:LoadAnimation(idle)
		idleTrack.Looped = true
		walkTrack.Looped = true
		idleTrack:Play()
		humanoid.Running:Connect(function(speed)
			if speed > 0.5 then
				if not walkTrack.IsPlaying then
					walkTrack:Play(0.2)
				end
			elseif walkTrack.IsPlaying then
				walkTrack:Stop(0.2)
			end
		end)
	end)
	if not ok then
		warn("[Bahay Buhay] NPC animations unavailable")
	end
end

local function wander(model: Model, def, humanoid: Humanoid, root: BasePart, speech)
	local home = def.home
	local radius = 14
	local talkingTo = nil
	while model.Parent do
		local userId = model:GetAttribute("InUseBy")
		if userId then
			if talkingTo ~= userId then
				talkingTo = userId
				say(speech, def.lines[math.random(1, #def.lines)])
			end
			humanoid:MoveTo(root.Position)
			local player = Players:GetPlayerByUserId(userId)
			local otherRoot = player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if otherRoot then
				local pos = root.Position
				local target = Vector3.new(otherRoot.Position.X, pos.Y, otherRoot.Position.Z)
				if (target - pos).Magnitude > 0.5 then
					root.CFrame = CFrame.lookAt(pos, target)
				end
			end
			task.wait(0.5)
		else
			talkingTo = nil
			local angle = math.random() * math.pi * 2
			local dist = math.random() * radius
			humanoid:MoveTo(home + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist))
			local reached = false
			local conn = humanoid.MoveToFinished:Connect(function()
				reached = true
			end)
			local t0 = os.clock()
			while not reached and os.clock() - t0 < 8 and not model:GetAttribute("InUseBy") do
				task.wait(0.2)
			end
			conn:Disconnect()
			if math.random() < 0.25 and not model:GetAttribute("InUseBy") then
				say(speech, def.lines[math.random(1, #def.lines)])
			end
			local idleUntil = os.clock() + math.random(2, 6)
			while os.clock() < idleUntil and not model:GetAttribute("InUseBy") do
				task.wait(0.2)
			end
		end
	end
end

function NPCService.init()
	local folder = Instance.new("Folder")
	folder.Name = "NPCs"
	folder.Parent = workspace

	for _, def in Config.NPCs do
		task.spawn(function()
			local model = buildRig(def)
			if not model then
				return
			end
			model.Name = def.name
			local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
			local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
			humanoid.DisplayName = def.name
			humanoid.WalkSpeed = def.walkSpeed or 8
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
			local animate = model:FindFirstChild("Animate")
			if animate then
				animate:Destroy()
			end
			addAccessory(model, def.accessory)

			model:SetAttribute("StationId", def.station)
			model:SetAttribute("NpcId", def.id)
			model:SetAttribute("DisplayName", def.name)
			model:PivotTo(CFrame.new(def.home + Vector3.new(0, 3, 0)))
			model.Parent = folder
			pcall(function()
				root:SetNetworkOwner(nil)
			end)
			playAnimations(humanoid)
			local speech = speechBubble(model)
			StationService.make(model)
			wander(model, def, humanoid, root, speech)
		end)
	end
end

return NPCService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">NeedsService</string><ProtectedString name="Source"><![CDATA[--[[
	NeedsService — needs decay over time, mood, low-need warnings and consequences.
	Needs are stored as player attributes ("Need_Hunger" …) so the client UI can read them directly.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Remotes = require(script.Parent.Remotes)
local Overhead = require(script.Parent.Overhead)

local NeedsService = {}

local actions -- ActionService, injected via bind() to avoid a circular require
local warned: { [Player]: { [string]: boolean } } = {}

function NeedsService.bind(actionService)
	actions = actionService
end

function NeedsService.get(player: Player, id: string): number
	return player:GetAttribute("Need_" .. id) or 100
end

function NeedsService.set(player: Player, id: string, value: number)
	player:SetAttribute("Need_" .. id, math.clamp(value, 0, 100))
end

function NeedsService.add(player: Player, id: string, delta: number)
	NeedsService.set(player, id, NeedsService.get(player, id) + delta)
end

function NeedsService.getMood(player: Player)
	return Config.getMood(Util.averageNeeds(player, Config.NeedOrder))
end

local function checkWarnings(player: Player)
	local state = warned[player]
	if not state then
		state = {}
		warned[player] = state
	end
	for _, id in Config.NeedOrder do
		local value = NeedsService.get(player, id)
		if value < 20 and not state[id] then
			state[id] = true
			Remotes.notify(player, Config.Needs[id].icon .. " " .. Config.Needs[id].lowText, "warn")
		elseif value > 35 then
			state[id] = nil
		end
	end
end

local function applyConsequences(player: Player)
	local busy = actions and actions.isActive(player)
	local currentId = actions and actions.currentActionId(player)

	-- Bagsak sa pagod: fall asleep on the spot
	local seated = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	seated = seated and seated.SeatPart ~= nil
	if NeedsService.get(player, "Energy") <= 0 and not busy and not seated and actions then
		Remotes.notify(player, "😵 Bumagsak ka sa sobrang pagod! Nakatulog ka sa sahig.", "bad")
		actions.startSpecial(player, "Nahimatay")
	end

	-- Naihi sa salawal
	if NeedsService.get(player, "Bladder") <= 0 and currentId ~= "MagCR" then
		NeedsService.set(player, "Bladder", 100)
		NeedsService.set(player, "Hygiene", 0)
		NeedsService.add(player, "Fun", -15)
		Remotes.notify(player, "😳 Naku! Hindi ka umabot sa CR... Nakakahiya! Maligo ka na.", "bad")
	end

	-- Walk slower when hungry or exhausted
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local tired = NeedsService.get(player, "Energy") < 12 or NeedsService.get(player, "Hunger") < 10
		humanoid.WalkSpeed = if tired then Config.TiredWalkSpeed else Config.WalkSpeed
	end
end

function NeedsService.tick(dt: number)
	for _, player in Players:GetPlayers() do
		if not player:GetAttribute("Loaded") then
			continue
		end
		for _, id in Config.NeedOrder do
			if not (actions and actions.isBoosting(player, id)) then
				local mult = 1
				if id == "Social" then
					mult = Config.YamanEffects.socialDecayMult[player:GetAttribute("Yaman") or 2] or 1
				end
				NeedsService.add(player, id, -Config.Needs[id].decayPerMinute / 60 * dt * mult)
			end
		end
		local mood = NeedsService.getMood(player)
		player:SetAttribute("Mood", mood.label)
		Overhead.setMoodColor(player, mood.color)
		checkWarnings(player)
		applyConsequences(player)
	end
end

function NeedsService.start()
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local now = os.clock()
			NeedsService.tick(now - last)
			last = now
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		warned[player] = nil
	end)
end

return NeedsService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Overhead</string><ProtectedString name="Source"><![CDATA[--[[
	Overhead — the floating parol (star) above each player that shows their mood,
	plus the emoji thought bubble that shows what they're doing.
]]

local Overhead = {}

function Overhead.attach(character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head then
		return
	end
	local old = head:FindFirstChild("Overhead")
	if old then
		old:Destroy()
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "Overhead"
	gui.Size = UDim2.new(4, 0, 2, 0)
	gui.StudsOffset = Vector3.new(0, 3.1, 0)
	gui.MaxDistance = 120
	gui.LightInfluence = 0

	local star = Instance.new("TextLabel")
	star.Name = "Parol"
	star.Size = UDim2.fromScale(0.5, 1)
	star.Position = UDim2.fromScale(0.25, 0)
	star.BackgroundTransparency = 1
	star.Text = "★"
	star.TextScaled = true
	star.Font = Enum.Font.GothamBold
	star.TextColor3 = Color3.fromRGB(80, 220, 120)
	star.TextStrokeTransparency = 0.4
	star.Parent = gui

	local bubble = Instance.new("TextLabel")
	bubble.Name = "Bubble"
	bubble.Size = UDim2.fromScale(0.42, 0.84)
	bubble.Position = UDim2.fromScale(0.78, -0.25)
	bubble.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	bubble.BackgroundTransparency = 0.05
	bubble.Text = ""
	bubble.TextScaled = true
	bubble.Visible = false
	bubble.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = bubble

	-- Age is the only identity detail other players can see.
	local age = Instance.new("TextLabel")
	age.Name = "Age"
	age.Size = UDim2.fromScale(1.4, 0.45)
	age.Position = UDim2.fromScale(-0.2, 1.0)
	age.BackgroundTransparency = 1
	age.Text = ""
	age.TextScaled = true
	age.Font = Enum.Font.GothamBold
	age.TextColor3 = Color3.fromRGB(255, 255, 255)
	age.TextStrokeTransparency = 0.3
	age.Parent = gui

	gui.Parent = head
end

function Overhead.setAge(player: Player, years: number?)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local gui = head and head:FindFirstChild("Overhead")
	local label = gui and gui:FindFirstChild("Age") :: TextLabel?
	if label then
		label.Text = if years then string.format("%d taong gulang", years) else ""
	end
end

local function getGui(player: Player): BillboardGui?
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	return head and head:FindFirstChild("Overhead") :: BillboardGui?
end

function Overhead.setMoodColor(player: Player, color: Color3)
	local gui = getGui(player)
	if gui then
		(gui:FindFirstChild("Parol") :: TextLabel).TextColor3 = color
	end
end

function Overhead.setBubble(player: Player, emoji: string?)
	local gui = getGui(player)
	if gui then
		local bubble = gui:FindFirstChild("Bubble") :: TextLabel
		bubble.Text = emoji or ""
		bubble.Visible = emoji ~= nil
	end
end

return Overhead
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--[[
	Remotes — creates every RemoteEvent / RemoteFunction the game uses.
	The client waits for ReplicatedStorage.Remotes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local EVENTS = {
	"OpenMenu", -- server → client (stationModel, stationId)
	"RequestAction", -- client → server (stationModel, actionId)
	"CancelAction", -- client → server ()
	"Notify", -- server → client (text, kind)
	"GoHome", -- client → server ()
	"OpenCareer", -- server → client () — PESO office job board
	"ChooseProfession", -- client → server (professionId)
	"IdentitySeen", -- client → server () — finished watching the spin wheel
}
local FUNCTIONS = {
	"PlaceFurniture", -- (id, x, y, z, rotation) → ok, message
	"SellFurniture", -- (model) → ok, message
}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

for _, name in EVENTS do
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	Remotes[name] = remote
end
for _, name in FUNCTIONS do
	local remote = Instance.new("RemoteFunction")
	remote.Name = name
	remote.Parent = folder
	Remotes[name] = remote
end

folder.Parent = ReplicatedStorage

-- kind: "info" | "good" | "warn" | "bad"
function Remotes.notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function Remotes.notifyAll(text: string, kind: string?)
	Remotes.Notify:FireAllClients(text, kind or "info")
end

return Remotes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">StationService</string><ProtectedString name="Source"><![CDATA[--[[
	StationService — turns every Model tagged "Station" into something interactive.
	A ProximityPrompt is added; triggering it either starts the single action or
	opens a choice menu on the client (e.g. the sari-sari store's list of snacks).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(script.Parent.Remotes)
local ActionService = require(script.Parent.ActionService)

local StationService = {}

local TAG = "Station"
local MAX_USE_DISTANCE = 16

local function promptParent(model: Model): BasePart?
	local explicit = model:FindFirstChild("PromptPart", true)
	if explicit and explicit:IsA("BasePart") then
		return explicit
	end
	return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function register(model: Instance)
	if not model:IsA("Model") or model:GetAttribute("PromptReady") then
		return
	end
	local stationId = model:GetAttribute("StationId")
	local cfg = stationId and Config.Stations[stationId]
	if not cfg or (#cfg.actions == 0 and not cfg.special) then
		return
	end
	local parent = promptParent(model)
	if not parent then
		return
	end
	model:SetAttribute("PromptReady", true)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "StationPrompt"
	prompt.ActionText = cfg.prompt or "Gamitin"
	prompt.ObjectText = model:GetAttribute("DisplayName") or cfg.title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = parent

	prompt.Triggered:Connect(function(player)
		if cfg.special == "Career" then
			Remotes.OpenCareer:FireClient(player)
		elseif #cfg.actions == 1 then
			ActionService.start(player, model, cfg.actions[1])
		else
			Remotes.OpenMenu:FireClient(player, model, stationId)
		end
	end)
end

local function distanceOk(player: Player, model: Model): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local anchor = promptParent(model)
	if not root or not anchor then
		return false
	end
	return (root.Position - anchor.Position).Magnitude <= MAX_USE_DISTANCE
end

function StationService.init()
	for _, model in CollectionService:GetTagged(TAG) do
		register(model)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(register)

	Remotes.RequestAction.OnServerEvent:Connect(function(player, model, actionId)
		if typeof(model) ~= "Instance" or not model:IsA("Model") or type(actionId) ~= "string" then
			return
		end
		if not CollectionService:HasTag(model, TAG) then
			return
		end
		local cfg = Config.Stations[model:GetAttribute("StationId")]
		if not cfg or not table.find(cfg.actions, actionId) then
			return
		end
		if not distanceOk(player, model) then
			Remotes.notify(player, "Lumapit ka muna.", "warn")
			return
		end
		ActionService.start(player, model, actionId)
	end)
end

-- Convenience for other services: tag a model so it becomes interactive.
function StationService.make(model: Model)
	CollectionService:AddTag(model, TAG)
end

return StationService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">TimeService</string><ProtectedString name="Source"><![CDATA[--[[
	TimeService — day/night cycle. One in-game day lasts Config.DayLengthMinutes.
	Switches on lamps and parols at night and fires onMorning callbacks at 6 AM.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local TimeService = {}

local morningCallbacks = {}
local nightOn: boolean? = nil

function TimeService.onMorning(callback: (day: number) -> ())
	table.insert(morningCallbacks, callback)
end

local function setNightLights(on: boolean)
	if nightOn == on then
		return
	end
	nightOn = on
	for _, part in CollectionService:GetTagged("NightLight") do
		for _, child in part:GetChildren() do
			if child:IsA("Light") then
				child.Enabled = on
			end
		end
	end
end

function TimeService.init()
	Lighting.ClockTime = Config.StartClockTime
	ReplicatedStorage:SetAttribute("Day", 1)

	local hoursPerSecond = 24 / (Config.DayLengthMinutes * 60)
	local day = 1

	-- newly placed parols should match the current state
	CollectionService:GetInstanceAddedSignal("NightLight"):Connect(function(part)
		for _, child in part:GetChildren() do
			if child:IsA("Light") then
				child.Enabled = nightOn == true
			end
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		local previous = Lighting.ClockTime
		local now = previous + hoursPerSecond * dt
		if now >= 24 then
			now -= 24
		end
		Lighting.ClockTime = now

		if previous < Config.MorningHour and now >= Config.MorningHour then
			day += 1
			ReplicatedStorage:SetAttribute("Day", day)
			for _, callback in morningCallbacks do
				task.spawn(callback, day)
			end
		end
		setNightLights(now >= 18 or now < 6)
	end)
end

return TimeService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">TravelService</string><ProtectedString name="Source"><![CDATA[--[[
	TravelService — provincial buses connecting the three cities in the shared world.

	Each route has buses that shuttle between two terminals on a schedule:
	  boarding (dwell) → fare collected at departure → drive the road → arrive → repeat.
	Passengers sit together (they can chat!) and may get surprise trip events,
	weighted by their Swerte (luck): coins, a generous ninong, a pickpocket...
	Press Space (jump) to get off.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Models = require(ReplicatedStorage.Shared.Models)
local Util = require(ReplicatedStorage.Shared.Util)
local Remotes = require(script.Parent.Remotes)
local NeedsService = require(script.Parent.NeedsService)
local ActionService = require(script.Parent.ActionService)

local TravelService = {}

local LANE_OFFSET = 5
local routePoints: { [string]: { Vector3 } } = {}
local folder: Folder
local rng = Random.new()

type Path = { points: { Vector3 }, cumulative: { number }, total: number }

--------------------------------------------------------------------------
-- Path helpers
--------------------------------------------------------------------------
local function laneOf(points: { Vector3 }, offset: number): { Vector3 }
	local out = {}
	for i, p in points do
		local a = points[math.max(1, i - 1)]
		local b = points[math.min(#points, i + 1)]
		local dir = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
		if dir.Magnitude < 1e-3 then
			dir = Vector3.new(1, 0, 0)
		end
		local right = dir.Unit:Cross(Vector3.yAxis)
		out[i] = p + right * offset
	end
	return out
end

local function reversed(points: { Vector3 }): { Vector3 }
	local out = {}
	for i = #points, 1, -1 do
		table.insert(out, points[i])
	end
	return out
end

local function makePath(points: { Vector3 }): Path
	local cumulative = { 0 }
	for i = 2, #points do
		cumulative[i] = cumulative[i - 1] + (points[i] - points[i - 1]).Magnitude
	end
	return { points = points, cumulative = cumulative, total = cumulative[#points] }
end

local function sample(path: Path, distance: number): (Vector3, Vector3)
	local pts, cum = path.points, path.cumulative
	distance = math.clamp(distance, 0, path.total)
	for i = 2, #pts do
		if distance <= cum[i] or i == #pts then
			local segLen = cum[i] - cum[i - 1]
			local t = if segLen > 0 then (distance - cum[i - 1]) / segLen else 0
			local dir = pts[i] - pts[i - 1]
			return pts[i - 1]:Lerp(pts[i], t), if dir.Magnitude > 0 then dir.Unit else Vector3.new(1, 0, 0)
		end
	end
	return pts[#pts], Vector3.new(1, 0, 0)
end

local function flatLook(pos: Vector3, dir: Vector3): CFrame
	-- keep the bus level-ish on slopes: only pitch slightly with the road
	return CFrame.lookAt(pos, pos + dir)
end

--------------------------------------------------------------------------
-- Passengers
--------------------------------------------------------------------------
local function occupantPlayer(seat: Seat): Player?
	local humanoid = seat.Occupant
	return humanoid and Players:GetPlayerFromCharacter(humanoid.Parent) or nil
end

local function unseat(seat: Seat)
	local humanoid = seat.Occupant
	local weld = seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
	if humanoid then
		humanoid.Sit = false
		humanoid.Jump = true
	end
end

local function pickEvent(player: Player)
	local swerte = player:GetAttribute("Swerte") or 2
	local goodMult = Config.SwerteEffects.goodEventMult[swerte] or 1
	local badMult = Config.SwerteEffects.badEventMult[swerte] or 1
	local total = 0
	for _, e in Config.TripEvents do
		total += e.weight * (if e.good then goodMult else badMult)
	end
	local roll = rng:NextNumber() * total
	for _, e in Config.TripEvents do
		roll -= e.weight * (if e.good then goodMult else badMult)
		if roll <= 0 then
			return e
		end
	end
	return Config.TripEvents[1]
end

local function applyEvent(player: Player, event)
	local text = event.text
	if event.pesos then
		local amount = rng:NextInteger(event.pesos[1], event.pesos[2])
		local pesos = player:GetAttribute("Pesos") or 0
		if amount < 0 then
			amount = -math.min(-amount, pesos)
			if amount == 0 then
				-- nothing to steal: turn it into a near-miss
				Remotes.notify(player, "😅 Muntik ka nang madukutan, pero wala ka namang pera. Haha!", "info")
				return
			end
		end
		player:SetAttribute("Pesos", pesos + amount)
		text = string.format(text, Util.formatPesos(math.abs(amount)))
	end
	if event.effects then
		for need, delta in event.effects do
			NeedsService.add(player, need, delta)
		end
	end
	Remotes.notify(player, text, if event.good then "good" else "bad")
end

--------------------------------------------------------------------------
-- Bus loop
--------------------------------------------------------------------------
local function runBus(cfg, points: { Vector3 }, index: number)
	local forward = makePath(laneOf(points, LANE_OFFSET))
	local backward = makePath(laneOf(reversed(points), LANE_OFFSET))

	local bus = Models.build("Bus", cfg.color, "")
	bus.Name = cfg.id .. "Bus" .. index
	bus.Parent = folder
	local seats: { Seat } = {}
	for _, d in bus:GetDescendants() do
		if d:IsA("Seat") and d.Name == "BusSeat" then
			table.insert(seats, d)
		end
	end
	local routeLabel = bus:FindFirstChild("RouteLabel", true) :: TextLabel?
	local promptPart = bus:FindFirstChild("PromptPart", true) :: BasePart

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Sumakay"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = promptPart

	local atA = index % 2 == 1
	local moving = false
	local destination = cfg.b

	prompt.Triggered:Connect(function(player)
		if moving then
			Remotes.notify(player, "🚌 Umaandar na ang bus. Hintayin ang susunod na biyahe.", "warn")
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 or humanoid.SeatPart then
			return
		end
		for _, seat in seats do
			if not seat.Occupant then
				ActionService.stop(player, "cancel")
				seat:Sit(humanoid)
				local city = Config.city(destination)
				Remotes.notify(player, string.format("🚌 Sumakay ka sa bus papuntang %s %s. Pamasahe: %s (babayaran pag-alis). Space para bumaba.",
					city.icon, city.name, Util.formatPesos(cfg.fare)), "info")
				return
			end
		end
		Remotes.notify(player, "Puno na ang bus! Hintayin ang susunod.", "warn")
	end)

	while bus.Parent do
		local path = if atA then forward else backward
		destination = if atA then cfg.b else cfg.a
		local destCity = Config.city(destination)
		if routeLabel then
			routeLabel.Text = "→ " .. destCity.name:upper()
		end
		prompt.ObjectText = string.format("Bus papuntang %s (%s)", destCity.name, Util.formatPesos(cfg.fare))
		prompt.Enabled = true

		-- park at the terminal facing the way we'll leave
		local startPos, startDir = sample(path, 0)
		bus:PivotTo(flatLook(startPos, startDir))
		moving = false
		task.wait(cfg.dwellSeconds)

		-- collect fares
		moving = true
		prompt.Enabled = false
		local riders: { [Player]: boolean } = {}
		for _, seat in seats do
			local player = occupantPlayer(seat)
			if player then
				local pesos = player:GetAttribute("Pesos") or 0
				if pesos >= cfg.fare then
					player:SetAttribute("Pesos", pesos - cfg.fare)
					riders[player] = true
					Remotes.notify(player, "🎫 Nagbayad ka ng " .. Util.formatPesos(cfg.fare) .. ". Aalis na ang bus!", "info")
				else
					unseat(seat)
					Remotes.notify(player, "💸 Kulang ang pamasahe mo. Pinababa ka ng konduktor.", "bad")
				end
			end
		end

		-- drive
		local elapsed = 0
		local nextRoll = 1
		while elapsed < cfg.tripSeconds and bus.Parent do
			local dt = RunService.Heartbeat:Wait()
			elapsed += dt
			local pos, dir = sample(path, elapsed / cfg.tripSeconds * path.total)
			local current = bus:GetPivot()
			local target = flatLook(pos, dir)
			local rotation = current.Rotation:Lerp(target.Rotation, math.min(1, dt * 3))
			bus:PivotTo(CFrame.new(pos) * rotation)

			local threshold = Config.TripEventRolls[nextRoll]
			if threshold and elapsed / cfg.tripSeconds >= threshold then
				nextRoll += 1
				for _, seat in seats do
					local player = occupantPlayer(seat)
					if player and riders[player] and rng:NextNumber() < Config.TripEventChance then
						applyEvent(player, pickEvent(player))
					end
				end
			end
		end

		-- arrive
		for _, seat in seats do
			local player = occupantPlayer(seat)
			if player and riders[player] then
				Remotes.notify(player, string.format("📍 Nakarating ka na sa %s %s! Pindutin ang Space para bumaba.",
					destCity.icon, destCity.name), "good")
			end
		end
		atA = not atA
	end
end

--------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------

-- Called by WorldBuilder with the road's centre-line points (terminal A → terminal B).
function TravelService.addRoute(routeId: string, points: { Vector3 })
	routePoints[routeId] = points
end

function TravelService.init()
	folder = Instance.new("Folder")
	folder.Name = "Buses"
	folder.Parent = workspace
	for _, cfg in Config.Routes do
		local points = routePoints[cfg.id]
		if points then
			for i = 1, cfg.buses do
				task.spawn(runBus, cfg, points, i)
			end
		else
			warn("[Bahay Buhay] No road built for route " .. cfg.id)
		end
	end
end

return TravelService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	WorldBuilder — builds the shared world at server start: three cities in ONE map.

	   Baybay Alon (x≈0) ══ highway ══ Metro Dakila (x≈3000) ══ mountain road ══ San Bukid (x≈6000, up on a plateau)

	Baybay Alon close-up (top view, +X east, +Z north):

	Map (top view, +X east, +Z north):

	              [Lot1]   [Lot2]   [Lot3]                [Simbahan]
	   beach  ─────────── ring road ───────────
	   & sea  │ Karinderya   Videoke            │
	  (bangka)│        Bantayog   Basketball    │── road ── Jeepney terminal
	          │ Sari-sari    Poso               │           Palengke
	           ─────────── ring road ───────────
	              [Lot4]   [Lot5]   [Lot6]            [Barangay Hall]
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Models = require(ReplicatedStorage.Shared.Models)
local Util = require(ReplicatedStorage.Shared.Util)
local StationService = require(script.Parent.StationService)
local TravelService = require(script.Parent.TravelService)

local WorldBuilder = {}

local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local MAT = Enum.Material

local root: Folder
local world: Folder -- folder of the city currently being built
local currentCity = "BaybayAlon"

local function beginCity(cityId: string)
	currentCity = cityId
	world = Instance.new("Folder")
	world.Name = cityId
	world.Parent = root
end

local function part(props)
	props.Parent = props.Parent or world
	return Util.part(props)
end

-- Build a model, place it, and make it interactive if it's a station.
-- Every model remembers which city it's in (prices and pay depend on it).
local function place(id: string, cf: CFrame, ...): Model
	local model = Models.build(id, ...)
	model:PivotTo(cf)
	model:SetAttribute("City", currentCity)
	model.Parent = world
	if model:GetAttribute("StationId") then
		StationService.make(model)
	end
	return model
end

local function setupLighting()
	Lighting.Brightness = 2.4
	Lighting.Ambient = C(95, 85, 75)
	Lighting.OutdoorAmbient = C(150, 140, 125)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.GeographicLatitude = 13 -- roughly the latitude of Bicol / Luzon

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.2
	atmosphere.Color = C(215, 200, 180)
	atmosphere.Decay = C(120, 110, 140)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.18
	color.Contrast = 0.06
	color.TintColor = C(255, 248, 235)
	color.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 24
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.8
	rays.Parent = Lighting
end

local function buildGround()
	part({ Name = "Lupa", Size = V(460, 2, 600), CFrame = CF(80, -1, 0), Color = C(98, 160, 72), Material = MAT.Grass })
	-- beach & sea
	part({ Name = "Buhangin", Size = V(62, 1.6, 600), CFrame = CF(-131, -0.6, 0), Color = C(236, 214, 160), Material = MAT.Sand })
	local terrain = workspace.Terrain
	terrain:FillBlock(CF(-245, -10, 0), V(190, 4, 600), Enum.Material.Sand)
	terrain:FillBlock(CF(-245, -4, 0), V(190, 8, 600), Enum.Material.Water)
	terrain.WaterColor = C(40, 150, 170)
	terrain.WaterTransparency = 0.6
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8
end

local function road(cf: CFrame, size: Vector3, dashedAlongZ: boolean)
	part({ Name = "Kalsada", Size = size, CFrame = cf, Color = C(60, 60, 64), Material = MAT.Asphalt })
	local length = if dashedAlongZ then size.Z else size.X
	local count = math.floor(length / 8)
	for i = 0, count - 1 do
		local offset = -length / 2 + 4 + i * 8
		local local_ = if dashedAlongZ then CF(0, size.Y / 2 + 0.01, offset) else CF(offset, size.Y / 2 + 0.01, 0)
		part({
			Size = if dashedAlongZ then V(0.4, 0.02, 4) else V(4, 0.02, 0.4),
			CFrame = cf * local_,
			Color = C(250, 220, 80),
			Material = MAT.SmoothPlastic,
			CanCollide = false,
		})
	end
end

local function buildRoads()
	road(CF(0, 0.1, 65), V(150, 0.2, 20), false)
	road(CF(0, 0.1, -65), V(150, 0.2, 20), false)
	road(CF(65, 0.1, 0), V(20, 0.2, 110), true)
	road(CF(-65, 0.1, 0), V(20, 0.2, 110), true)
	road(CF(112.5, 0.1, 0), V(75, 0.2, 20), false)
	-- dirt paths from each lot's gate to the ring road
	for _, x in { -60, 0, 60 } do
		for _, z in { 81, -81 } do
			part({ Size = V(6, 0.1, 12), CFrame = CF(x, 0.05, z), Color = C(150, 120, 85), Material = MAT.Ground })
		end
	end
end

local function buildPlaza()
	part({ Name = "Plaza", Size = V(110, 0.3, 110), CFrame = CF(0, 0.15, 0), Color = C(205, 198, 185), Material = MAT.Pavement })
	local top = 0.3
	local centre = V(0, top, 0)

	-- Basketball court (full court, two rings)
	part({ Name = "Court", Size = V(26, 0.05, 46), CFrame = CF(24, top + 0.025, 0), Color = C(196, 92, 58), Material = MAT.SmoothPlastic })
	for _, spec in {
		{ V(26, 0.06, 0.3), CF(24, top + 0.03, 23) },
		{ V(26, 0.06, 0.3), CF(24, top + 0.03, -23) },
		{ V(0.3, 0.06, 46), CF(11, top + 0.03, 0) },
		{ V(0.3, 0.06, 46), CF(37, top + 0.03, 0) },
		{ V(26, 0.06, 0.3), CF(24, top + 0.03, 0) },
	} do
		part({ Size = spec[1], CFrame = spec[2], Color = C(250, 250, 250), Material = MAT.SmoothPlastic, CanCollide = false })
	end
	place("BasketballRing", Util.facing(V(24, top, -24), V(24, top, 0)))
	place("BasketballRing", Util.facing(V(24, top, 24), V(24, top, 0)))

	-- Stores
	place("SariSari", Util.facing(V(-38, top, -36), centre))
	place("Karinderya", Util.facing(V(-38, top, 36), centre))

	-- Videoke pavilion with monobloc chairs
	place("Pavilion", CF(-12, top, 40), 16, 12)
	place("Videoke", Util.facing(V(-12, top + 0.4, 44), V(-12, top, 0)))
	for i, x in { -17, -14, -10, -7 } do
		local chair = place("Monobloc", Util.facing(V(x, top + 0.4, 36), V(-12, top, 44)) * CFrame.Angles(0, math.pi, 0),
			if i % 2 == 0 then C(240, 70, 70) else Models.Palette.white)
		chair.Name = "Monobloc"
	end

	-- Bantayog (monument) at the heart of the plaza, with benches
	place("Bantayog", CF(-14, top, 0))
	for _, spec in { { -14, -12, 0 }, { -14, 12, math.pi }, { -27, 0, math.pi / 2 } } do
		place("Bench", CF(spec[1], top, spec[2]) * CFrame.Angles(0, spec[3], 0))
	end

	place("Poso", Util.facing(V(-20, top, -18), centre))

	-- Street lamps & banderitas
	local corners = { V(-52, top, -52), V(52, top, -52), V(52, top, 52), V(-52, top, 52) }
	local tops = {}
	for i, pos in corners do
		local lamp = place("StreetLamp", Util.facing(pos, centre))
		tops[i] = (lamp:FindFirstChild("Top") :: BasePart).Position
	end
	for _, pos in { V(0, top, -52), V(0, top, 52), V(-52, top, 0), V(52, top, 0) } do
		place("StreetLamp", Util.facing(pos, centre))
	end
	local seed = 1
	local function flags(a: Vector3, b: Vector3, sag: number)
		local m = Models.build("Banderitas", a, b, sag, seed)
		seed += 1
		m.Parent = world
	end
	flags(tops[1], tops[3], 5)
	flags(tops[2], tops[4], 5)
	for i = 1, 4 do
		flags(tops[i], tops[(i % 4) + 1], 3)
	end

	-- Coconut trees around the plaza edge
	local rng = Random.new(42)
	local keepOut = { V(-38, top, -36), V(-38, top, 36), V(-12, top, 40), V(24, top, 24), V(24, top, -24) }
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		local pos = V(math.cos(a) * 49, top, math.sin(a) * 49)
		local clear = true
		for _, spot in keepOut do
			if (pos - spot).Magnitude < 15 then
				clear = false
			end
		end
		if clear then
			place("CoconutTree", CF(pos), rng:NextInteger(1, 9999))
		end
	end
end

local function buildEastSide()
	-- Jeepney terminal
	place("Shed", Util.facing(V(115, 0.2, 16), V(115, 0.2, 0)))
	place("Jeepney", CF(112, 0.2, 5) * CFrame.Angles(0, math.pi / 2, 0), "BAYAN - PALENGKE")
	place("Jeepney", CF(138, 0.2, 5) * CFrame.Angles(0, math.pi / 2, 0), "BARANGAY - BAYBAY")

	-- Palengke (wet & dry market)
	part({ Size = V(42, 0.2, 18), CFrame = CF(115, 0.1, -30), Color = C(170, 165, 155), Material = MAT.Concrete })
	for i, x in { 102, 115, 128 } do
		place("Palengke", CF(x, 0.2, -28), i)
	end
	local signPost = part({ Size = V(16, 2.4, 0.4), CFrame = CF(115, 10.5, -19), Color = C(30, 110, 60) })
	Util.surfaceText(signPost, Enum.NormalId.Back, "PALENGKE NG BAYAN", C(255, 240, 200))
	for _, x in { 108, 122 } do
		part({ Size = V(0.4, 10, 0.4), CFrame = CF(x, 5.2, -19), Color = Models.Palette.metal, Material = MAT.Metal })
	end

	-- Simbahan facing the road
	place("Simbahan", Util.facing(V(126, 0, 52), V(126, 0, 0)))

	-- Barangay hall
	place("Building", Util.facing(V(125, 0.2, -88), V(125, 0.2, 0)), 30, 18, 12, C(235, 225, 200), "BARANGAY HALL")

	for _, pos in { V(90, 0.2, 18), V(90, 0.2, -18), V(140, 0.2, 18), V(140, 0.2, -18) } do
		place("StreetLamp", Util.facing(pos, V(pos.X, 0.2, 0)))
	end
end

local function buildBeach()
	local rng = Random.new(7)
	for i = 0, 13 do
		local z = -130 + i * 20 + rng:NextNumber(-5, 5)
		local x = rng:NextNumber(-150, -110)
		place("CoconutTree", CF(x, 0.2, z), rng:NextInteger(1, 9999))
	end
	place("Pavilion", CF(-125, 0.2, 40), 12, 10)
	place("Bangka", CF(-172, -0.4, 10) * CFrame.Angles(0, 0.3, 0))
	place("Bangka", CF(-180, -0.4, -22) * CFrame.Angles(0, -0.2, 0))
	place("Bangka", CF(-168, -0.4, -55) * CFrame.Angles(0, 0.1, 0))
end

local function buildSpawn()
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Plaza Spawn"
	spawn.Size = V(8, 0.4, 8)
	spawn.CFrame = CF(-2, 0.5, -22)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Models.Palette.flagYellow
	spawn.Material = MAT.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = world
end


--------------------------------------------------------------------------
-- Shared helpers for roads between cities
--------------------------------------------------------------------------
local function strip(a: Vector3, b: Vector3, width: number, thickness: number, color: Color3, material: Enum.Material, name: string?)
	local mid = (a + b) / 2
	local len = (b - a).Magnitude
	return part({
		Name = name,
		Size = V(width, thickness, len + 0.5),
		CFrame = CFrame.lookAt(mid, b) * CF(0, -thickness / 2, 0),
		Color = color,
		Material = material,
	})
end

local function disc(p: Vector3, diameter: number, thickness: number, color: Color3, material: Enum.Material)
	part({
		Shape = Enum.PartType.Cylinder,
		Size = V(thickness, diameter, diameter),
		CFrame = CF(p - V(0, thickness / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = material,
	})
end

-- Road surface (top at the given points), dashed centre line, and a wide strip of ground under it.
local function roadPath(points: { Vector3 }, width: number, groundWidth: number, groundColor: Color3)
	local asphalt = C(60, 60, 64)
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		strip(a - V(0, 0.2, 0), b - V(0, 0.2, 0), groundWidth, 2, groundColor, MAT.Grass)
		strip(a, b, width, 0.2, asphalt, MAT.Asphalt, "Kalsada")
		local len = (b - a).Magnitude
		local frame = CFrame.lookAt(a, b)
		for d = 6, len - 6, 14 do
			part({ Size = V(0.4, 0.02, 5), CFrame = frame * CF(0, 0.01, -d), Color = C(250, 220, 80), Material = MAT.SmoothPlastic, CanCollide = false })
		end
		if i > 1 then
			disc(a - V(0, 0.2, 0), groundWidth, 2, groundColor, MAT.Grass)
			disc(a, width, 0.2, asphalt, MAT.Asphalt)
		end
	end
end

-- Welcome arch over the road, facing +X or -X travellers.
local function arch(pos: Vector3, text: string, color: Color3)
	for _, z in { -14, 14 } do
		part({ Size = V(2.5, 14, 2.5), CFrame = CF(pos + V(0, 7, z)), Color = color, Material = MAT.Concrete })
	end
	local beam = part({ Size = V(2, 4, 31), CFrame = CF(pos + V(0, 15, 0)), Color = color, Material = MAT.Concrete })
	Util.surfaceText(beam, Enum.NormalId.Left, text, C(255, 245, 220))
	Util.surfaceText(beam, Enum.NormalId.Right, text, C(255, 245, 220))
end

local function facingRoad(pos: Vector3, roadZ: number): CFrame
	return Util.facing(pos, V(pos.X, pos.Y, roadZ))
end

--------------------------------------------------------------------------
-- Baybay Alon additions (Phase 0): jobs, terminal, pier
--------------------------------------------------------------------------
local function buildBaybayExtras()
	place("BusTerminal", facingRoad(V(195, 0.2, 20), 0), "TERMINAL · BIYAHENG METRO DAKILA")
	place("Building", Util.facing(V(112, 0.2, -62), V(112, 0.2, 0)), 18, 12, 8, C(220, 230, 240), "PESO OFFICE", "PESO")
	place("Building", facingRoad(V(95, 0.2, 32), 0), 16, 12, 7, C(245, 245, 245), "RURAL HEALTH UNIT", "RHU")
	place("Building", facingRoad(V(145, 0.2, 30), 0), 18, 12, 8, C(250, 230, 150), "PAARALANG BAYBAY ALON", "Paaralan")
	place("ConstructionSite", facingRoad(V(170, 0.2, -40), 0))
	place("Palayan", facingRoad(V(225, 0.2, -45), 0), 11)
	place("Kalabaw", CF(240, 0.2, -66) * CFrame.Angles(0, 0.8, 0))
	place("Pantalan", CF(-150, 0.2, -90) * CFrame.Angles(0, math.pi / 2, 0))
	arch(V(260, 0.2, 0), "BAYBAY ALON · MAGANDANG BIYAHE!", C(40, 110, 170))
end

--------------------------------------------------------------------------
-- Highway: Baybay Alon ⇄ Metro Dakila
--------------------------------------------------------------------------
local HIGHWAY = {
	V(190, 0.2, 0), V(900, 0.2, 0), V(1150, 0.2, 70), V(1750, 0.2, 70), V(2000, 0.2, 0), V(2790, 0.2, 0),
}
local MOUNTAIN = {
	V(3210, 0.2, 0), V(3300, 0.2, 0), V(3700, 4.2, 0), V(4100, 12.2, 90), V(4600, 24.2, 90),
	V(5000, 32.2, -60), V(5450, 40.2, -60), V(5700, 40.2, 0), V(5790, 40.2, 0),
}

local function buildHighway()
	local grass = C(98, 160, 72)
	roadPath({ V(150, 0.2, 0), table.unpack(HIGHWAY) }, 22, 180, grass)
	local rng = Random.new(5)
	for i = 1, #HIGHWAY - 1 do
		local a, b = HIGHWAY[i], HIGHWAY[i + 1]
		local len = (b - a).Magnitude
		local side = CFrame.lookAt(a, b)
		for d = 60, len - 40, 110 do
			local sx = if rng:NextNumber() < 0.5 then -1 else 1
			local pos = (side * CF(sx * rng:NextNumber(30, 70), 0, -d)).Position
			place("CoconutTree", CF(V(pos.X, a.Y, pos.Z)), rng:NextInteger(1, 9999))
		end
		for d = 100, len - 50, 220 do
			local pos = (side * CF(14, 0, -d)).Position
			place("StreetLamp", Util.facing(V(pos.X, a.Y, pos.Z), (side * CF(0, 0, -d)).Position))
		end
	end
	for i, x in { 600, 1450, 2300 } do
		place("Bundok", CF(x, 0, if i % 2 == 0 then 260 else -240), V(320, 90, 220), C(80, 140, 70))
	end
	TravelService.addRoute("Highway", HIGHWAY)
end

local function buildMountainRoad()
	roadPath(MOUNTAIN, 18, 160, C(90, 150, 70))
	local rng = Random.new(9)
	for i = 1, #MOUNTAIN - 1 do
		local a, b = MOUNTAIN[i], MOUNTAIN[i + 1]
		local len = (b - a).Magnitude
		local frame = CFrame.lookAt(a, b)
		for d = 80, len - 60, 160 do
			local sx = if rng:NextNumber() < 0.5 then -1 else 1
			local pos = (frame * CF(sx * rng:NextNumber(30, 60), 0, -d)).Position
			place("CoconutTree", CF(pos - V(0, 0.2, 0)), rng:NextInteger(1, 9999))
		end
	end
	for i, x in { 3600, 4100, 4600, 5100, 5500 } do
		local h = 120 + i * 25
		place("Bundok", CF(x, 0, 230 + i * 10), V(360, h, 260), C(60, 120, 60))
		place("Bundok", CF(x + 150, 0, -250 - i * 8), V(340, h * 0.9, 240), C(70, 130, 65))
	end
	TravelService.addRoute("Bundok", MOUNTAIN)
end

--------------------------------------------------------------------------
-- Metro Dakila
--------------------------------------------------------------------------
local function buildMetro()
	local O = Config.Cities.MetroDakila.origin
	local function at(x, y, z)
		return O + V(x, y, z)
	end
	part({ Name = "Semento", Size = V(470, 2, 600), CFrame = CF(at(0, -1, 0)), Color = C(150, 150, 145), Material = MAT.Pavement })
	road(CF(at(0, 0.1, 0)), V(470, 0.2, 24), false)
	arch(at(-232, 0, 0), "MALIGAYANG PAGDATING SA METRO DAKILA", C(170, 40, 50))

	place("BusTerminal", facingRoad(at(-205, 0.2, -20), O.Z), "TERMINAL · BIYAHENG BAYBAY ALON")
	place("BusTerminal", facingRoad(at(205, 0.2, 20), O.Z), "TERMINAL · BIYAHENG SAN BUKID")

	-- north side (face the avenue)
	place("Building", facingRoad(at(-150, 0.2, 48), O.Z), 30, 20, 16, C(245, 245, 245), "DAKILA GENERAL HOSPITAL", "Ospital")
	place("Building", facingRoad(at(-30, 0.2, 48), O.Z), 26, 22, 14, C(230, 200, 160), "DAKILA MALL")
	place("Tower", facingRoad(at(30, 0.2, 48), O.Z), 24, 20, 12, C(90, 100, 120), "BPO", "DAKILATECH SOLUTIONS")
	place("Building", facingRoad(at(120, 0.2, 48), O.Z), 36, 22, 14, C(200, 170, 130), "PAMANTASAN NG DAKILA")
	-- south side
	place("Building", facingRoad(at(-150, 0.2, -48), O.Z), 20, 14, 9, C(220, 230, 240), "PESO OFFICE", "PESO")
	place("ConstructionSite", facingRoad(at(-30, 0.2, -48), O.Z))
	place("Palengke", facingRoad(at(30, 0.2, -40), O.Z), 7)
	place("SariSari", facingRoad(at(100, 0.2, -45), O.Z))
	place("Karinderya", facingRoad(at(168, 0.2, -42), O.Z))
	place("Jeepney", CF(at(-100, 0.2, -18)) * CFrame.Angles(0, math.pi / 2, 0), "AVENIDA - PALENGKE")

	-- skyline
	local rng = Random.new(21)
	for _, spot in { { -200, 120 }, { 200, 120 }, { -200, -120 }, { 200, -120 }, { -120, 205 }, { 0, 215 }, { 120, 205 }, { -120, -205 }, { 0, -215 }, { 120, -205 } } do
		local pos = at(spot[1], 0.2, spot[2])
		place("Tower", facingRoad(pos, O.Z), rng:NextInteger(20, 30), rng:NextInteger(18, 26), rng:NextInteger(8, 22),
			Color3.fromHSV(rng:NextNumber(0.5, 0.65), rng:NextNumber(0.05, 0.25), rng:NextNumber(0.55, 0.85)))
	end
	for x = -180, 180, 60 do
		for _, z in { -14, 14 } do
			place("StreetLamp", facingRoad(at(x + (if z > 0 then 30 else 0), 0.2, z), O.Z))
		end
	end
end

--------------------------------------------------------------------------
-- San Bukid (on a plateau, y = 40)
--------------------------------------------------------------------------
local function buildBukid()
	local O = Config.Cities.SanBukid.origin
	local function at(x, y, z)
		return O + V(x, y, z)
	end
	part({ Name = "Lupa", Size = V(470, 2, 600), CFrame = CF(at(0, -1, 0)), Color = C(104, 165, 70), Material = MAT.Grass })
	road(CF(at(0, 0.1, 0)), V(470, 0.2, 16), false)
	arch(at(-232, 0, 0), "MALIGAYANG PAGDATING SA SAN BUKID", C(60, 120, 60))
	place("BusTerminal", facingRoad(at(-205, 0.2, -20), O.Z), "TERMINAL · BIYAHENG METRO DAKILA")

	-- north side
	place("Simbahan", facingRoad(at(-160, 0, 40), O.Z))
	place("Building", facingRoad(at(-40, 0.2, 45), O.Z), 16, 12, 7, C(245, 245, 245), "RURAL HEALTH UNIT", "RHU")
	place("Building", facingRoad(at(30, 0.2, 48), O.Z), 26, 16, 8, C(250, 230, 150), "PAARALANG SAN BUKID", "Paaralan")
	place("Building", facingRoad(at(120, 0.2, 45), O.Z), 16, 12, 7, C(220, 230, 240), "PESO OFFICE", "PESO")
	place("SariSari", facingRoad(at(180, 0.2, 42), O.Z))
	-- south side: rice fields and work
	for i, x in { -150, -110, 110, 150 } do
		place("Palayan", facingRoad(at(x, 0.2, -50), O.Z), 30 + i)
	end
	place("Palengke", facingRoad(at(-25, 0.2, -42), O.Z), 3)
	place("ConstructionSite", facingRoad(at(35, 0.2, -50), O.Z))
	place("Jeepney", CF(at(-80, 0.2, 12)) * CFrame.Angles(0, math.pi / 2, 0), "SAN BUKID - BAYAN")
	place("Kalabaw", CF(at(-130, 0, -76)) * CFrame.Angles(0, 0.4, 0))
	place("Kalabaw", CF(at(125, 0, -78)) * CFrame.Angles(0, -1.1, 0))

	local rng = Random.new(33)
	for _ = 1, 14 do
		local x, z = rng:NextNumber(-220, 220), rng:NextNumber(-280, 280)
		if math.abs(z) > 150 or math.abs(x) > 200 then
			place("CoconutTree", CF(at(x, 0, z)), rng:NextInteger(1, 9999))
		end
	end
	for _, spot in { { -150, 300 }, { 120, 320 }, { -60, -320 }, { 170, -300 } } do
		place("Bundok", CF(at(spot[1], 0, spot[2])), V(300, 140, 200), C(60, 125, 60))
	end
	local tops = {}
	for i, x in { -40, 40 } do
		local lamp = place("StreetLamp", facingRoad(at(x, 0.2, if i == 1 then -11 else 11), O.Z))
		tops[i] = (lamp:FindFirstChild("Top") :: BasePart).Position
	end
	local flags = Models.build("Banderitas", tops[1], tops[2], 3, 77)
	flags.Parent = world
end

function WorldBuilder.build()
	root = Instance.new("Folder")
	root.Name = "Kapuluan"
	root.Parent = workspace
	beginCity("BaybayAlon")

	-- remove the default baseplate from a fresh template, if any
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end

	setupLighting()
	buildGround()
	buildRoads()
	buildPlaza()
	buildEastSide()
	buildBeach()
	buildSpawn()
	buildBaybayExtras()

	beginCity("Highway")
	buildHighway()
	beginCity("MetroDakila")
	buildMetro()
	beginCity("Bundok")
	buildMountainRoad()
	beginCity("SanBukid")
	buildBukid()
end

return WorldBuilder
]]></ProtectedString></Properties></Item>
