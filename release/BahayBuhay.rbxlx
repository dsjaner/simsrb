		lowText = "Medyo amoy-araw ka na... Maligo ka na!",
	},
	Fun = {
		label = "Saya",
		english = "Fun",
		icon = "🎉",
		decayPerMinute = 9,
		color = C(235, 110, 180),
		lowText = "Nabo-bore ka na. Maglibang ka naman!",
	},
	Social = {
		label = "Pakikisama",
		english = "Social",
		icon = "💬",
		decayPerMinute = 7,
