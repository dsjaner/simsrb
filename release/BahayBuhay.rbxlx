</Item>
<Item class="StarterPlayer" referent="RBX34"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX33"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX32"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">BuildMode</string><ProtectedString name="Source"><![CDATA[--[[
	BuildMode — "Gawa" mode for buying and arranging furniture on your lot.

	  Click a catalog card → a ghost preview follows your mouse (green = OK, red = not allowed)
	  Left-click / tap : ilagay (place)      R : ikot (rotate 90°)
	  X (while hovering your furniture) : ibenta (sell)
	  Q : bitawan (deselect)                  B : lumabas (exit)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Models = require(ReplicatedStorage.Shared.Models)
local Util = require(ReplicatedStorage.Shared.Util)
local Theme = require(script.Parent.UI.Theme)

local create = Theme.create
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local BuildMode = {}

local notify: (string, string?) -> () = function() end
local active = false
local selectedId: string? = nil
local ghost: Model? = nil
local ghostHighlight: Highlight? = nil
local hoverHighlight: Highlight
local hovered: Model? = nil
local rotation = 0
local pending: { x: number, y: number, z: number, valid: boolean }? = nil
local busy = false

local catalog: Frame
local hint: TextLabel
local renderConn: RBXScriptConnection? = nil

local GREEN = Color3.fromRGB(80, 230, 120)
local RED = Color3.fromRGB(240, 70, 70)

local function myLot(): Model?
	local lots = workspace:FindFirstChild("Lots")
	if not lots then
		return nil
	end
	for _, lot in lots:GetChildren() do
		if lot:GetAttribute("OwnerUserId") == player.UserId then
			return lot
		end
	end
	return nil
end

local function clearGhost()
	if ghost then
		ghost:Destroy()
	end
	ghost, ghostHighlight, selectedId, pending = nil, nil, nil, nil
end

local function makeGhost(id: string)
	clearGhost()
	local model = Models.build(id)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
			if d.Transparency < 1 then
				d.Transparency = math.max(d.Transparency, 0.35)
			end
		elseif d:IsA("Light") then
			d.Enabled = false
		end
	end
	local highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.65
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	model.Parent = workspace
	ghost, ghostHighlight, selectedId = model, highlight, id
end

local function furnitureAncestor(inst: Instance?): Model?
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("FurnitureId") then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

local function mouseRay(): RaycastResult?
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	if ghost then
		table.insert(ignore, ghost)
	end
	if player.Character then
		table.insert(ignore, player.Character)
	end
	params.FilterDescendantsInstances = ignore
	return workspace:Raycast(ray.Origin, ray.Direction * 600, params)
end

local function update()
	local lot = myLot()
	local result = mouseRay()

	-- hover for selling
	local over = result and furnitureAncestor(result.Instance)
	if over and over:GetAttribute("OwnerUserId") ~= player.UserId then
		over = nil
	end
	hovered = if selectedId then nil else over
	hoverHighlight.Adornee = hovered
	hoverHighlight.Enabled = hovered ~= nil

	if not ghost or not lot or not result then
		pending = nil
		return
	end
	local originPart = lot:FindFirstChild("Origin") :: BasePart?
	if not originPart then
		pending = nil -- not streamed in yet
		return
	end
	local origin = originPart.CFrame
	local rel = origin:PointToObjectSpace(result.Position)
	local x = math.floor(rel.X * 2 + 0.5) / 2
	local z = math.floor(rel.Z * 2 + 0.5) / 2
	local y = rel.Y
	local half = Config.LotHalfSize
	local item = Config.FurnitureById[selectedId :: string]
	local inBounds = math.abs(x) <= half and math.abs(z) <= half and y >= -0.5 and y <= Config.MaxBuildHeight
	local affordable = (player:GetAttribute("Pesos") or 0) >= item.price
	local valid = inBounds and affordable
	ghost:PivotTo(origin * CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(rotation), 0))
	if ghostHighlight then
		ghostHighlight.FillColor = if valid then GREEN else RED
		ghostHighlight.OutlineColor = if valid then GREEN else RED
	end
	pending = { x = x, y = y, z = z, valid = valid }
end

local function tryPlace()
	if busy or not selectedId or not pending then
		return
	end
	if not pending.valid then
		local item = Config.FurnitureById[selectedId]
		if (player:GetAttribute("Pesos") or 0) < item.price then
			notify("💸 Kulang ang pera mo para sa " .. item.name .. ".", "warn")
		else
			notify("Sa loob lang ng lote mo pwedeng maglagay.", "warn")
		end
		return
	end
	busy = true
	local id, p, r = selectedId, pending, rotation
	task.spawn(function()
		local ok, msg = Remotes.PlaceFurniture:InvokeServer(id, p.x, p.y, p.z, r)
		notify(msg, if ok then "good" else "warn")
		busy = false
	end)
end

local function trySell()
	if busy or not hovered then
		return
	end
	busy = true
	local target = hovered
	task.spawn(function()
		local ok, msg = Remotes.SellFurniture:InvokeServer(target)
		notify(msg, if ok then "good" else "warn")
		busy = false
	end)
end

local function buildCatalog(gui: ScreenGui)
	catalog = Theme.panel({
		Name = "BuildCatalog",
		Size = UDim2.new(0, 760, 0, 168),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Visible = false,
		Parent = gui,
	})
	Theme.label({
		Text = "🔨 Gawa — Mga Gamit sa Bahay",
		Font = Theme.fontTitle,
		TextSize = 18,
		TextColor3 = Theme.yellow,
		Size = UDim2.new(1, -140, 0, 24),
		Position = UDim2.fromOffset(12, 8),
		Parent = catalog,
	})
	hint = Theme.label({
		Text = "Klik: Ilagay · R: Ikot · X: Ibenta · Q: Bitawan · B: Lumabas",
		TextSize = 13,
		TextColor3 = Theme.textDim,
		Size = UDim2.new(1, -140, 0, 16),
		Position = UDim2.fromOffset(12, 32),
		Parent = catalog,
	})
	local exit = Theme.button({
		Text = "Lumabas",
		BackgroundColor3 = Theme.red,
		Size = UDim2.fromOffset(110, 34),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Parent = catalog,
	})
	exit.Activated:Connect(function()
		BuildMode.setActive(false)
	end)

	local scroller = create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -24, 0, 108),
		Position = UDim2.fromOffset(12, 54),
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 6,
		Parent = catalog,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, item in Config.Furniture do
		local card = Theme.button({
			Text = "",
			LayoutOrder = i,
			Size = UDim2.fromOffset(112, 96),
			Parent = scroller,
		})
		Theme.label({ Text = item.icon, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 40), Parent = card })
		Theme.label({
			Text = item.name,
			Font = Theme.fontBold,
			TextSize = 13,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, -8, 0, 30),
			Position = UDim2.fromOffset(4, 40),
			Parent = card,
		})
		Theme.label({
			Text = Util.formatPesos(item.price),
			TextSize = 13,
			TextColor3 = Color3.fromRGB(140, 230, 140),
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 18),
			Position = UDim2.fromOffset(0, 72),
			Parent = card,
		})
		card.Activated:Connect(function()
			rotation = 0
			makeGhost(item.id)
			hint.Text = item.desc .. "  ·  Klik para ilagay, R para iikot"
		end)
	end
end

function BuildMode.setActive(on: boolean)
	if on == active then
		return
	end
	if on and not myLot() then
		notify("Wala kang sariling lote para mag-ayos.", "warn")
		return
	end
	active = on
	catalog.Visible = on
	if on then
		renderConn = RunService.RenderStepped:Connect(update)
		notify("🔨 Gawa mode: pumili ng gamit sa ibaba.", "info")
	else
		if renderConn then
			renderConn:Disconnect()
			renderConn = nil
		end
		clearGhost()
		hovered = nil
		hoverHighlight.Adornee = nil
		hoverHighlight.Enabled = false
	end
end

function BuildMode.toggle()
	BuildMode.setActive(not active)
end

function BuildMode.isActive(): boolean
	return active
end

function BuildMode.init(gui: ScreenGui, notifyFn: (string, string?) -> ())
	notify = notifyFn
	buildCatalog(gui)

	hoverHighlight = Instance.new("Highlight")
	hoverHighlight.Name = "SellHover"
	hoverHighlight.FillColor = RED
	hoverHighlight.FillTransparency = 0.7
	hoverHighlight.OutlineColor = RED
	hoverHighlight.Enabled = false
	hoverHighlight.Parent = workspace

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.B then
			BuildMode.toggle()
			return
		end
		if not active then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			tryPlace()
		elseif input.KeyCode == Enum.KeyCode.R then
			rotation = (rotation + 90) % 360
		elseif input.KeyCode == Enum.KeyCode.X then
			trySell()
		elseif input.KeyCode == Enum.KeyCode.Q then
			clearGhost()
		end
	end)
end

return BuildMode
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX26"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	Bahay Buhay — client entry point.
	Builds the HUD, menus and build mode, and cancels actions when the player moves.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Theme = require(script.Parent:WaitForChild("UI"):WaitForChild("Theme"))
local HUD = require(script.Parent.UI.HUD)
local Menus = require(script.Parent.UI.Menus)
local BuildMode = require(script.Parent:WaitForChild("BuildMode"))
local SpinWheel = require(script.Parent.UI:WaitForChild("SpinWheel"))

-- wait for the server to finish loading our save
if not player:GetAttribute("Loaded") then
	player:GetAttributeChangedSignal("Loaded"):Wait()
end

local gui = Instance.new("ScreenGui")
gui.Name = "BahayBuhayHUD"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function cancelAction()
	if player:GetAttribute("CurrentAction") then
		Remotes.CancelAction:FireServer()
	end
end

HUD.init(gui, cancelAction)
Menus.init(gui)
BuildMode.init(gui, HUD.notify)

Remotes.Notify.OnClientEvent:Connect(function(text, kind)
	HUD.notify(text, kind)
end)

--------------------------------------------------------------------------
-- Side buttons
--------------------------------------------------------------------------
local buttons = Theme.create("Frame", {
	Name = "Buttons",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(90, 5 * 74),
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -12, 0.5, 0),
	Parent = gui,
}, {
	Theme.create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
})

local function sideButton(order: number, icon: string, text: string, onClick: () -> ())
	local button = Theme.button({
		Text = "",
		LayoutOrder = order,
		Size = UDim2.fromOffset(90, 66),
		BackgroundColor3 = Theme.bg,
		BackgroundTransparency = Theme.panelTransparency,
		Parent = buttons,
	})
	Theme.stroke().Parent = button
	Theme.label({ Text = icon, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 38), Parent = button })
	Theme.label({
		Text = text,
		Font = Theme.fontBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 40),
		Parent = button,
	})
	button.Activated:Connect(onClick)
end

sideButton(1, "🏠", "Bahay", function()
	Remotes.GoHome:FireServer()
end)
sideButton(2, "🔨", "Gawa (B)", BuildMode.toggle)
sideButton(3, "📊", "Kasanayan", function()
	Menus.toggle("skills")
end)
sideButton(4, "❤️", "Relasyon", function()
	Menus.toggle("relationships")
end)
sideButton(5, "🪪", "Ako", function()
	Menus.toggle("identity")
end)

-- First time here? Spin the wheel of fate.
if not player:GetAttribute("IdentitySeen") then
	SpinWheel.show(gui, function()
		Remotes.IdentitySeen:FireServer()
	end)
end

--------------------------------------------------------------------------
-- Moving or jumping cancels the current action (works on keyboard, gamepad and touch)
--------------------------------------------------------------------------
local lastCancel = 0
local function requestCancel()
	if os.clock() - lastCancel > 0.5 then
		lastCancel = os.clock()
		cancelAction()
	end
end

UserInputService.JumpRequest:Connect(function()
	-- ignore the first moments of an action so a held key doesn't instantly cancel it
	if (player:GetAttribute("ActionProgress") or 0) > 0.02 then
		requestCancel()
	end
end)

RunService.RenderStepped:Connect(function()
	if not player:GetAttribute("CurrentAction") then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.MoveDirection.Magnitude > 0.1 and (player:GetAttribute("ActionProgress") or 0) > 0.02 then
		requestCancel()
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
		Menus.closeAll()
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX31"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--[[
	HUD — always-on screen elements:
	  • top-left: pesos, day & clock, mood
	  • bottom-left: the six need bars
	  • bottom-centre: current action + progress + "Itigil" (stop) button
	  • top-centre: toast notifications
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Theme = require(script.Parent.Theme)

local create = Theme.create
local player = Players.LocalPlayer

local HUD = {}

local toastHolder: Frame
local needFills: { [string]: Frame } = {}
local needValues: { [string]: TextLabel } = {}
local pesosLabel: TextLabel
local clockLabel: TextLabel
local moodLabel: TextLabel
local lifeLabel: TextLabel
local actionFrame: Frame
local actionLabel: TextLabel
local actionFill: Frame

local function buildStatusCard(gui: ScreenGui)
	local card = Theme.panel({
		Name = "Status",
		Size = UDim2.fromOffset(270, 126),
		Position = UDim2.fromOffset(12, 12),
		Parent = gui,
	})
	Theme.label({
		Text = "🏠 " .. Config.GameName,
		Font = Theme.fontTitle,
		TextSize = 20,
		TextColor3 = Theme.yellow,
		Size = UDim2.new(1, -24, 0, 24),
		Position = UDim2.fromOffset(12, 8),
		Parent = card,
	})
	pesosLabel = Theme.label({
		Text = "₱0",
		Font = Theme.fontBold,
		TextSize = 22,
		TextColor3 = Color3.fromRGB(140, 230, 140),
		Size = UDim2.new(1, -24, 0, 24),
		Position = UDim2.fromOffset(12, 34),
		Parent = card,
	})
	clockLabel = Theme.label({
		Text = "",
		TextSize = 15,
		TextColor3 = Theme.textDim,
		Size = UDim2.new(1, -24, 0, 18),
		Position = UDim2.fromOffset(12, 60),
		Parent = card,
	})
	moodLabel = Theme.label({
		Text = "★ Ayos lang",
		Font = Theme.fontBold,
		TextSize = 15,
		Size = UDim2.new(1, -24, 0, 18),
		Position = UDim2.fromOffset(12, 80),
		Parent = card,
	})
	lifeLabel = Theme.label({
		Text = "",
		TextSize = 13,
		TextColor3 = Theme.textDim,
		Size = UDim2.new(1, -24, 0, 18),
		Position = UDim2.fromOffset(12, 100),
		Parent = card,
	})
end

local function buildNeeds(gui: ScreenGui)
	local rowHeight = 30
	local panel = Theme.panel({
		Name = "Needs",
		Size = UDim2.fromOffset(270, 40 + rowHeight * #Config.NeedOrder),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Parent = gui,
	})
	Theme.label({
		Text = "Pangangailangan",
		Font = Theme.fontTitle,
		TextSize = 17,
		TextColor3 = Theme.yellow,
		Size = UDim2.new(1, -24, 0, 22),
		Position = UDim2.fromOffset(12, 8),
		Parent = panel,
	})
	for i, id in Config.NeedOrder do
		local info = Config.Needs[id]
		local y = 34 + (i - 1) * rowHeight
		Theme.label({
			Text = info.icon .. " " .. info.label,
			TextSize = 14,
			Size = UDim2.fromOffset(110, 20),
			Position = UDim2.fromOffset(12, y),
			Parent = panel,
		})
		local bar = create("Frame", {
			BackgroundColor3 = Color3.fromRGB(20, 16, 14),
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(110, 14),
			Position = UDim2.fromOffset(120, y + 3),
			Parent = panel,
		}, { Theme.corner(7) })
		local fill = create("Frame", {
			BackgroundColor3 = info.color,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Parent = bar,
		}, { Theme.corner(7) })
		needFills[id] = fill
		needValues[id] = Theme.label({
			Text = "100",
			TextSize = 13,
			TextColor3 = Theme.textDim,
			TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.fromOffset(30, 20),
			Position = UDim2.fromOffset(230, y),
			Parent = panel,
		})
	end
end

local function buildActionBar(gui: ScreenGui, onCancel: () -> ())
	actionFrame = Theme.panel({
		Name = "Action",
		Size = UDim2.fromOffset(380, 64),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -96),
		Visible = false,
		Parent = gui,
	})
	actionLabel = Theme.label({
		Text = "",
		Font = Theme.fontBold,
		TextSize = 16,
		Size = UDim2.new(1, -120, 0, 22),
		Position = UDim2.fromOffset(14, 8),
		Parent = actionFrame,
	})
	local bar = create("Frame", {
		BackgroundColor3 = Color3.fromRGB(20, 16, 14),
		BorderSizePixel = 0,
		Size = UDim2.new(1, -120, 0, 14),
		Position = UDim2.fromOffset(14, 38),
		Parent = actionFrame,
	}, { Theme.corner(7) })
	actionFill = create("Frame", {
		BackgroundColor3 = Theme.yellow,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}, { Theme.corner(7) })
	local stop = Theme.button({
		Text = "Itigil",
		BackgroundColor3 = Theme.red,
		Size = UDim2.fromOffset(88, 40),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Parent = actionFrame,
	})
	stop.Activated:Connect(onCancel)
end

local function refreshNeeds()
	for _, id in Config.NeedOrder do
		local value = player:GetAttribute("Need_" .. id) or 100
		local fill = needFills[id]
		fill.Size = UDim2.fromScale(math.clamp(value / 100, 0, 1), 1)
		fill.BackgroundColor3 = if value < 25 then Color3.fromRGB(230, 60, 60) else Config.Needs[id].color
		needValues[id].Text = tostring(math.floor(value + 0.5))
	end
	local mood = Config.getMood(Util.averageNeeds(player, Config.NeedOrder))
	moodLabel.Text = "★ " .. mood.label
	moodLabel.TextColor3 = mood.color
end

local function refreshLife()
	local prof = Config.Professions[player:GetAttribute("Profession")]
	lifeLabel.Text = string.format("🎂 %s taon  ·  🏠 %s  ·  💼 %s",
		tostring(player:GetAttribute("Age") or "?"),
		Config.city(player:GetAttribute("HomeCity")).name,
		if prof then prof.label else "Walang trabaho")
end

local function refreshAction()
	local verb = player:GetAttribute("CurrentAction")
	actionFrame.Visible = verb ~= nil
	if verb then
		actionLabel.Text = verb .. "..."
		actionFill.Size = UDim2.fromScale(player:GetAttribute("ActionProgress") or 0, 1)
	end
end

function HUD.notify(text: string, kind: string?)
	local color = Theme.toast[kind or "info"] or Theme.toast.info
	local toast = create("TextLabel", {
		Text = text,
		Font = Theme.fontBold,
		TextSize = 16,
		TextWrapped = true,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.08,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = toastHolder,
	}, { Theme.corner(10), Theme.padding(10) })
	task.delay(5, function()
		local tween = TweenService:Create(toast, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		toast:Destroy()
	end)
	-- keep at most 5 toasts
	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 5 then
		toasts[1]:Destroy()
	end
end

function HUD.init(gui: ScreenGui, onCancel: () -> ())
	buildStatusCard(gui)
	buildNeeds(gui)
	buildActionBar(gui, onCancel)

	toastHolder = create("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(420, 400),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Parent = gui,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	player.AttributeChanged:Connect(function(name)
		if name:sub(1, 5) == "Need_" then
			refreshNeeds()
		elseif name == "Pesos" then
			pesosLabel.Text = Util.formatPesos(player:GetAttribute("Pesos"))
		elseif name == "CurrentAction" or name == "ActionProgress" then
			refreshAction()
		elseif name == "Age" or name == "HomeCity" or name == "Profession" then
			refreshLife()
		end
	end)
	refreshLife()
	refreshNeeds()
	refreshAction()
	pesosLabel.Text = Util.formatPesos(player:GetAttribute("Pesos"))

	task.spawn(function()
		while gui.Parent do
			local t = Lighting.ClockTime
			local day = ReplicatedStorage:GetAttribute("Day") or 1
			clockLabel.Text = string.format("Araw %d · %s · %s", day, Util.formatClock(t), Util.timeOfDay(t))
			task.wait(0.5)
		end
	end)
end

return HUD
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">Menus</string><ProtectedString name="Source"><![CDATA[--[[
	Menus — the station choice menu ("Ano ang gagawin mo?") and the
	Kasanayan (skills) and Relasyon (relationships) panels.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Theme = require(script.Parent.Theme)

local create = Theme.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Menus = {}

local gui: ScreenGui
local stationPanel: Frame?
local sidePanel: Frame?
local sidePanelKind: string?

local function effectSummary(def): string
	local parts = {}
	for _, id in Config.NeedOrder do
		local amount = def.effects[id]
		if amount and amount ~= 0 then
			table.insert(parts, string.format("%s%d %s", if amount > 0 then "+" else "", amount, Config.Needs[id].label))
		end
	end
	return table.concat(parts, "  ")
end

local function closeStation()
	if stationPanel then
		stationPanel:Destroy()
		stationPanel = nil
	end
end

function Menus.openStation(model: Model, stationId: string)
	closeStation()
	local cfg = Config.Stations[stationId]
	if not cfg then
		return
	end
	local rowHeight = 58
	local panel = Theme.panel({
		Name = "StationMenu",
		Size = UDim2.fromOffset(400, 64 + rowHeight * #cfg.actions + 50),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Parent = gui,
	})
	stationPanel = panel
	Theme.label({
		Text = model:GetAttribute("DisplayName") or cfg.title,
		Font = Theme.fontTitle,
		TextSize = 22,
		TextColor3 = Theme.yellow,
		Size = UDim2.new(1, -24, 0, 28),
		Position = UDim2.fromOffset(12, 10),
		Parent = panel,
	})
	Theme.label({
		Text = "Ano ang gagawin mo?",
		TextSize = 14,
		TextColor3 = Theme.textDim,
		Size = UDim2.new(1, -24, 0, 18),
		Position = UDim2.fromOffset(12, 38),
		Parent = panel,
	})

	local pesos = player:GetAttribute("Pesos") or 0
	local cityId = model:GetAttribute("City")
	for i, actionId in cfg.actions do
		local def = Config.Actions[actionId]
		local cost = Config.scaledCost(def, cityId)
		local price = ""
		if cost > 0 then
			price = "  ·  " .. Util.formatPesos(cost)
		elseif def.pay then
			price = "  ·  Sweldo ~" .. Util.formatPesos(def.pay * Config.city(cityId).payMult)
		end
		if def.profession and player:GetAttribute("Profession") ~= def.profession then
			price ..= "  ·  🔒 " .. Config.Professions[def.profession].label
		end
		local hours = if def.hours
			then string.format("  ·  %s–%s", Util.formatHour(def.hours[1]), Util.formatHour(def.hours[2]))
			else ""
		local affordable = cost <= pesos
		local button = Theme.button({
			Text = "",
			Size = UDim2.new(1, -24, 0, rowHeight - 8),
			Position = UDim2.fromOffset(12, 64 + (i - 1) * rowHeight),
			BackgroundColor3 = if affordable then Theme.bgLight else Color3.fromRGB(70, 40, 40),
			Parent = panel,
		})
		Theme.label({
			Text = def.bubble .. "  " .. def.label .. price .. hours,
			Font = Theme.fontBold,
			TextSize = 15,
			Size = UDim2.new(1, -20, 0, 22),
			Position = UDim2.fromOffset(10, 4),
			Parent = button,
		})
		Theme.label({
			Text = effectSummary(def),
			TextSize = 12,
			TextColor3 = Theme.textDim,
			Size = UDim2.new(1, -20, 0, 18),
			Position = UDim2.fromOffset(10, 26),
			Parent = button,
		})
		button.Activated:Connect(function()
			Remotes.RequestAction:FireServer(model, actionId)
			closeStation()
		end)
	end

	local close = Theme.button({
		Text = "Isara",
		Size = UDim2.fromOffset(120, 36),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Parent = panel,
	})
	close.Activated:Connect(closeStation)

	-- close automatically if the player walks away
	task.spawn(function()
		while stationPanel == panel do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not root or not model.Parent or (root.Position - model:GetPivot().Position).Magnitude > 22 then
				closeStation()
				break
			end
			task.wait(0.3)
		end
	end)
end

--------------------------------------------------------------------------
-- Side panels
--------------------------------------------------------------------------
local function closeSide()
	if sidePanel then
		sidePanel:Destroy()
		sidePanel = nil
		sidePanelKind = nil
	end
end

local function sideFrame(title: string, rows: number): (Frame, Frame)
	local panel = Theme.panel({
		Name = "SidePanel",
		Size = UDim2.fromOffset(320, 60 + rows * 48),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -110, 0.5, 0),
		Parent = gui,
	})
	Theme.label({
		Text = title,
		Font = Theme.fontTitle,
		TextSize = 20,
		TextColor3 = Theme.yellow,
		Size = UDim2.new(1, -24, 0, 26),
		Position = UDim2.fromOffset(12, 10),
		Parent = panel,
	})
	local list = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -24, 1, -50),
		Position = UDim2.fromOffset(12, 44),
		Parent = panel,
	}, { create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	return panel, list
end

local function meterRow(list: Frame, order: number, left: string, right: string, fraction: number, color: Color3)
	local row = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), LayoutOrder = order, Parent = list })
	Theme.label({ Text = left, Font = Theme.fontBold, TextSize = 15, Size = UDim2.new(0.65, 0, 0, 20), Parent = row })
	Theme.label({
		Text = right,
		TextSize = 13,
		TextColor3 = Theme.textDim,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(0.35, 0, 0, 20),
		Position = UDim2.fromScale(0.65, 0),
		Parent = row,
	})
	local bar = create("Frame", {
		BackgroundColor3 = Color3.fromRGB(20, 16, 14),
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 10),
		Position = UDim2.fromOffset(0, 26),
		Parent = row,
	}, { Theme.corner(5) })
	create("Frame", {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1),
		Parent = bar,
	}, { Theme.corner(5) })
end

local function renderSkills()
	local panel, list = sideFrame("📊 Kasanayan", #Config.SkillOrder)
	for i, id in Config.SkillOrder do
		local info = Config.Skills[id]
		local xp = player:GetAttribute("Skill_" .. id) or 0
		local level = Config.skillLevel(xp)
		local progress = if level >= Config.MaxSkillLevel then 1 else (xp % Config.XpPerLevel) / Config.XpPerLevel
		meterRow(list, i, info.icon .. " " .. info.label, "Level " .. level, progress, Theme.yellow)
	end
	return panel
end

local function renderRelationships()
	local panel, list = sideFrame("❤️ Relasyon", #Config.NPCs)
	for i, npc in Config.NPCs do
		local value = player:GetAttribute("Rel_" .. npc.id) or 0
		meterRow(list, i, npc.name, Config.relationshipLabel(value), value / 100, Color3.fromRGB(240, 100, 140))
	end
	return panel
end

-- "Ako" — your own private identity. Nobody else can see this (only your age is public).
local function renderIdentity()
	local rows = {
		{ "📍 Bayang sinilangan", Config.city(player:GetAttribute("Hometown")).name },
		{ "🏠 Tirahan", Config.city(player:GetAttribute("HomeCity")).name },
		{ "🎂 Edad", tostring(player:GetAttribute("Age") or "?") .. " taong gulang" },
	}
	for _, metric in Config.MetricOrder do
		local m = Config.Metrics[metric]
		table.insert(rows, { m.icon .. " " .. m.label, Config.tierLabel(metric, player:GetAttribute(metric)) })
	end
	local talent = Config.Skills[player:GetAttribute("Talent")]
	table.insert(rows, { "✨ Likas na galing", if talent then talent.icon .. " " .. talent.label else "?" })
	local papa = Config.Professions[player:GetAttribute("Papa")]
	local mama = Config.Professions[player:GetAttribute("Mama")]
	table.insert(rows, { "👨 Papa", if papa then papa.label else "?" })
	table.insert(rows, { "👩 Mama", if mama then mama.label else "?" })
	local edu = Config.Education[player:GetAttribute("Education") or "none"]
	table.insert(rows, { "🎓 Edukasyon", if edu then edu.label else "?" })
	local prof = Config.Professions[player:GetAttribute("Profession")]
	table.insert(rows, { "💼 Trabaho", if prof then prof.icon .. " " .. prof.label else "Wala pa" })

	local panel = Theme.panel({
		Name = "SidePanel",
		Size = UDim2.fromOffset(340, 60 + #rows * 28 + 30),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -110, 0.5, 0),
		Parent = gui,
	})
	Theme.label({
		Text = "🪪 Ako",
		Font = Theme.fontTitle,
		TextSize = 20,
		TextColor3 = Theme.yellow,
		Size = UDim2.new(1, -24, 0, 26),
		Position = UDim2.fromOffset(12, 10),
		Parent = panel,
	})
	for i, row in rows do
		local y = 44 + (i - 1) * 28
		Theme.label({ Text = row[1], TextSize = 14, TextColor3 = Theme.textDim, Size = UDim2.new(0.5, -12, 0, 24), Position = UDim2.fromOffset(12, y), Parent = panel })
		Theme.label({ Text = row[2], Font = Theme.fontBold, TextSize = 14, Size = UDim2.new(0.5, -12, 0, 24), Position = UDim2.new(0.5, 0, 0, y), Parent = panel })
	end
	Theme.label({
		Text = "🔒 Ikaw lang ang nakakakita nito. Edad lang ang nakikita ng iba.",
		TextSize = 12,
		TextColor3 = Theme.textDim,
		TextWrapped = true,
		Size = UDim2.new(1, -24, 0, 26),
		Position = UDim2.new(0, 12, 1, -32),
		Parent = panel,
	})
	return panel
end

function Menus.toggle(kind: string)
	if sidePanelKind == kind then
		closeSide()
		return
	end
	closeSide()
	sidePanelKind = kind
	sidePanel = if kind == "skills"
		then renderSkills()
		elseif kind == "identity" then renderIdentity()
		else renderRelationships()
end

--------------------------------------------------------------------------
-- PESO job board
--------------------------------------------------------------------------
function Menus.openCareer()
	closeStation()
	local rowHeight = 50
	local panel = Theme.panel({
		Name = "CareerMenu",
		Size = UDim2.fromOffset(560, 70 + rowHeight * #Config.ProfessionOrder + 54),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Parent = gui,
	})
	local uiScale = create("UIScale", {})
	uiScale.Parent = panel
	local view = workspace.CurrentCamera.ViewportSize
	uiScale.Scale = math.clamp(math.min((view.X - 24) / 560, (view.Y - 24) / panel.Size.Y.Offset), 0.45, 1)
	stationPanel = panel

	Theme.label({
		Text = "💼 PESO — Public Employment Service Office",
		Font = Theme.fontTitle,
		TextSize = 20,
		TextColor3 = Theme.yellow,
		Size = UDim2.new(1, -24, 0, 28),
		Position = UDim2.fromOffset(12, 10),
		Parent = panel,
	})
	local edu = Config.Education[player:GetAttribute("Education") or "none"]
	Theme.label({
		Text = "Edukasyon mo: " .. (if edu then edu.label else "?") .. "  ·  Pumili ng trabaho. Sa mga nakalistang bayan lang ito pwedeng gawin.",
		TextSize = 13,
		TextColor3 = Theme.textDim,
		TextWrapped = true,
		Size = UDim2.new(1, -24, 0, 30),
		Position = UDim2.fromOffset(12, 38),
		Parent = panel,
	})
	local current = player:GetAttribute("Profession")
	for i, id in Config.ProfessionOrder do
		local prof = Config.Professions[id]
		local job = Config.Actions[prof.job]
		local unlocked = Config.meetsEducation(player:GetAttribute("Education"), prof.education)
		local icons = {}
		for _, cityId in prof.cities do
			table.insert(icons, Config.city(cityId).icon)
		end
		local button = Theme.button({
			Text = "",
			Size = UDim2.new(1, -24, 0, rowHeight - 6),
			Position = UDim2.fromOffset(12, 70 + (i - 1) * rowHeight),
			BackgroundColor3 = if id == current then Color3.fromRGB(40, 110, 60)
				elseif unlocked then Theme.bgLight
				else Color3.fromRGB(60, 45, 45),
			Parent = panel,
		})
		Theme.label({
			Text = prof.icon .. "  " .. prof.label .. (if id == current then "  ✓" else ""),
			Font = Theme.fontBold,
			TextSize = 15,
			Size = UDim2.new(0.55, 0, 0, 20),
			Position = UDim2.fromOffset(10, 4),
			Parent = button,
		})
		local hours = if job and job.hours
			then string.format("%s–%s", Util.formatHour(job.hours[1]), Util.formatHour(job.hours[2]))
			else "Kahit anong oras"
		Theme.label({
			Text = string.format("~%s/shift  ·  %s  ·  %s", Util.formatPesos(job and job.pay or 0), hours, table.concat(icons, " ")),
			TextSize = 12,
			TextColor3 = Theme.textDim,
			Size = UDim2.new(1, -20, 0, 18),
			Position = UDim2.fromOffset(10, 24),
			Parent = button,
		})
		local need = Config.Education[prof.education]
		Theme.label({
			Text = if unlocked then "Bukas" else "🔒 " .. (if need then need.label else prof.education),
			TextSize = 12,
			TextColor3 = if unlocked then Color3.fromRGB(140, 230, 140) else Color3.fromRGB(240, 150, 140),
			TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.new(0.45, -10, 0, 20),
			Position = UDim2.new(0.55, 0, 0, 4),
			Parent = button,
		})
		button.Activated:Connect(function()
			if unlocked then
				Remotes.ChooseProfession:FireServer(id)
				closeStation()
			end
		end)
	end
	local close = Theme.button({
		Text = "Isara",
		Size = UDim2.fromOffset(120, 36),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Parent = panel,
	})
	close.Activated:Connect(closeStation)
end

function Menus.init(screenGui: ScreenGui)
	gui = screenGui
	Remotes.OpenCareer.OnClientEvent:Connect(Menus.openCareer)
	Remotes.OpenMenu.OnClientEvent:Connect(function(model, stationId)
		if typeof(model) == "Instance" and model:IsA("Model") then
			Menus.openStation(model, stationId)
		end
	end)
	-- keep an open side panel live
	player.AttributeChanged:Connect(function(name)
		local identityField = name == "Profession" or name == "Age" or name == "HomeCity" or name == "Education"
		if sidePanelKind and (name:sub(1, 6) == "Skill_" or name:sub(1, 4) == "Rel_" or identityField) then
			local kind = sidePanelKind
			closeSide()
			Menus.toggle(kind)
		end
	end)
end

function Menus.closeAll()
	closeStation()
	closeSide()
end

return Menus
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">SpinWheel</string><ProtectedString name="Source"><![CDATA[--[[
	SpinWheel — "Ikot ng Kapalaran", the first thing a new player sees.
	The server has already rolled the result (so it can't be re-rolled by rejoining);
	this screen lets the player press "Iikot!" and watch four reels land on their life:
	  Bayan (hometown) · Yaman (wealth) · Swerte (luck) · DNA (talent)
	The odds are shown under each reel.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Theme = require(script.Parent.Theme)

local create = Theme.create
local player = Players.LocalPlayer

local SpinWheel = {}

local function percent(weight: number, total: number): string
	return string.format("%d%%", math.floor(weight / total * 100 + 0.5))
end

-- Build the reel definitions: { title, options = {label...}, odds = {text...}, result = index }
local function reels()
	local list = {}
	local cityLabels, cityOdds, cityTotal = {}, {}, 0
	for _, id in Config.CityOrder do
		cityTotal += Config.Cities[id].weight
	end
	local resultCity = 1
	for i, id in Config.CityOrder do
		local c = Config.Cities[id]
		cityLabels[i] = c.icon .. " " .. c.name
		cityOdds[i] = c.name .. " " .. percent(c.weight, cityTotal)
		if id == player:GetAttribute("Hometown") then
			resultCity = i
		end
	end
	table.insert(list, { title = "📍 Bayan", options = cityLabels, odds = cityOdds, result = resultCity })
	for _, metric in Config.MetricOrder do
		local m = Config.Metrics[metric]
		local labels, odds, total = {}, {}, 0
		for _, t in m.tiers do
			total += t.weight
		end
		for i, t in m.tiers do
			labels[i] = t.label
			odds[i] = t.label .. " " .. percent(t.weight, total)
		end
		table.insert(list, {
			title = m.icon .. " " .. m.label,
			options = labels,
			odds = odds,
			result = player:GetAttribute(metric) or 2,
		})
	end
	return list
end

function SpinWheel.show(gui: ScreenGui, onDone: () -> ())
	local overlay = create("Frame", {
		Name = "SpinWheel",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.25,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = gui,
	})
	local panel = Theme.panel({
		Size = UDim2.new(0, 720, 0, 430),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 51,
		Parent = overlay,
	})
	create("UISizeConstraint", { MaxSize = Vector2.new(720, 430) }).Parent = panel
	local uiScale = create("UIScale", { Name = "Scale" })
	uiScale.Parent = panel

	local function text(props)
		props.ZIndex = 52
		props.Parent = props.Parent or panel
		return Theme.label(props)
	end

	text({
		Text = "🎡 Ikot ng Kapalaran",
		Font = Theme.fontTitle,
		TextSize = 30,
		TextColor3 = Theme.yellow,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 36),
		Position = UDim2.fromOffset(0, 14),
	})
	text({
		Text = "Hindi mo pinipili kung saan ka isisilang. Ang mahalaga ay kung ano ang gagawin mo.",
		TextSize = 15,
		TextColor3 = Theme.textDim,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -40, 0, 36),
		Position = UDim2.fromOffset(20, 52),
	})

	local defs = reels()
	local reelLabels = {}
	local reelWidth = 160
	local startX = (720 - (#defs * reelWidth + (#defs - 1) * 12)) / 2
	for i, def in defs do
		local x = startX + (i - 1) * (reelWidth + 12)
		local frame = create("Frame", {
			BackgroundColor3 = Theme.bgLight,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(reelWidth, 190),
			Position = UDim2.fromOffset(x, 100),
			ZIndex = 52,
			Parent = panel,
		}, { Theme.corner(12) })
		text({
			Text = def.title,
			Font = Theme.fontBold,
			TextSize = 17,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 26),
			Position = UDim2.fromOffset(0, 8),
			Parent = frame,
		})
		local window = create("Frame", {
			BackgroundColor3 = Color3.fromRGB(20, 16, 14),
			BorderSizePixel = 0,
			Size = UDim2.new(1, -16, 0, 56),
			Position = UDim2.fromOffset(8, 40),
			ZIndex = 52,
			Parent = frame,
		}, { Theme.corner(10), Theme.stroke(Theme.yellow, 2) })
		reelLabels[i] = text({
			Text = "?",
			Font = Theme.fontTitle,
			TextSize = 20,
			TextWrapped = true,
			TextColor3 = Theme.text,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			Parent = window,
		})
		text({
			Text = table.concat(def.odds, "\n"),
			TextSize = 13,
			TextColor3 = Theme.textDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.new(1, -8, 0, 80),
			Position = UDim2.fromOffset(4, 104),
			Parent = frame,
		})
	end

	local summary = text({
		Text = "",
		Font = Theme.fontBold,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -40, 0, 44),
		Position = UDim2.fromOffset(20, 300),
	})

	local button = Theme.button({
		Text = "Iikot!",
		TextSize = 22,
		Font = Theme.fontTitle,
		BackgroundColor3 = Theme.red,
		Size = UDim2.fromOffset(220, 52),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		ZIndex = 52,
		Parent = panel,
	})

	-- fit small (phone) screens
	local function rescale()
		local view = workspace.CurrentCamera.ViewportSize
		local scale = math.min(1, (view.X - 24) / 720, (view.Y - 24) / 430)
		uiScale.Scale = math.max(scale, 0.45)
	end
	rescale()
	local resizeConn = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	local state = "ready"
	button.Activated:Connect(function()
		if state == "ready" then
			state = "spinning"
			button.Text = "..."
			for i, def in defs do
				task.spawn(function()
					local spins = 14 + i * 7
					for n = 1, spins do
						reelLabels[i].Text = def.options[(n % #def.options) + 1]
						task.wait(0.05 + n / spins * 0.08)
					end
					reelLabels[i].Text = def.options[def.result]
					reelLabels[i].TextColor3 = Theme.yellow
					local pop = TweenService:Create(reelLabels[i], TweenInfo.new(0.25, Enum.EasingStyle.Back), { TextSize = 24 })
					pop:Play()
				end)
			end
			task.wait(4.6) -- the slowest reel takes ~3.8s
			local city = Config.city(player:GetAttribute("Hometown"))
			local papa = Config.Professions[player:GetAttribute("Papa")]
			local mama = Config.Professions[player:GetAttribute("Mama")]
			local talent = Config.Skills[player:GetAttribute("Talent")]
			summary.Text = string.format(
				"Isinilang ka sa %s. Si Papa ay %s at si Mama ay %s. Likas kang magaling sa %s.",
				city.name,
				papa and papa.label:lower() or "?",
				mama and mama.label:lower() or "?",
				talent and talent.label:lower() or "?"
			)
			button.Text = "Simulan ang Buhay!"
			button.BackgroundColor3 = Theme.green
			state = "done"
		elseif state == "done" then
			state = "closed"
			resizeConn:Disconnect()
			overlay:Destroy()
			onDone()
		end
	end)
end

return SpinWheel
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--[[
	Theme — colours, fonts and a tiny `create` helper for building UI in code.
	Palette borrows from the Philippine flag (blue, red, sun-yellow) over warm wood tones.
]]

local C = Color3.fromRGB

local Theme = {
	bg = C(38, 30, 26),
	bgLight = C(62, 50, 42),
	panelTransparency = 0.12,
	text = C(250, 245, 235),
	textDim = C(200, 188, 170),
	yellow = C(252, 209, 22),
	red = C(206, 17, 38),
	blue = C(0, 56, 168),
	green = C(70, 190, 110),
	font = Enum.Font.GothamMedium,
	fontBold = Enum.Font.GothamBold,
	fontTitle = Enum.Font.FredokaOne,
	toast = {
		info = C(0, 56, 168),
		good = C(40, 150, 80),
		warn = C(210, 140, 20),
		bad = C(190, 30, 45),
	},
}

function Theme.create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	if props then
		for key, value in props do
			if key ~= "Parent" then
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function Theme.corner(radius: number?): UICorner
	return Theme.create("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Theme.stroke(color: Color3?, thickness: number?): UIStroke
	return Theme.create("UIStroke", {
		Color = color or Theme.yellow,
		Thickness = thickness or 1.5,
		Transparency = 0.35,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return Theme.create("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

-- Standard dark rounded panel.
function Theme.panel(props: { [string]: any }): Frame
	props.BackgroundColor3 = props.BackgroundColor3 or Theme.bg
	props.BackgroundTransparency = props.BackgroundTransparency or Theme.panelTransparency
	props.BorderSizePixel = 0
	local frame = Theme.create("Frame", props)
	Theme.corner(12).Parent = frame
	Theme.stroke().Parent = frame
	return frame
end

function Theme.label(props: { [string]: any }): TextLabel
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextColor3 = props.TextColor3 or Theme.text
	props.Font = props.Font or Theme.font
	props.TextSize = props.TextSize or 16
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return Theme.create("TextLabel", props)
end

function Theme.button(props: { [string]: any }): TextButton
	props.BackgroundColor3 = props.BackgroundColor3 or Theme.bgLight
	props.TextColor3 = props.TextColor3 or Theme.text
	props.Font = props.Font or Theme.fontBold
	props.TextSize = props.TextSize or 16
	props.AutoButtonColor = true
	props.BorderSizePixel = 0
	local button = Theme.create("TextButton", props)
	Theme.corner(10).Parent = button
	return button
end

return Theme
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
</Item>
</roblox>
